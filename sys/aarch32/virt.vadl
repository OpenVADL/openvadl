
import aarch32::AArch32v7

instruction set architecture A32 extending AArch32v7 = { }

[ htif ]
processor Virt implements A32 = {

  reset = {
    PC := 0x0     // upstream QEMU sets everything to zero
    APSR_N := 1   // upstream QEMU sets negative
    APSR_Z := 1   // upstream QEMU sets zero
    APSR_C := 0   // upstream QEMU clears carry
    APSR_V := 1   // upstream QEMU sets overflow
  }

  [ firmware ]
  [ base : 0x0 ]
  [ size : 0x08000000 ]
  memory region [ROM] FLASH in MEM = {
    MEM<4>(0x0) := 0xe3a0f101  // mov  pc, #0x40000000
  }

  [ base : 0x40000000 ]
  memory region [RAM] MAIN_RAM in MEM

}