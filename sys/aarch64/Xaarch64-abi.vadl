import Xaarch64::{AArch64Base}

instruction set architecture AArch64Temp extending AArch64Base = {

  pseudo instruction TEMP_CALL =
  {
  }
  assembly TEMP_CALL = (mnemonic, " ", hex( 1337 as Bits<32> ))

  pseudo instruction TEMP_RET =
  {
    RET { rn = 30 }
  }
  assembly TEMP_RET = "ret"

  pseudo instruction PLDR( rd: Index, symbol: SInt<64> ) =
  {
    ADRP { rd = rd, offset = symbol }
    ADDXI { rd = rd, rn = rd, imm12X = lo12(symbol) }
  }
  assembly PLDR = ("LDR", " ", register(rd), " ", hex(symbol))
}

application binary interface ABI for AArch64Temp = {
   long width = 64
   long align = 64
   size_t type = unsigned long
   int max type = signed long
   pointer width = 64
   pointer align = 64


   alias register A_SP = SP
   alias register A_LR = LR
   alias register A_FP = X(29)

   alias register S0 = S(0)
   alias register S1 = S(1)
   alias register S2 = S(2)
   alias register S3 = S(3)
   alias register S4 = S(4)
   alias register S5 = S(5)
   alias register S6 = S(6)
   alias register S7 = S(7)
   alias register S8 = S(8)
   alias register S9 = S(9)
   alias register S10 = S(10)
   alias register S11 = S(11)
   alias register S12 = S(12)
   alias register S13 = S(13)
   alias register S14 = S(14)
   alias register S15 = S(15)
   alias register S16 = S(16)
   alias register S17 = S(17)
   alias register S18 = S(18)
   alias register S19 = S(19)
   alias register S20 = S(20)
   alias register S21 = S(21)
   alias register S22 = S(22)
   alias register S23 = S(23)
   alias register S24 = S(24)
   alias register S25 = S(25)
   alias register S26 = S(26)
   alias register S27 = S(27)
   alias register S28 = S(28)
   alias register S29 = S(29)
   alias register S30 = S(30)
   alias register S31 = S(31)

   alias register X0 = X(0)
   alias register X1 = X(1)
   alias register X2 = X(2)
   alias register X3 = X(3)
   alias register X4 = X(4)
   alias register X5 = X(5)
   alias register X6 = X(6)
   alias register X7 = X(7)
   alias register X8 = X(8)
   alias register X9 = X(9)
   alias register X10 = X(10)
   alias register X11 = X(11)
   alias register X12 = X(12)
   alias register X13 = X(13)
   alias register X14 = X(14)
   alias register X15 = X(15)
   alias register X16 = X(16)
   alias register X17 = X(17)
   alias register X18 = X(18)
   alias register X19 = X(19)
   alias register X20 = X(20)
   alias register X21 = X(21)
   alias register X22 = X(22)
   alias register X23 = X(23)
   alias register X24 = X(24)
   alias register X25 = X(25)
   alias register X26 = X(26)
   alias register X27 = X(27)
   alias register X28 = X(28)
   // alias register X29 = X(29)
   // alias register X30 = X(30)
   // alias register X31 = X(31)

   // [ alignment : HalfWord ]
   stack pointer = A_SP
   return address = A_LR
   frame pointer = A_FP

   special return instruction = TEMP_RET // the normal RET is an indirect jump
   special call instruction = BL
   special local address load instruction = PLDR
   special absolute address load instruction = PLDR

   function argument = X{0..7}
   return value = X{0..1} // 64 bits

   // It's important that these are "S" registers because they are used for the order
   // in the register class.
   caller saved = [ S{9..15} ]
   callee saved = [ A_LR, A_FP, S{19..28} ]

   constant sequence(rd: Bits<5>, val: UInt<32>) =
   {
     MOVZXPos00 { rd = rd, imm16 = (val & 0xFFFF) as Bits<16> }
     MOVKXPos16 { rd = rd, imm16 = ((val >> 16) & 0xFFFF) as Bits<16> }
   }

   [ only negative ] // val becomes automatically positive
   constant sequence(rd: Bits<5>, val: SInt<32>) =
   {
      MOVZXPos00 { rd = rd, imm16 = (val & 0xFFFF) as Bits<16> }
      MOVKXPos16 { rd = rd, imm16 = ((val >> 16) & 0xFFFF) as Bits<16> }
      SUBX { rd = rd, rn = 31, rm = rd }
   }
}

[ comment string: "//" ]
assembly description ASM for ABI = {

}
