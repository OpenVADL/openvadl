import aarch64::AArch64Base

instruction set architecture AArch64SVEandSME extending AArch64Base = {

  constant VL           =  64             // vector length, number of bits in a vector register
  constant PL           = VL >> 3         // predicate length, number of elements in a predicate register
  constant NumBytesPL   = PL >> 3         // number of bytes in a predicate register
  constant NumElementsB = VL >> 3         // number of byte   sized elements in a vector register
  constant NumElementsH = VL >> 4         // number of half   sized elements in a vector register
  constant NumElementsS = VL >> 5         // number of single sized elements in a vector register
  constant NumElementsW = VL >> 5         // number of single sized elements in a vector register
  constant NumElementsD = VL >> 6         // number of double sized elements in a vector register

  constant PTrueB = 0xffff'ffff'ffff'ffff as BitsP // predicate true and false values for different vector sizes
  constant PTrueH = 0x5555'5555'5555'5555 as BitsP // 
  constant PTrueS = 0x1111'1111'1111'1111 as BitsP // 
  constant PTrueD = 0x0101'0101'0101'0101 as BitsP // 
  constant PFalse = 0                     as BitsP // 

  constant LastActiveB = NumElementsB - 1 // predicate bit position of the last element 
  constant LastActiveH = NumElementsB - 2 // predicate bit position of the last element 
  constant LastActiveS = NumElementsB - 4 // predicate bit position of the last element 
  constant LastActiveD = NumElementsB - 8 // predicate bit position of the last element 

  constant Log2ElemB =   8                // number of bits required for the biggest element index
  constant NumZ = 32                      // number of vector registers in register file

  using IndexP = Bits4                    // index type for the 16 predicate register file
  using IndexE = Bits<Log2ElemB>          // the biggest index type for element indices
  using BitsZ  = Bits<VL>                 // Bits type for vector register file
  using BitsP  = Bits<PL>                 // Boolean type for predicate register file ; Bits<PL><1> is not supported by ISS
  using BitsZB = Bits<NumElementsB>< 8>   // byte   vector register file
  using BitsZH = Bits<NumElementsH><16>   // half   vector register file
  using BitsZS = Bits<NumElementsS><32>   // single vector register file
  using BitsZD = Bits<NumElementsD><64>   // double vector register file
  using BitsB  = Byte                     // 8 bit Byte
  using BitsH  = Half                     // 16 bit half word type
  using BitsS  = BitsW                    // 32 bit word type
  using BitsD  = BitsX                    // 64 bit double word type

  register   P : IndexP -> BitsP          // predicate register file
  register FFR :           BitsP          // first fault register, predicate register
                                          // which is set for first memory access operation
  register   Z : Index  -> BitsZ          //        vector register file
  alias register ZB : BitsZB<NumZ> = Z    // byte   vector register file
  alias register ZH : BitsZH<NumZ> = Z    // half   vector register file
  alias register ZS : BitsZS<NumZ> = Z    // single vector register file
  alias register ZD : BitsZD<NumZ> = Z    // double vector register file

  enumeration ElSize =                    // element size encoding
    { SizeB = 0                           // byte   size
    , SizeH = 1                           // half   size
    , SizeS = 2                           // single size
    , SizeW = 2                           // word   size equals single size
    , SizeD = 3                           // double size
    }

  enumeration ElBytes =                   // element size encoding
    { SizeB = 1                           // byte   needs 1 byte
    , SizeH = 2                           // half   needs 2 bytes
    , SizeS = 4                           // single needs 4 bytes
    , SizeW = 4                           // word   needs 4 bytes
    , SizeD = 8                           // double needs 8 bytes
    }

  // higher order model enriched with operation size
  model-type InstrWithFunctElemSizeType = (InstrWithFunct, Id, Id, Str) -> IsaDefs

  model ExtInstrIdMnemo (i: InstrWithFunct, ext: Str): InstrWithFunct = {
    (AsId ($i.id, $ext); AsStr($i.mnemo, ".", $ext); $i.opcode; $i.funct)
    }

  model BHSDReg (size: Id): Id = {
    match: Id ($size = SizeB => ZB ; $size = SizeH => ZH ; $size = SizeD => ZD ; _ => ZS)
    }

  model BitsBHSD (size: Id): Id = {
    match: Id ($size = SizeB => BitsZB ; $size = SizeH => BitsZH ; $size = SizeD => BitsZD ; _ => BitsZS)
    }

  model ElBitsBHSD (size: Id): Id = {
    match: Id ($size = SizeB => BitsB ; $size = SizeH => BitsH ; $size = SizeD => BitsD ; _ => BitsS)
    }

  model PtrueBHSD (size: Id): Id = {
    match: Id ($size = SizeB => PTrueB ; $size = SizeH => PTrueH ; $size = SizeD => PTrueD ; _ => PTrueS)
    }

  model LastActiveBHSD (size: Id): Id = {
    match: Id ($size = SizeB => LastActiveB ; $size = SizeH => LastActiveH ; $size = SizeD => LastActiveD ; _ => LastActiveS)
    }

  model SetFlagsOnesSVE (elSize: Id) : Stats = {
    { NZCV_N := pred(0)
      NZCV_Z := pred = 0
      NZCV_C := pred($LastActiveBHSD($elSize)) = 0
      NZCV_V := false
    }
  }

  model SetFlagsIdentSVE (elSize: Id) : Stats = {
    let predIsZero = (pred & $PtrueBHSD($elSize)) = 0 in {
      NZCV_N := !predIsZero
      NZCV_Z := predIsZero
      NZCV_C := predIsZero
      NZCV_V := false
      }
    }

  model SetFlagsMaskedSVE (elSize: Id) : Stat = {
    let elMask = mask & $PtrueBHSD($elSize) in {
      NZCV_N := if elMask = 0 then false else (pred >> VADL::ctz(elMask)) as Bits<1> as Bool
      NZCV_Z := (elMask & pred) = 0
      NZCV_C := if elMask = 0 then true else !((pred >> (PL - 1 - VADL::clz(elMask))) as Bits<1> as Bool)
      NZCV_V := false
      }
    }

  model SetResultFlagsOnesSVE (elSize: Id) : Stats = {
    P(pd)  := pred as BitsP
    $SetFlagsOnesSVE ($elSize)
    }

  model SetResultFlagsIdentSVE (elSize: Id) : Stats = {
    P(pd)  := pred as BitsP
    $SetFlagsIdentSVE ($elSize)
    }

  model SetResultFlagsMaskedSVE (elSize: Id) : Stats = {
    P(pd)  := pred as BitsP
    $SetFlagsMaskedSVE ($elSize)
    }

  model SetResultFlagsOnesCondSVE (setFlags: Id, elSize: Id) : Stat = {
    match: Stat ( $setFlags = OffFlags => P(pd) := pred as BitsP
                ; _                    => {$SetResultFlagsOnesSVE($elSize)})
    }

  model SetResultFlagsIdentCondSVE (setFlags: Id, elSize: Id) : Stat = {
    match: Stat ( $setFlags = OffFlags => P(pd) := pred as BitsP
                ; _                    => {$SetResultFlagsIdentSVE($elSize)})
    }

  model SetResultFlagsMaskedCondSVE (setFlags: Id, elSize: Id) : Stat = {
    match: Stat ( $setFlags = OffFlags => P(pd) := pred as BitsP
                ; _                    => {$SetResultFlagsMaskedSVE($elSize)})
    }

  model ExtInstrIdStr (i: InstrWithFunct, id: Id, mnemo: Str): InstrWithFunct = {
    (AsId ($i.id, $id); AsStr ($i.mnemo, $mnemo); $i.opcode; $i.funct)
    }

// SVE add vector length model *************************************************

  format SVEAddVLFormat: Instr =           // add vector length format
    { op       [31..21]  : Bits11          // opcode
    , rn       [20..16]  : Index           // source register (SP)
    , opc      [15..11]  : Bits5           // opcode second part
    , imm      [10..5]   : Bits6           // signed scaled immediate operand
    , rd       [4..0]    : Index           // destination register (SP)
    , offset = imm as SIntX * NumElementsB // sign extended and scaled immediate operand
    }

  model SVEAddVLInstr (i: InstrNoFunct): IsaDefs = {
    instruction $i.id: SVEAddVLFormat =
      S(rd) := S(rn) + offset
    encoding $i.id = { op = 0b0000'0100'001, opc = $i.opcode }
    assembly $i.id = ($i.mnemo, ' ', XSizeSP(rd), ', ', XSizeSP(rn), ', #', sdec(imm))
    }

// SVE arithmetic predicated models ********************************************

  format SVEArithmeticPredFormat: Instr =  // arithmetic unpredicated SVE format
    { op       [31..24,21] : Bits9         // opcode
    , size     [23..22]    : Bits2         // elements size (ElSize)
    , opc      [20..13]    : Bits8         // opcode second part
    , pg       [12..10]    : Bits3         // predicate register
    , zm       [9..5]      : Index         // 2st source register
    , zdn      [4..0]      : Index         // 1st source and destination register
    }

  model SVEArithmeticPredInstr (i: InstrWithFunct, elCount: Id, elSize: Id, elStr: Str): IsaDefs = {
    instruction $i.id: SVEArithmeticPredFormat =
      let pred  = P(pg) in
      let left  = Z(zdn) as $BitsBHSD($elSize) in
      let right = Z(zm)  as $BitsBHSD($elSize) in 
        Z(zdn) := forall i : IndexE in 0..$elCount-1
                    tensor if pred(i << ElSize::$elSize)
                      then VADL::$i.funct (left(i), right(i))
                      else left(i)
    encoding $i.id = { op = 0b0000'0100'0, opc = $i.opcode, size = ElSize::$elSize }
    assembly $i.id = ( $i.mnemo, ' ', register(zdn), $elStr, ', ', register(pg), '/m, ', register(zdn), $elStr, ', ', register(zm), $elStr )
    }

// SVE arithmetic unpredicated models ******************************************

  format SVEArithmeticUnprFormat: Instr =  // arithmetic unpredicated SVE format
    { op       [31..24,21] : Bits9         // opcode
    , size     [23..22]    : Bits2         // elements size (ElSize)
    , zm       [20..16]    : Index         // 2nd source register
    , opc      [15..10]    : Bits6         // opcode second part
    , zn       [9..5]      : Index         // 1st source register
    , zd       [4..0]      : Index         // destination register
    }

  model SVEArithmeticUnprInstr (i: InstrWithFunct, elCount: Id, elSize: Id, elStr: Str): IsaDefs = {
    instruction $i.id: SVEArithmeticUnprFormat =
      let left  = Z(zn) as $BitsBHSD($elSize) in
      let right = Z(zm) as $BitsBHSD($elSize) in 
        Z(zd) := forall i : IndexE in 0..$elCount-1
                   tensor VADL::$i.funct (left(i), right(i))
    encoding $i.id = { op = 0b0000'0100'1, opc = $i.opcode, size = ElSize::$elSize }
    assembly $i.id = ( $i.mnemo, ' ', register(zd), $elStr, ', ', register(zn), $elStr, ', ', register(zm), $elStr )
    }

// SVE reduction models ********************************************************

  format SVEReductionFormat: Instr =       // SVE format for reduction
    { op       [31..24]        : Bits8     // opcode
    , size     [23..22]        : Bits2     // elements size (ElSize)
    , opc      [21..13]        : Bits9     // opcode second part
    , pg       [12..10]        : Bits3     // predicate register
    , zn       [9..5]          : Index     // source register (Z)
    , vd       [4..0]          : Index     // destination register (V)
    }

  model FoldOp (op: Id): BinOp = {
    match: BinOp ( $op = add => +
                 ; $op = and => &
                 ; $op = or  => |
                 ; $op = xor => ^
                 ; _         => ∉
                 )
    }

  model NeutralElFold (op: Id, elSize: Id): Ex = {
        match: Ex ( $op = xor => ~(0 as $ElBitsBHSD($elSize))
                  ; _         =>   0 as $ElBitsBHSD($elSize))
  }

  model SVEReductionInstr (i: InstrWithFunct, elCount: Id, elSize: Id, elStr: Str): IsaDefs = {
    instruction $i.id: SVEReductionFormat =
      let pred  = P(pg) in
      let elems = Z(zn) as $BitsBHSD($elSize) in
        $BHSDReg($elSize)(vd)(0) :=
          forall i : IndexE in 0..$elCount-1
            fold $FoldOp($i.funct) with //$FoldOp($i.funct)
              if pred(i << ElSize::$elSize)
              then elems(i)
              else $NeutralElFold($i.funct; $elSize)
    encoding $i.id = { op = 0b0000'0100, opc = $i.opcode, size = ElSize::$elSize }
    assembly $i.id = ( $i.mnemo, ' ', register(vd), $elStr, ', ', register(pg), ', ', register(zn), $elStr )
    }

  model SVEAddExtReductionInstr (i: InstrWithFunct, elCount: Id, elSize: Id, elStr: Str): IsaDefs = {
    [undefined when : size = 0b11]
    instruction $i.id: SVEReductionFormat =
      let pred  = P(pg) in
      let elems = Z(zn) as $BitsBHSD($elSize) in
        ZD(vd)(0) :=
          forall i : IndexE in 0..$elCount-1
            fold + with
              if pred(i << ElSize::$elSize)
              then elems(i) as $i.funct
              else 0
    encoding $i.id = { op = 0b0000'0100, opc = $i.opcode, size = ElSize::$elSize }
    assembly $i.id = ( $i.mnemo, ' ', register(vd), ', ', register(pg), ', ', register(zn), $elStr )
    }

// SIMD move models ************************************************************

  format SIMDMoveFormat: Instr =           // SIMD move format
    { op       [31,29..21]     : Bits10    // opcode
    , sf       [30]            : Bits1     // size field (enum SF), if (sf = 0) 32 bit operation else 64 bit
    , idx      [20]            : Bits1     // index into SIMD vector
    , imm5     [19..16]        : Bits4     // index / size
    , opc      [15..10]        : Bits6     // opcode second part
    , vn       [9..5]          : Index     // source register (V)
    , rd       [4..0]          : Index     // destination register (X)
    }

  model SIMDMoveInstr (i: InstrNoFunct): IsaDefs = {
    instruction $i.id: SIMDMoveFormat =
      X(rd) := ZD(vn)(0)
    encoding $i.id = { op = 0b000'111'0000, opc = $i.opcode, sf = SF::XSize, idx = 0, imm5 = 0b1000 }
    assembly $i.id = ( $i.mnemo, ' ', register(rd), ', ', register(vn), ',.d[0]')
    }

// SVE increment models ********************************************************

  model BHSDDecodePredCount (size: Id): Id = {
    match: Id ( $size = SizeB => DecodePredCountB
              ; $size = SizeH => DecodePredCountH
              ; $size = SizeD => DecodePredCountD
              ; _             => DecodePredCountW)
  }

  model GenDecodePredCount (elSize: Id): IsaDefs = { 
    function $BHSDDecodePredCount ($elSize)(pattern: Bits5) -> BitsX =
      let elCount = VL as BitsX >> (3 + ElSize::$elSize) in
        match pattern with
          { 0b00000 => elCount // elCount is always a power of 2
          , 0b00001 => if elCount >=   1 then   1 as BitsX else 0
          , 0b00010 => if elCount >=   2 then   2 as BitsX else 0
          , 0b00011 => if elCount >=   3 then   3 as BitsX else 0
          , 0b00100 => if elCount >=   4 then   4 as BitsX else 0
          , 0b00101 => if elCount >=   5 then   5 as BitsX else 0
          , 0b00110 => if elCount >=   6 then   6 as BitsX else 0
          , 0b00111 => if elCount >=   7 then   7 as BitsX else 0
          , 0b01000 => if elCount >=   8 then   8 as BitsX else 0
          , 0b01001 => if elCount >=  16 then  16 as BitsX else 0
          , 0b01010 => if elCount >=  32 then  32 as BitsX else 0
          , 0b01011 => if elCount >=  64 then  64 as BitsX else 0
          , 0b01100 => if elCount >= 128 then 128 as BitsX else 0
          , 0b01101 => if elCount >= 256 then 256 as BitsX else 0
          , 0b11101 => elCount - elCount % 4
          , 0b11110 => elCount - elCount % 3
          , 0b11111 => elCount
          , _       => 0
          }
    }

  $GenDecodePredCount(SizeB)
  $GenDecodePredCount(SizeH)
  $GenDecodePredCount(SizeW)
  $GenDecodePredCount(SizeD)

  function patternStr(pattern: Bits5) -> String =
      match pattern with
        { 0b00000 => "pow2"     // elCount is always a power of 2
        , 0b00001 => "vl1"
        , 0b00010 => "vl2"
        , 0b00011 => "vl3"
        , 0b00100 => "vl4"
        , 0b00101 => "vl5"
        , 0b00110 => "vl6"
        , 0b00111 => "vl7"
        , 0b01000 => "vl8"
        , 0b01001 => "vl16"
        , 0b01010 => "vl32"
        , 0b01011 => "vl64"
        , 0b01100 => "vl128"
        , 0b01101 => "vl256"
        , 0b11101 => "mul4"
        , 0b11110 => "mul3"
        , 0b11111 => "all"
        , _       => ("#", udec(pattern))
        }

  format SVEIncrementFormat: Instr =       // SVE increment format
    { op       [31..24,21..20] : Bits10    // opcode
    , size     [23..22]        : Bits2     // elements size (ElSize)
    , imm4     [19..16]        : Bits4     // unsigned multiplier
    , opc      [15..10]        : Bits6     // opcode second part
    , pattern  [9..5]          : Bits5     // pattern
    , dn       [4..0]          : Index     // source and destination register
    , imm      = imm4 as BitsX + 1
    , countB   = DecodePredCountB(pattern)
    , countH   = DecodePredCountH(pattern)
    , countW   = DecodePredCountW(pattern)
    , countD   = DecodePredCountD(pattern)
    }

  model SVEIncrementAll (id: Id, mnemo: Str, count: Id, elSize: Id): IsaDefs = {
    instruction $id: SVEIncrementFormat =
      X(dn) := X(dn) + (VL as BitsX >> (3+ElSize::$elSize)) * imm
    encoding $id = { op = 0b0000'0100'1, opc = 0b111000, size = ElSize::$elSize, pattern = 0b1'1111 }
    assembly $id = ( $mnemo, ' ', register(dn), ', all, mul #', udec(imm) )
    }

  model SVEIncrementPat (id: Id, mnemo: Str, count: Id, elSize: Id): IsaDefs = {
    instruction $id: SVEIncrementFormat =
      X(dn) := X(dn) + $count * imm
    [select when : pattern != 0b1'1111]
    encoding $id = { op = 0b0000'0100'1, opc = 0b111000, size = ElSize::$elSize }
    assembly $id = ( $mnemo, ' ', register(dn), ', ', patternStr(pattern), ', mul #', udec(imm) )
    }

  model SVEIncrementBase (id: Id, mnemo: Str, count: Id, elSize: Id): IsaDefs = {
    $SVEIncrementAll (     $id;       $mnemo; $count; $elSize)
    $SVEIncrementPat (AsId($id, Pat); $mnemo; $count; $elSize)
    }

  model SVEIncrInstr (i: InstrWithFunct): IsaDefs = {
    $SVEIncrementBase (SVEINCB; "incb"; countB; SizeB)
    $SVEIncrementBase (SVEINCH; "inch"; countH; SizeH)
    $SVEIncrementBase (SVEINCW; "incw"; countW; SizeW)
    $SVEIncrementBase (SVEINCD; "incd"; countD; SizeD)
    }

// predicate true / false models ***********************************************

  format SVEPTrueFormat: Instr =           // SVE predicate true format
    { op       [31..24,21..17] : Bits13    // opcode
    , size     [23..22]        : Bits2     // elements size (ElSize)
    , setfl    [16]            : Bits1     // set flags if (setfl = 1)
    , opc      [15..10,4]      : Bits7     // opcode second part
    , pattern  [9..5]          : Bits5     // pattern
    , pd       [3..0]          : IndexP    // destination predicate register
    }

  model SVEPTrueAllInstr (i: InstrWithFunct, elCount: Id, elSize: Id, elStr: Str): IsaDefs = {
    instruction $i.id: SVEPTrueFormat =
      let pred = $PtrueBHSD ($elSize) in
        $SetResultFlagsIdentCondSVE ($i.funct; $elSize)
    encoding $i.id = { op = 0b0010'0101'0110'0, opc = $i.opcode, size = ElSize::$elSize, setfl = FF::$i.funct, pattern = 0b1'1111 }
    assembly $i.id = ($i.mnemo, ' ', register(pd), $elStr)
    }

  model SVEPTruePatInstr (i: InstrWithFunct, elCount: Id, elSize: Id, elStr: Str): IsaDefs = {
    instruction $i.id: SVEPTrueFormat =
      let count = $BHSDDecodePredCount($elSize)(pattern) in
      let pred  =
        if count = 0
          then 0
          else $PtrueBHSD ($elSize) >> (($elCount - count) << ElSize::$elSize) in
        $SetResultFlagsIdentCondSVE ($i.funct; $elSize)
    [select when : pattern != 0b1'1111]
    encoding $i.id = { op = 0b0010'0101'0110'0, opc = $i.opcode, size = ElSize::$elSize, setfl = FF::$i.funct }
    assembly $i.id = ($i.mnemo, ' ', register(pd), $elStr, ', ', patternStr(pattern))
    }

  model SVEPTrueInstr (i: InstrWithFunct, elCount: Id, elSize: Id, elStr: Str): IsaDefs = {
    $SVEPTrueAllInstr (              $i;         $elCount; $elSize; $elStr)
    $SVEPTruePatInstr ($ExtInstrStr ($i; "Pat"); $elCount; $elSize; $elStr)
    }

  model SVEPFalseInstr (i: InstrWithFunct): IsaDefs = {
    instruction $i.id: SVEPTrueFormat =
        P(pd) := PFalse
    encoding $i.id = { op = 0b0010'0101'0110'0, opc = $i.opcode, size = ElSize::SizeB, setfl = FF::$i.funct, pattern = 0 }
    assembly $i.id = ($i.mnemo, ' ', register(pd), '.b')
    }

// predicate logic models ******************************************************

  format SVEPredLogicFormat: Instr =       // SVE predicate logic format
    { op       [31..24,21..20] : Bits10    // opcode
    , setfl    [22]            : Bits1     // set flags when setfl = 1
    , opc      [23,15,14,9,4]  : Bits5     // opcode second part
    , pm       [19..16]        : IndexP    // 2nd source  predicate register
    , pg       [13..10]        : IndexP    // governing   predicate register (mask)
    , pn       [8..5]          : IndexP    // 1st source  predicate register
    , pd       [3..0]          : IndexP    // destination predicate register
    }

  function predAnd  (mask: BitsP, src1: BitsP, src2: BitsP) -> BitsP = mask & (src1 & src2)
  function predBic  (mask: BitsP, src1: BitsP, src2: BitsP) -> BitsP = mask & (src1 & ~ src2)
  function predXor  (mask: BitsP, src1: BitsP, src2: BitsP) -> BitsP = mask & (src1 ^ src2)
  function predNand (mask: BitsP, src1: BitsP, src2: BitsP) -> BitsP = mask & (~ (src1 & src2))
  function predNor  (mask: BitsP, src1: BitsP, src2: BitsP) -> BitsP = mask & (~ (src1 | src2))
  function predOrn  (mask: BitsP, src1: BitsP, src2: BitsP) -> BitsP = mask & (src1 | ~ src2)
  function predOr   (mask: BitsP, src1: BitsP, src2: BitsP) -> BitsP = mask & (src1 | src2)
  function predSel  (mask: BitsP, src1: BitsP, src2: BitsP) -> BitsP = mask & src1 | ~ mask & src2

  model SVEPredLogicFlagsInstr (i: InstrWithFunct, setFlags: Id): IsaDefs = {
    instruction $i.id: SVEPredLogicFormat =
      let mask = P(pg) as BitsP in
      let src1 = P(pn) as BitsP in
      let src2 = P(pm) as BitsP in
      let pred = $i.funct (mask, src1, src2) in
        $SetResultFlagsMaskedCondSVE ($setFlags; SizeB)
    encoding $i.id = { op = 0b0010'0101'00, opc = $i.opcode, setfl = FF::$setFlags }
    assembly $i.id = ($i.mnemo, ' ', register(pd), '.b, ', register(pg), '/z, ', register(pn), '.b, ', register(pm), '.b')
    }

  model SVEPredLogicInstr (i: InstrWithFunct): IsaDefs = {
    $SVEPredLogicFlagsInstr ($i;                           OffFlags)
    $SVEPredLogicFlagsInstr ($ExtInstrIdStr($i ; S ; "s"); SetFlags)
    }

  model SVEPredLogicOffFl (i: InstrWithFunct): IsaDefs = {
    $SVEPredLogicFlagsInstr ($i; OffFlags)
    }

  model SVEPredTestInstr (i: InstrWithFunct): IsaDefs = {
    instruction $i.id: SVEPredLogicFormat =
      let mask = P(pg) as BitsP in
      let pred = P(pn) as BitsP in
        $SetFlagsMaskedSVE (SizeB)
    encoding $i.id = { op = 0b0010'0101'01, opc = $i.opcode, setfl = FF::SetFlags, pm = 0, pd = 0 }
    assembly $i.id = ($i.mnemo, ' ', register(pg), ', ', register(pn), '.b')
    }

// predicate first / next models ***********************************************

  format SVEPredFirstNextFormat: Instr =   // SVE predicate first / next format
    { op       [31..24,21..20] : Bits10    // opcode
    , size     [23..22]        : Bits2     // elements size (ElSize)
    , opc      [19..9,4]       : Bits12    // opcode second part
    , pg       [8..5]          : IndexP    // 1st source predicate register
    , pd       [3..0]          : IndexP    // 2nd source / destination predicate register
    }

  model SVEPredFirstInstr (i: InstrWithFunct, elCount: Id, elSize: Id, elStr: Str): IsaDefs = {
    instruction $i.id: SVEPredFirstNextFormat =
      let mask = P(pg) as BitsP in
      let src  = P(pd) as BitsP in
      let orMask = if mask = 0
        then 0
        else let pos = VADL::ctz(mask) in 1 as BitsP << pos in
      let pred = src | orMask in
        {$SetResultFlagsMaskedSVE ($elSize)}
    encoding $i.id = { op = 0b0010'0101'01, opc = $i.opcode, size = 0b01 }
    assembly $i.id = ($i.mnemo, ' ', register(pd), $elStr, ', ', register(pg),', ', register(pd), $elStr)
    }

  model SVEPredNextInstr (i: InstrWithFunct, elCount: Id, elSize: Id, elStr: Str): IsaDefs = {
    instruction $i.id: SVEPredFirstNextFormat =
      let mask = P(pg) as BitsP & $PtrueBHSD ($elSize) in
      let src  = P(pd) as BitsP & $PtrueBHSD ($elSize) in
      let clrMsk = if src = 0 
        then mask
        else let clr = PL - VADL::clz(src) in mask >> clr << clr in
      let pred = if clrMsk = 0
        then 0
        else let pos = VADL::ctz(clrMsk) in 1 as BitsP << pos in
        {$SetResultFlagsMaskedSVE ($elSize)}
    encoding $i.id = { op = 0b0010'0101'01, opc = $i.opcode, size = ElSize::$elSize }
    assembly $i.id = ($i.mnemo, ' ', register(pd), $elStr, ', ', register(pg),', ', register(pd), $elStr)
    }

// predicate count models ******************************************************

  format SVEPredCountFormat: Instr =       // SVE predicate count format
    { op       [31..24,21..19] : Bits11    // opcode
    , size     [23..22]        : Bits2     // elements size (ElSize)
    , opc      [18..14,9]      : Bits6     // opcode second part
    , pg       [13..10]        : IndexP    // mask predicate register
    , pn       [8..5]          : IndexP    // source predicate register
    , rd       [4..0]          : Index     // destination X register
    }

  model SVEPredCountInstr (i: InstrWithFunct, elCount: Id, elSize: Id, elStr: Str): IsaDefs = {
    instruction $i.id: SVEPredCountFormat =
      let elMsk = $PtrueBHSD ($elSize) in
      let msk   = P(pg) in
      let src   = P(pn) in
      let and   = elMsk & msk & src in
        S(rd) := VADL::cob(and)
    encoding $i.id = { op = 0b0010'0101'100, opc = $i.opcode, size = ElSize::$elSize }
    assembly $i.id = ($i.mnemo, ' ', XSizeSP(rd), ', ', register(pg), ', ', register(pn), $elStr)
    }

  model SVEPredIncCountInstr (i: InstrWithFunct, elCount: Id, elSize: Id, elStr: Str): IsaDefs = {
    instruction $i.id: SVEPredCountFormat =
      let src  = P(pn) & $PtrueBHSD ($elSize) in
        S(rd) := S(rd) + VADL::cob(src)
    encoding $i.id = { op = 0b0010'0101'101, opc = $i.opcode, size = ElSize::$elSize, pg = 0b0010 }
    assembly $i.id = ($i.mnemo, ' ', XSizeSP(rd), ', ', register(pn), $elStr)
    }

// SVE while models ************************************************************

  constant MaxUIntX : BitsX = 0xffff'ffff'ffff'ffff
  constant MaxSIntX : BitsX = 0x7fff'ffff'ffff'ffff
  constant MaxUIntW : BitsW = 0xffff'ffff
  constant MaxSIntW : BitsW = 0x7fff'ffff
  constant MinUIntX : BitsX = 0x0000'0000'0000'0000
  constant MinSIntX : BitsX = 0x8000'0000'0000'0000
  constant MinUIntW : BitsW = 0x0000'0000
  constant MinSIntW : BitsW = 0x8000'0000

  model UMax (size: Id): Id = { match: Id ($size = WSize => MaxUIntW ; _ => MaxUIntX) }
  model SMax (size: Id): Id = { match: Id ($size = WSize => MaxSIntW ; _ => MaxSIntX) }
  model UMin (size: Id): Id = { match: Id ($size = WSize => MinUIntW ; _ => MinUIntX) }
  model SMin (size: Id): Id = { match: Id ($size = WSize => MinSIntW ; _ => MinSIntX) }

  enumeration CondSVE : Bits<3> =          // SVE condition code encodings
    { GE = 0b000                           // Greater or Equal signed   U == 0   LT == 0   EQ == 0
    , GT = 0b001                           // Greater Than     signed   U == 0   LT == 0   EQ == 1
    , LT = 0b010                           // Less Than        signed   U == 0   LT == 1   EQ == 0
    , LE = 0b011                           // Less or Equal    signed   U == 0   LT == 1   EQ == 1
    , HS = 0b100                           // Higer or Same  unsigned   U == 1   LT == 0   EQ == 0
    , HI = 0b101                           // HIgher         unsigned   U == 1   LT == 0   EQ == 1
    , LO = 0b110                           // LOwer than     unsigned   U == 1   LT == 1   EQ == 0
    , LS = 0b111                           // Lower or Same  unsigned   U == 1   LT == 1   EQ == 1
    }

  format SVEWhileFormat: Instr =           // SVE while predicate format
    { op       [31..24,21]     : Bits9     // opcode
    , size     [23..22]        : Bits2     // elements size (ElSize)
    , rm       [20..16]        : Index     // 2nd source counter register
    , opc      [15..13]        : Bits3     // opcode second part
    , sf       [12]            : Bits1     // size field (enum SF), if (sf = 0) 32 bit operation else 64 bit
    , cond     [11,10,4]       : Bits3     // condition (enum CondSVE)
    , rn       [9..5]          : Index     // 1st source counter register
    , pd       [3..0]          : IndexP    // destination predicate register
    }

  record WhileRec  (cond: Id, minmax: Id, notcmp: Id, elCount: Id, elSize: Id, elStr: Str)

  model WXR (size: Id): Id = {
    match: Id ($size = WSize => W ; _ => X)
  }

  model-type SVEWhileStatModel = (WhileRec, Id) -> Stat

  model SVEWhileStatLSLE (w: WhileRec, regSize: Id): Stat = {
    let left  = $WXR($regSize)(rn) in
    let right = $WXR($regSize)(rm) in
    let pred  = 
      if right = $w.minmax
        then $PtrueBHSD($w.elSize)
        else
        if VADL::$w.notcmp(left, right)
        then PFalse
        else let diff = (right - left) + 1 in
          if diff >= $w.elCount
          then $PtrueBHSD($w.elSize)
          else let shift = ($w.elCount - diff as IndexE) << ElSize::$w.elSize in
            $PtrueBHSD($w.elSize) as Bits<PL> >> shift
      in { $SetResultFlagsOnesSVE($w.elSize) }
  }

  model SVEWhileStatLOLT (w: WhileRec, regSize: Id): Stat = {
    let left  = $WXR($regSize)(rn) in
    let right = $WXR($regSize)(rm) in
    let pred  = 
      if VADL::$w.notcmp(left, right)
      then PFalse
      else let diff = (right - left) in
        if diff >= $w.elCount
        then $PtrueBHSD($w.elSize)
        else let shift = ($w.elCount - diff as IndexE) << ElSize::$w.elSize in
          $PtrueBHSD($w.elSize) as Bits<PL> >> shift
      in { $SetResultFlagsOnesSVE($w.elSize) }
  }

  model SVEWhileStatHSGE (w: WhileRec, regSize: Id): Stat = {
    let left  = $WXR($regSize)(rn) in
    let right = $WXR($regSize)(rm) in
    let pred  = 
      if right = $w.minmax
        then $PtrueBHSD($w.elSize)
        else
        if VADL::$w.notcmp(left, right)
        then PFalse
        else let diff = (left - right) + 1 in
          if diff >= $w.elCount
          then $PtrueBHSD($w.elSize)
          else let shift = ($w.elCount - diff as IndexE) << ElSize::$w.elSize in
            $PtrueBHSD($w.elSize) as Bits<PL> << shift
      in { $SetResultFlagsOnesSVE($w.elSize) }
  }

  model SVEWhileStatHIGT (w: WhileRec, regSize: Id): Stat = {
    let left  = $WXR($regSize)(rn) in
    let right = $WXR($regSize)(rm) in
    let pred  = 
      if VADL::$w.notcmp(left, right)
      then PFalse
      else let diff = (left - right) in
        if diff >= $w.elCount
        then $PtrueBHSD($w.elSize)
        else let shift = ($w.elCount - diff as IndexE) << ElSize::$w.elSize in
          $PtrueBHSD($w.elSize) as Bits<PL> << shift
      in { $SetResultFlagsOnesSVE($w.elSize) }
  }

  model SVEWhileBaseInstr (m: SVEWhileStatModel, i: InstrWithFunct, w: WhileRec, regSize: Id): IsaDefs = {
    instruction $i.id: SVEWhileFormat = $m ($w ; $regSize)
    encoding $i.id = { op = 0b0010'0101'1, opc = $i.opcode, size = ElSize::$w.elSize, sf = SF::$regSize, cond = CondSVE::$w.cond }
    assembly $i.id = ( $i.mnemo, ' ', register(pd), $w.elStr, ', ', $regSize(rn), ', ', $regSize(rm))
    }

  model SVEWhileCondInstr (i: InstrWithFunct, regSize: Id, elCount: Id, elSize: Id, elStr: Str): IsaDefs = {
    $SVEWhileBaseInstr (SVEWhileStatLSLE ; $ExtInstrIdStr($i ; LS ; "ls"); (LS ; $UMax($regSize) ; ugth ; $elCount ; $elSize ; $elStr) ; $regSize)
    $SVEWhileBaseInstr (SVEWhileStatLSLE ; $ExtInstrIdStr($i ; LE ; "le"); (LE ; $SMax($regSize) ; sgth ; $elCount ; $elSize ; $elStr) ; $regSize)
    $SVEWhileBaseInstr (SVEWhileStatLOLT ; $ExtInstrIdStr($i ; LO ; "lo"); (LO ; Unused          ; ugeq ; $elCount ; $elSize ; $elStr) ; $regSize)
    $SVEWhileBaseInstr (SVEWhileStatLOLT ; $ExtInstrIdStr($i ; LT ; "lt"); (LT ; Unused          ; sgeq ; $elCount ; $elSize ; $elStr) ; $regSize)
    $SVEWhileBaseInstr (SVEWhileStatHSGE ; $ExtInstrIdStr($i ; HS ; "hs"); (HS ; $UMin($regSize) ; ulth ; $elCount ; $elSize ; $elStr) ; $regSize)
    $SVEWhileBaseInstr (SVEWhileStatHSGE ; $ExtInstrIdStr($i ; GE ; "ge"); (GE ; $SMin($regSize) ; slth ; $elCount ; $elSize ; $elStr) ; $regSize)
    $SVEWhileBaseInstr (SVEWhileStatHIGT ; $ExtInstrIdStr($i ; HI ; "hi"); (HI ; Unused          ; uleq ; $elCount ; $elSize ; $elStr) ; $regSize)
    $SVEWhileBaseInstr (SVEWhileStatHIGT ; $ExtInstrIdStr($i ; GT ; "gt"); (GT ; Unused          ; sleq ; $elCount ; $elSize ; $elStr) ; $regSize)
    }

  model SVEWhileXWInstr (i: InstrWithFunct, elCount: Id, elSize: Id, elStr: Str): IsaDefs = {
    $SVEWhileCondInstr ($ExtInstrStr ($i;  "W"); WSize ; $elCount ; $elSize ; $elStr)
    $SVEWhileCondInstr ($ExtInstrStr ($i;  "X"); XSize ; $elCount ; $elSize ; $elStr)
    }

// SVE load / store predicate register models **********************************

  format SVEMemPredicateFormat: Instr =    // SVE memory predicate register format
    { op       [31..22]        : Bits10    // opcode
    , imm9     [21..16,12..10] : Bits9     // signed scaled by PL immediate offset
    , opc      [15..13,4]      : Bits4     // opcode second part
    , rn       [9..5]          : Index     // base address X/SP register
    , pt       [3..0]          : IndexP    // target (source / destination) predicate register
    , offset = imm9 as SIntX * NumBytesPL
    }

  model SVELoadPredBase (i: InstrWithFunct): IsaDefs = {
    encoding $i.id = { op = $i.opcode, opc = 0b0000 }
    assembly $i.id = ( $i.mnemo, ' ', register(pt), ', ', XSizeSP(rn), ', #', sdec(imm9), ', mul vl')
    }

  model SVELoadPredInstr (i: InstrWithFunct): IsaDefs = {
    instruction $i.id: SVEMemPredicateFormat =
      let addr = S(rn) + offset in
        P(pt) := MEM<NumBytesPL>(addr)
    $SVELoadPredBase ($i)
    }

  model SVEStorePredInstr (i: InstrWithFunct): IsaDefs = {
    instruction $i.id: SVEMemPredicateFormat =
      let addr = S(rn) + offset in
        MEM<NumBytesPL>(addr) := P(pt)
    $SVELoadPredBase ($i)
    }

// SVE load / store vector register models *************************************

  format SVEMemVectorFormat: Instr =       // SVE memory vector register format
    { op       [31..22]        : Bits10    // opcode
    , imm9     [21..16,12..10] : Bits9     // signed scaled by VL immediate offset
    , opc      [15..13]        : Bits3     // opcode second part
    , rn       [9..5]          : Index     // base address X/SP register
    , zt       [4..0]          : Index     // target (source / destination) Z register
    , offset = imm9 as SIntX * NumElementsB
    }

  model SVELoadVectBase (i: InstrWithFunct): IsaDefs = {
    encoding $i.id = { op = $i.opcode, opc = 0b010 }
    assembly $i.id = ( $i.mnemo, ' ', register(zt), ', ', XSizeSP(rn), ', #', sdec(imm9), ', mul vl')
    }

  model SVELoadVectInstr (i: InstrWithFunct): IsaDefs = {
    instruction $i.id: SVEMemVectorFormat =
      let addr = S(rn) + offset in
        Z(zt) := MEM<NumElementsB>(addr)
    $SVELoadVectBase ($i)
    }

  model SVEStoreVectInstr (i: InstrWithFunct): IsaDefs = {
    instruction $i.id: SVEMemVectorFormat =
      let addr = S(rn) + offset in
        MEM<NumElementsB>(addr) := Z(zt)
    $SVELoadVectBase ($i)
    }

// SVE load / store common definitions *****************************************

  enumeration LDDtype : Bits<4> =          // load data type, memory and element size and type
    { DtUBB = 0b0000                       // unsigned load memory byte, element byte
    , DtUBH = 0b0001                       // unsigned load memory byte, element half
    , DtUBW = 0b0010                       // unsigned load memory byte, element word
    , DtUBD = 0b0011                       // unsigned load memory byte, element double
    , DtSWD = 0b0100                       //   signed load memory word, element double
    , DtUHH = 0b0101                       // unsigned load memory half, element half
    , DtUHW = 0b0110                       // unsigned load memory half, element word
    , DtUHD = 0b0111                       // unsigned load memory half, element double
    , DtSHD = 0b1000                       //   signed load memory half, element double
    , DtSHW = 0b1001                       //   signed load memory half, element word
    , DtUWW = 0b1010                       // unsigned load memory word, element word
    , DtUWD = 0b1011                       // unsigned load memory word, element double
    , DtSBD = 0b1100                       //   signed load memory byte, element double
    , DtSBW = 0b1101                       //   signed load memory byte, element word
    , DtSBH = 0b1110                       //   signed load memory byte, element half
    , DtUDD = 0b1111                       // unsigned load memory double, element double
    }

  enumeration STDtype : Bits<4> =          // store data type, memory and element size and type
    { DtBB = 0b0000                        // store memory byte, element byte
    , DtBH = 0b0001                        // store memory byte, element half
    , DtBW = 0b0010                        // store memory byte, element word
    , DtBD = 0b0011                        // store memory byte, element double
    , DtHR = 0b0100                        // reserved
    , DtHH = 0b0101                        // store memory half, element half
    , DtHW = 0b0110                        // store memory half, element word
    , DtHD = 0b0111                        // store memory half, element double
    , DtWQ = 0b1000                        // store memory word, element quad
    , DtWR = 0b1001                        // reserved
    , DtWW = 0b1010                        // store memory word, element word
    , DtWD = 0b1011                        // store memory word, element double
    , DtR1 = 0b1100                        // reserved
    , DtR2 = 0b1100                        // reserved
    , DtDQ = 0b1110                        // store memory double, element quad
    , DtDD = 0b1111                        // store memory double, element double
    }

  enumeration MulDtype : Bits<4> =         // load/store data type for multiple structures
    { Dt2B = 0b0001                        // access 2 times byte
    , Dt2W = 0b0101                        // access 2 times half
    , Dt2H = 0b1001                        // access 2 times word
    , Dt2D = 0b1101                        // access 2 times double
    , Dt3B = 0b0010                        // access 3 times byte
    , Dt3W = 0b0110                        // access 3 times half
    , Dt3H = 0b1010                        // access 3 times word
    , Dt3D = 0b1110                        // access 3 times double
    , Dt4B = 0b0011                        // access 4 times byte
    , Dt4W = 0b0111                        // access 4 times half
    , Dt4H = 0b1011                        // access 4 times word
    , Dt4D = 0b1111                        // access 4 times double
    }

  enumeration NumVectors : BitsX =         // number of vector registers for multiple load / stores
    { X2 = 2                               // use 2 vectors
    , X3 = 3                               // use 3 vectors
    , X4 = 4                               // use 4 vectors
    }

  function Imm2lslU  (imm: Bits<2>)  -> String =
    if imm = 0 then "" else (", lsl #", udec(imm))
 
  record MemSVE    (dtype: Id, elCount: Id, memBytes: Int, elSize: Id, elStr: Str, elType: Id, extStr: Str)
  record MulMemSVE (dtype: Id, elCount: Id, numVector: Id, elSize: Id, elStr: Str, extStr: Str)

  model SVERegsX2 (ext: Str): Ex = {
    (register(zt), $ext, ', ', register(zt2), $ext)
  }

  model SVERegsX3 (ext: Str): Ex = {
    ($SVERegsX2 ($ext), ', ', register(zt3), $ext)
  }

  model SVERegsX4 (ext: Str): Ex = {
    ($SVERegsX3 ($ext), ', ', register(zt4), $ext)
  }

  model SVERegsXX (mul: Id, ext: Str): Ex = {
    match: Ex ($mul = X2 => $SVERegsX2($ext) ; $mul = X3 => $SVERegsX3($ext) ;  _ => $SVERegsX4($ext))
    }

// SVE load / store scalar immediate single register models ********************

  format SVEMemScalarImmOneFormat: Instr = // SVE memory scalar immediate format
    { op       [31..25,20]     : Bits8     // opcode
    , dtype    [24..21]        : Bits4     // memory and element size and type ((LD/ST)Dtype)
    , opc      [15..13]        : Bits3     // opcode second part
    , imm4     [19..16]        : Bits4     // signed scaled immediate offset
    , pg       [12..10]        : Bits3     // predicate register
    , rn       [9..5]          : Index     // base address X/SP register
    , zt       [4..0]          : Index     // destination Z register
    , offset   = imm4 as SIntX
    , offsetX2 = imm4 as SIntX << 1
    , offsetX3 = imm4 as SIntX *  3
    , offsetX4 = imm4 as SIntX << 2
    , zt2      = zt + 1
    , zt3      = zt + 2
    , zt4      = zt + 3
    }

  model SVELoadScalarImmInstr (i: InstrWithFunct, d: MemSVE): IsaDefs = {
    instruction $i.id: SVEMemScalarImmOneFormat =
      let base = S(rn) + offset * $d.elCount * $d.memBytes in
      let pred  = P(pg) in
        Z(zt) := forall i : SIntX in 0..$d.elCount-1 tensor
          if pred(i << ElSize::$d.elSize)
            then MEM<$d.memBytes>(base + i * $d.memBytes) as $d.elType<(8 << ElSize::$d.elSize)>
            else 0
    encoding $i.id = { op = 0b101'0010'0, opc = $i.opcode, dtype = LDDtype::$d.dtype }
    assembly $i.id = ( AsStr($i.mnemo, $d.extStr), ' ', register(zt), $d.elStr, ', ', register(pg), '/z, ', XSizeSP(rn), ', #', sdec(imm4))
    }

  model SVEStoreScalarImmInstr (i: InstrWithFunct, d: MemSVE): IsaDefs = {
    instruction $i.id: SVEMemScalarImmOneFormat =
      let base = S(rn) + offset * $d.elCount * $d.memBytes in
      let pred  = P(pg) in
      let elems = Z(zt) as $BitsBHSD($d.elSize) in
        forall i : SIntX in 0..$d.elCount-1 do
          if pred(i << ElSize::$d.elSize)
            then MEM<$d.memBytes>(base + i * $d.memBytes) := elems(i) as Bits<(8 * $d.memBytes)>
    encoding $i.id = { op = 0b111'0010'0, opc = $i.opcode, dtype = STDtype::$d.dtype }
    assembly $i.id = ( AsStr($i.mnemo, $d.extStr), ' ', register(zt), $d.elStr, ', ', register(pg), '/z, ', XSizeSP(rn), ', #', sdec(imm4))
    }

  model SVMulLoadReg (mul: Id, elSize: Id): Stat = {
    match: Stat ($mul = X2 => {} ;
                 $mul = X3 =>  $BHSDReg($elSize)(zt3)(i) := MEM<(ElBytes::$elSize)>(addr + ElBytes::$elSize * 2) ;
                         _ => {$BHSDReg($elSize)(zt3)(i) := MEM<(ElBytes::$elSize)>(addr + ElBytes::$elSize * 2)
                               $BHSDReg($elSize)(zt4)(i) := MEM<(ElBytes::$elSize)>(addr + ElBytes::$elSize * 3)})
  }

  model SVMulClearReg (mul: Id, elSize: Id): Stat = {
    match: Stat ($mul = X2 => {} ;
                 $mul = X3 =>  $BHSDReg($elSize)(zt3)(i) := 0 ;
                         _ => {$BHSDReg($elSize)(zt3)(i) := 0
                               $BHSDReg($elSize)(zt4)(i) := 0})
  }

  model SVEMemMulScalarImmBase (i: InstrWithFunct, d: MulMemSVE): IsaDefs = {
    encoding $i.id = { op = $i.opcode, opc = 0b111, dtype = MulDtype::$d.dtype }
    assembly $i.id = ( AsStr($i.mnemo, $d.extStr), ' {', $SVERegsXX($d.numVector; $d.elStr), '}, ', register(pg), '/z, ', XSizeSP(rn), ', #', sdec(AsId(offset,$d.numVector)), ', mul vl')
    }

  model SVELoadMulScalarXStat (i: InstrWithFunct, d: MulMemSVE): Stat = {
      let pred  = P(pg) in
        forall i : SIntX in 0..$d.elCount-1 do
          let addr = base + i * ElBytes::$d.elSize * NumVectors::$d.numVector in
            if pred(i << ElSize::$d.elSize)
              then {
                $BHSDReg($d.elSize)(zt )(i) := MEM<(ElBytes::$d.elSize)>(addr)
                $BHSDReg($d.elSize)(zt2)(i) := MEM<(ElBytes::$d.elSize)>(addr + ElBytes::$d.elSize)
                $SVMulLoadReg($d.numVector; $d.elSize)
                }
              else {
                $BHSDReg($d.elSize)(zt )(i) := 0
                $BHSDReg($d.elSize)(zt2)(i) := 0
                $SVMulClearReg($d.numVector; $d.elSize)
              }
  }

  model SVELoadMulScalarImmInstr (i: InstrWithFunct, d: MulMemSVE): IsaDefs = {
    instruction $i.id: SVEMemScalarImmOneFormat =
      let base = S(rn) + (AsId(offset, $d.numVector) << ElSize::$d.elSize) * $d.elCount in
        $SVELoadMulScalarXStat ($i; $d)
    $SVEMemMulScalarImmBase ($i; $d)
    }

  model SVMulStoreReg (mul: Id, elSize: Id): Stat = {
    match: Stat ($mul = X2 => {} ;
                 $mul = X3 =>  MEM<(ElBytes::$elSize)>(addr + ElBytes::$elSize * 2) := $BHSDReg($elSize)(zt3)(i) ;
                         _ => {MEM<(ElBytes::$elSize)>(addr + ElBytes::$elSize * 2) := $BHSDReg($elSize)(zt3)(i)
                               MEM<(ElBytes::$elSize)>(addr + ElBytes::$elSize * 3) := $BHSDReg($elSize)(zt4)(i) })
  }

  model SVEStoreMulScalarXStat (i: InstrWithFunct, d: MulMemSVE): Stat = {
      let pred  = P(pg) in
        forall i : SIntX in 0..$d.elCount-1 do
          let addr = base + i * ElBytes::$d.elSize * NumVectors::$d.numVector in
            if pred(i << ElSize::$d.elSize)
              then {
                MEM<(ElBytes::$d.elSize)>(addr) := $BHSDReg($d.elSize)(zt )(i)
                MEM<(ElBytes::$d.elSize)>(addr + ElBytes::$d.elSize) := $BHSDReg($d.elSize)(zt2)(i)
                $SVMulStoreReg($d.numVector; $d.elSize)
                }
    }

  model SVEStoreMulScalarImmInstr (i: InstrWithFunct, d: MulMemSVE): IsaDefs = {
    instruction $i.id: SVEMemScalarImmOneFormat =
      let base = S(rn) + (AsId(offset, $d.numVector) << ElSize::$d.elSize) * $d.elCount in
        $SVEStoreMulScalarXStat ($i; $d)
    $SVEMemMulScalarImmBase ($i; $d)
    }

// SVE load / store scalar scalar single register models ***********************

  format SVEMemScalarScalarFormat: Instr = // SVE memory scalar scalar format
    { op       [31..25]        : Bits7     // opcode
    , dtype    [24..21]        : Bits4     // memory and element size and type ((LD/ST)Dtype)
    , rm       [20..16]        : Index     // scaled index register
    , opc      [15..13]        : Bits3     // opcode second part
    , pg       [12..10]        : Bits3     // predicate register
    , rn       [9..5]          : Index     // base address X/SP register
    , zt       [4..0]          : Index     // destination Z register
    , zt2      = zt + 1
    , zt3      = zt + 2
    , zt4      = zt + 3
    }

  model SVELoadScalarScalarInstr (i: InstrWithFunct, d: MemSVE): IsaDefs = {
    [undefined when : rm = 0b1'1111]
    instruction $i.id: SVEMemScalarScalarFormat =
      let offset = X(rm) in
      let base = S(rn) + offset * $d.memBytes in
      let pred  = P(pg) in
        Z(zt) := forall i : SIntX in 0..$d.elCount-1 tensor
          if pred(i << ElSize::$d.elSize)
            then MEM<$d.memBytes>(base + i * $d.memBytes) as $d.elType<(8 << ElSize::$d.elSize)>
            else 0
    encoding $i.id = { op = 0b101'0010, opc = $i.opcode, dtype = LDDtype::$d.dtype }
    assembly $i.id = ( AsStr($i.mnemo, $d.extStr), ' ', register(zt), $d.elStr, ', ', register(pg), '/z, [', XSizeSP(rn), ',', XSize(rm), Imm2lslU(ElSize::$d.elSize), ']')
    }

  model SVEStoreScalarScalarInstr (i: InstrWithFunct, d: MemSVE): IsaDefs = {
    [undefined when : rm = 0b1'1111]
    instruction $i.id: SVEMemScalarScalarFormat =
      let offset = X(rm) in
      let base  = S(rn) + offset * $d.memBytes in
      let pred  = P(pg) in
      let elems = Z(zt) as $BitsBHSD($d.elSize) in
        forall i : SIntX in 0..$d.elCount-1 do
          if pred(i << ElSize::$d.elSize)
            then MEM<$d.memBytes>(base + i * $d.memBytes) := elems(i) as Bits<(8 * $d.memBytes)>
    encoding $i.id = { op = 0b111'0010, opc = $i.opcode, dtype = STDtype::$d.dtype }
    assembly $i.id = ( AsStr($i.mnemo, $d.extStr), ' ', register(zt), $d.elStr, ', ', register(pg), '/z, [', XSizeSP(rn), ',', XSize(rm), Imm2lslU(ElSize::$d.elSize), ']')
    }

  model SVEMemMulScalarSclBase (i: InstrWithFunct, d: MulMemSVE, opc: Bin): IsaDefs = {
    [select when : rm != 0b1'1111]
    encoding $i.id = { op = $i.opcode, opc = $opc, dtype = MulDtype::$d.dtype }
    assembly $i.id = ( AsStr($i.mnemo, $d.extStr), ' {', $SVERegsXX($d.numVector; $d.elStr), '}, ', register(pg), '/z, [', XSizeSP(rn), XSizeSP(rm), ']')
    }

  model SVELoadMulScalarSclInstr (i: InstrWithFunct, d: MulMemSVE): IsaDefs = {
    [undefined when : rm = 0b1'1111]
    instruction $i.id: SVEMemScalarScalarFormat =
      let offset = X(rm) in
      let base = S(rn) + offset << ElSize::$d.elSize in
        $SVELoadMulScalarXStat ($i; $d)
    $SVEMemMulScalarSclBase ($i; $d; 0b110)
    }

  model SVEStoreMulScalarSclInstr (i: InstrWithFunct, d: MulMemSVE): IsaDefs = {
    [undefined when : rm = 0b1'1111]
    instruction $i.id: SVEMemScalarScalarFormat =
      let offset = X(rm) in
      let base = S(rn) + offset << ElSize::$d.elSize in
        $SVEStoreMulScalarXStat ($i; $d)
    $SVEMemMulScalarSclBase ($i; $d; 0b011)
    }


// instruction enriching models ************************************************

  model-type InstrWithFunctMemSVE = (InstrWithFunct, MemSVE) -> IsaDefs
  model-type InstrWithFunctMulMemSVE = (InstrWithFunct, MulMemSVE) -> IsaDefs

  model InstrMemLD16 (modelid: InstrWithFunctMemSVE, i: InstrWithFunct): IsaDefs = {
    $modelid ($ExtInstrStr ($i; "UBB"); (DtUBB; NumElementsB; 1; SizeB; '.b'; Bits; "b" ))
    $modelid ($ExtInstrStr ($i; "UBH"); (DtUBH; NumElementsH; 1; SizeH; '.h'; Bits; "b" ))
    $modelid ($ExtInstrStr ($i; "UBW"); (DtUBW; NumElementsW; 1; SizeW; '.s'; Bits; "b" ))
    $modelid ($ExtInstrStr ($i; "UBD"); (DtUBD; NumElementsD; 1; SizeD; '.d'; Bits; "b" ))
    $modelid ($ExtInstrStr ($i; "SWD"); (DtSWD; NumElementsD; 4; SizeD; '.d'; SInt; "sw"))
    $modelid ($ExtInstrStr ($i; "UHH"); (DtUHH; NumElementsH; 2; SizeH; '.h'; Bits; "h" ))
    $modelid ($ExtInstrStr ($i; "UHW"); (DtUHW; NumElementsW; 2; SizeW; '.s'; Bits; "h" ))
    $modelid ($ExtInstrStr ($i; "UHD"); (DtUHD; NumElementsD; 2; SizeD; '.d'; Bits; "h" ))
    $modelid ($ExtInstrStr ($i; "SHD"); (DtSHD; NumElementsD; 2; SizeD; '.d'; SInt; "sh"))
    $modelid ($ExtInstrStr ($i; "SHW"); (DtSHW; NumElementsW; 2; SizeW; '.s'; SInt; "sh"))
    $modelid ($ExtInstrStr ($i; "UWW"); (DtUWW; NumElementsW; 4; SizeW; '.s'; Bits; "w" ))
    $modelid ($ExtInstrStr ($i; "UWD"); (DtUWD; NumElementsD; 4; SizeD; '.d'; Bits; "w" ))
    $modelid ($ExtInstrStr ($i; "SBD"); (DtSBD; NumElementsD; 1; SizeD; '.d'; SInt; "sb"))
    $modelid ($ExtInstrStr ($i; "SBW"); (DtSBW; NumElementsW; 1; SizeW; '.s'; SInt; "sb"))
    $modelid ($ExtInstrStr ($i; "SBH"); (DtSBH; NumElementsH; 1; SizeH; '.h'; SInt; "sb"))
    $modelid ($ExtInstrStr ($i; "UDD"); (DtUDD; NumElementsD; 8; SizeD; '.d'; Bits; "d" ))
    }

  model InstrMemST10 (modelid: InstrWithFunctMemSVE, i: InstrWithFunct): IsaDefs = {
    $modelid ($ExtInstrStr ($i; "BB"); (DtBB; NumElementsB; 1; SizeB; '.b'; Bits; "b" ))
    $modelid ($ExtInstrStr ($i; "BH"); (DtBH; NumElementsH; 1; SizeH; '.h'; Bits; "b" ))
    $modelid ($ExtInstrStr ($i; "BW"); (DtBW; NumElementsW; 1; SizeW; '.s'; Bits; "b" ))
    $modelid ($ExtInstrStr ($i; "BD"); (DtBD; NumElementsD; 1; SizeD; '.d'; Bits; "b" ))
    $modelid ($ExtInstrStr ($i; "HH"); (DtHH; NumElementsH; 2; SizeH; '.h'; Bits; "h" ))
    $modelid ($ExtInstrStr ($i; "HW"); (DtHW; NumElementsW; 2; SizeW; '.s'; Bits; "h" ))
    $modelid ($ExtInstrStr ($i; "HD"); (DtHD; NumElementsD; 2; SizeD; '.d'; Bits; "h" ))
    $modelid ($ExtInstrStr ($i; "WW"); (DtWW; NumElementsW; 4; SizeW; '.s'; Bits; "w" ))
    $modelid ($ExtInstrStr ($i; "WD"); (DtWD; NumElementsD; 4; SizeD; '.d'; Bits; "w" ))
    $modelid ($ExtInstrStr ($i; "DD"); (DtDD; NumElementsD; 8; SizeD; '.d'; Bits; "d" ))
    }

  model InstrMemX12 (modelid: InstrWithFunctMulMemSVE, i: InstrWithFunct): IsaDefs = {
    $modelid ($ExtInstrStr ($i; "2B"); (Dt2B; NumElementsB; X2; SizeB; '.b'; "2b" ))
    $modelid ($ExtInstrStr ($i; "2H"); (Dt2H; NumElementsH; X2; SizeH; '.h'; "2h" ))
    $modelid ($ExtInstrStr ($i; "2W"); (Dt2W; NumElementsW; X2; SizeW; '.s'; "2s" ))
    $modelid ($ExtInstrStr ($i; "2D"); (Dt2D; NumElementsD; X2; SizeD; '.d'; "2d" ))
    $modelid ($ExtInstrStr ($i; "3B"); (Dt3B; NumElementsB; X3; SizeB; '.b'; "3b" ))
    $modelid ($ExtInstrStr ($i; "3H"); (Dt3H; NumElementsH; X3; SizeH; '.h'; "3h" ))
    $modelid ($ExtInstrStr ($i; "3W"); (Dt3W; NumElementsW; X3; SizeW; '.s'; "3s" ))
    $modelid ($ExtInstrStr ($i; "3D"); (Dt3D; NumElementsD; X3; SizeD; '.d'; "3d" ))
    $modelid ($ExtInstrStr ($i; "4B"); (Dt4B; NumElementsB; X4; SizeB; '.b'; "4b" ))
    $modelid ($ExtInstrStr ($i; "4H"); (Dt4H; NumElementsH; X4; SizeH; '.h'; "4h" ))
    $modelid ($ExtInstrStr ($i; "4W"); (Dt4W; NumElementsW; X4; SizeW; '.s'; "4s" ))
    $modelid ($ExtInstrStr ($i; "4D"); (Dt4D; NumElementsD; X4; SizeD; '.d'; "4d" ))
  }

  model InstrBHSD (modelid: InstrWithFunctElemSizeType, i: InstrWithFunct): IsaDefs = {
    $modelid ($ExtInstrStr ($i; "B"); NumElementsB; SizeB; ".b")
    $modelid ($ExtInstrStr ($i; "H"); NumElementsH; SizeH; ".h")
    $modelid ($ExtInstrStr ($i; "S"); NumElementsS; SizeS; ".s")
    $modelid ($ExtInstrStr ($i; "D"); NumElementsD; SizeD; ".d")
    }

  model InstrB (modelid: InstrWithFunctElemSizeType, i: InstrWithFunct): IsaDefs = {
    $modelid ($ExtInstrStr ($i; "B"); NumElementsB; SizeB; ".b")
  }

  model InstrSD (modelid: InstrWithFunctElemSizeType, i: InstrWithFunct): IsaDefs = {
    $modelid ($ExtInstrStr ($i; "S"); NumElementsS; SizeS; ".s")
    $modelid ($ExtInstrStr ($i; "D"); NumElementsD; SizeD; ".d")
    }


// common sve and sme instructions *********************************************

  $InstrBHSD        (SVEArithmeticPredInstr    ; (SVEpredADD    ; "add"   ; 0b0000'0000      ; add      ))
  $InstrBHSD        (SVEArithmeticPredInstr    ; (SVEpredSUB    ; "sub"   ; 0b0000'1000      ; sub      ))
  $InstrBHSD        (SVEArithmeticPredInstr    ; (SVEpredMUL    ; "mul"   ; 0b1000'0000      ; mul      ))
  $InstrSD          (SVEArithmeticPredInstr    ; (SVEpredSDIV   ; "sdiv"  ; 0b1010'0000      ; sdiv     ))
  $InstrSD          (SVEArithmeticPredInstr    ; (SVEpredUDIV   ; "udiv"  ; 0b1010'1000      ; udiv     ))

  $InstrBHSD        (SVEArithmeticUnprInstr    ; (SVEunprADD    ; "add"   ; 0b000'000        ; add      ))
  $InstrBHSD        (SVEArithmeticUnprInstr    ; (SVEunprSUB    ; "sub"   ; 0b000'001        ; sub      ))
  $InstrBHSD        (SVEArithmeticUnprInstr    ; (SVEunprMUL    ; "mul"   ; 0b011'000        ; mul      ))

// Fold is not yet supported by the ISS generator
//   $InstrBHSD        (SVEAddExtReductionInstr   ; (SVEfoldSADD   ; "saddv" ; 0b0'0000'0001    ; SIntX    ))
//   $InstrBHSD        (SVEAddExtReductionInstr   ; (SVEfoldUADD   ; "uaddv" ; 0b0'0000'1001    ; UIntX    ))
//   $InstrBHSD        (SVEReductionInstr         ; (SVEfoldAND    ; "andv"  ; 0b0'1101'0001    ; and      ))
//   $InstrBHSD        (SVEReductionInstr         ; (SVEfoldOR     ; "orv"   ; 0b0'1100'0001    ; or       ))
//   $InstrBHSD        (SVEReductionInstr         ; (SVEfoldXOR    ; "eorv"  ; 0b0'1100'1001    ; xor      ))

  $SIMDMoveInstr    (                            (SIMDUMOV      ; "umov"  ; 0b00'1111                   ))

  $SVEAddVLInstr    (                            (SVEADDVL      ; "addvl" ; 0b0'1010                    ))
  $SVEIncrInstr     (                            (SVEINC        ; "inc"   ; 0b111'000        ; inc      ))

  $InstrBHSD        (SVEPTrueInstr             ; (SVEPTRUE      ; "ptrue" ; 0b1110'000       ; OffFlags ))
  $InstrBHSD        (SVEPTrueInstr             ; (SVEPTRUES     ; "ptrues"; 0b1110'000       ; SetFlags ))
  $SVEPFalseInstr   (                            (SVEPFALSE     ; "pfalse"; 0b1110'010       ; OffFlags ))

  $SVEPredLogicInstr(                            (SVEPAND       ; "and"   ; 0b0'0100         ; predAnd  ))
  $SVEPredLogicInstr(                            (SVEPBIC       ; "bic"   ; 0b0'0101         ; predBic  ))
  $SVEPredLogicInstr(                            (SVEPXOR       ; "eor"   ; 0b0'0110         ; predXor  ))
  $SVEPredLogicInstr(                            (SVEPNAND      ; "nand"  ; 0b1'0111         ; predNand ))
  $SVEPredLogicInstr(                            (SVEPNOR       ; "nor"   ; 0b1'0110         ; predNor  ))
  $SVEPredLogicInstr(                            (SVEPORN       ; "orn"   ; 0b1'0101         ; predOrn  ))
  $SVEPredLogicInstr(                            (SVEPOR        ; "orr"   ; 0b1'0100         ; predOr   ))
  $SVEPredLogicOffFl(                            (SVEPSEL       ; "sel"   ; 0b0'0111         ; predSel  ))
  $SVEPredTestInstr (                            (SVEPTEST      ; "ptest" ; 0b0'1100         ; unused   ))

  $InstrB           (SVEPredFirstInstr         ; (SVEPFIRST     ; "pfirst"; 0b1000'1100'0000 ; unused   ))
  $InstrBHSD        (SVEPredNextInstr          ; (SVEPNEXT      ; "pnext" ; 0b1001'1100'0100 ; unused   ))
  $InstrBHSD        (SVEPredCountInstr         ; (SVECOUNTP     ; "cntp"  ; 0b0001'00        ; unused   ))
  $InstrBHSD        (SVEPredIncCountInstr      ; (SVEINCTP      ; "incp"  ; 0b1001'00        ; unused   ))
  $InstrBHSD        (SVEWhileXWInstr           ; (SVEWHILE      ; "while" ; 0b000            ; unused   ))

  $SVELoadPredInstr (                            (SVELDRPrd     ; "ldr"   ; 0b100'001'0110   ; unused   ))
  $SVEStorePredInstr(                            (SVESRRPrd     ; "str"   ; 0b111'001'0110   ; unused   ))
  $SVELoadVectInstr (                            (SVELDRVec     ; "ldr"   ; 0b100'001'0110   ; unused   ))
  $SVEStoreVectInstr(                            (SVESRRVec     ; "str"   ; 0b111'001'0110   ; unused   ))

  $InstrMemLD16     (SVELoadScalarImmInstr     ; (SVEimmLD1     ; "ld1"   ; 0b101            ; unused   ))
  $InstrMemST10     (SVEStoreScalarImmInstr    ; (SVEimmST1     ; "st1"   ; 0b111            ; unused   ))
  $InstrMemLD16     (SVELoadScalarScalarInstr  ; (SVEsclLD1     ; "ld1"   ; 0b010            ; unused   ))
  $InstrMemST10     (SVEStoreScalarScalarInstr ; (SVEsclST1     ; "st1"   ; 0b010            ; unused   ))
  $InstrMemX12      (SVELoadMulScalarImmInstr  ; (SVEimmLD      ; "ld"    ; 0b101'0010'0     ; unused   ))
  $InstrMemX12      (SVEStoreMulScalarImmInstr ; (SVEimmST      ; "st"    ; 0b111'0010'1     ; unused   ))
  $InstrMemX12      (SVELoadMulScalarSclInstr  ; (SVEsclLD      ; "ld"    ; 0b101'0010       ; unused   ))
  $InstrMemX12      (SVEStoreMulScalarSclInstr ; (SVEsclST      ; "st"    ; 0b111'0010       ; unused   ))

}
