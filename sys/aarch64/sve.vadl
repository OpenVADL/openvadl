import aarch64::AArch64Base

instruction set architecture AArch64SVEandSME extending AArch64Base = {

  constant VL        = 128              // vector length, number of bits in a vector register
  constant PL        = VL >> 3          // predicate length, number of elements in a predicate register
  constant ElementsB = VL >> 3          // number of byte   sized elements in a vector register
  constant ElementsH = VL >> 4          // number of half   sized elements in a vector register
  constant ElementsS = VL >> 5          // number of single sized elements in a vector register
  constant ElementsW = VL >> 5          // number of single sized elements in a vector register
  constant ElementsD = VL >> 6          // number of double sized elements in a vector register
  constant Log2ElemB = 11               // number of bits required for the biggest element index
  constant NumZ = 32                    // number of vector registers in register file

  using IndexP = Bits4                  // index type for the 16 predicate register file
  using IndexE = Bits<Log2ElemB>        // the biggest index type for element indices
  using BitsZ  = Bits<VL>               // Bits type for vector register file
  using BitsP  = Bits<PL><1>            // Boolean type for predicate register file
  using BitsZB = Bits<ElementsB>< 8>    // byte   vector register file
  using BitsZH = Bits<ElementsH><16>    // half   vector register file
  using BitsZS = Bits<ElementsS><32>    // single vector register file
  using BitsZD = Bits<ElementsD><64>    // double vector register file
  using BitsB  = Byte                   // 8 bit Byte
  using BitsH  = Half                   // 16 bit half word type
  using BitsD  = BitsX                  // 64 bit double word type

  register   P : IndexP -> BitsP        // predicate register file
  register FFR :           BitsP        // first fault register, predicate register
                                        // which is set for first memory access operation
  register   Z : Index  -> BitsZ        // vector    register file
  alias register ZB : BitsZB<NumZ> = Z  // byte   vector register file
  alias register ZH : BitsZH<NumZ> = Z  // half   vector register file
  alias register ZS : BitsZS<NumZ> = Z  // single vector register file
  alias register ZD : BitsZD<NumZ> = Z  // double vector register file

  enumeration ElSize =                  // element size encoding, do not reorder
    { SizeB                             // byte   size
    , SizeH                             // half   size
    , SizeS                             // single size
    , SizeD                             // double size
    , SizeW = 2                         // word   size
    }

  // higher order model enriched with operation size
  model-type InstrWithFunctElemSizeType = (InstrWithFunct, Id, Id, Str) -> IsaDefs

  model ExtInstrIdMnemo (i: InstrWithFunct, ext: Str): InstrWithFunct = {
    (AsId ($i.id, $ext); AsStr($i.mnemo, ".", $ext); $i.opcode; $i.funct)
    }

  model BHSDReg (size: Id): Id = {
    match: Id ($size = SizeB => ZB ; $size = SizeH => ZH ; $size = SizeS => ZS ; _ => ZD)
  }

  model BitsBHSD (size: Id): Id = {
    match: Id ($size = SizeB => BitsZB ; $size = SizeH => BitsZH ; $size = SizeS => BitsZS ; _ => BitsZD)
  }


// SVE arithmetic predicated models ********************************************

  format SVEArithmeticPredFormat: Instr =  // arithmetic unpredicated SVE format
    { op       [31..24,21] : Bits9         // opcode
    , size     [23..22]    : Bits2         // elements operation size
    , opc      [20..13]    : Bits8         // opcode second part
    , pg       [12..10]    : Bits3         // predicate register
    , zm       [9..5]      : Index         // 2st source register
    , zdn      [4..0]      : Index         // 1st source and destination register
    }

  model SVEArithmeticPredInstr (i: InstrWithFunct, elements: Id, size: Id, extReg: Str): IsaDefs = {
    instruction $i.id: SVEArithmeticPredFormat =
      let pred  = P(pg) in
      let left  = Z(zdn) as $BitsBHSD($size) in
      let right = Z(zm)  as $BitsBHSD($size) in 
        Z(zdn) := forall i : IndexE in 0..$elements-1
                    tensor if pred(i << ElSize::$size)
                      then VADL::$i.funct (left(i), right(i))
                      else left(i)
    encoding $i.id = { op = 0b0000'0100'0, opc = $i.opcode, size = ElSize::$size }
    assembly $i.id = ( $i.mnemo, ' ', register(zdn), $extReg, ', ', register(pg), '/M, ', register(zdn), $extReg, ', ', register(zm), $extReg )
    }

// SVE arithmetic unpredicated models ******************************************

  format SVEArithmeticUnprFormat: Instr =  // arithmetic unpredicated SVE format
    { op       [31..24,21] : Bits9         // opcode
    , size     [23..22]    : Bits2         // elements operation size
    , zm       [20..16]    : Index         // 2nd source register
    , opc      [15..10]    : Bits6         // opcode second part
    , zn       [9..5]      : Index         // 1st source register
    , zd       [4..0]      : Index         // destination register
    }

  model SVEArithmeticUnprInstr (i: InstrWithFunct, elements: Id, size: Id, extReg: Str): IsaDefs = {
    instruction $i.id: SVEArithmeticUnprFormat =
      let left  = Z(zn) as $BitsBHSD($size) in
      let right = Z(zm) as $BitsBHSD($size) in 
        Z(zd) := forall i : IndexE in 0..$elements-1
                   tensor VADL::$i.funct (left(i), right(i))
    encoding $i.id = { op = 0b0000'0100'1, opc = $i.opcode, size = ElSize::$size }
    assembly $i.id = ( $i.mnemo, ' ', register(zd), $extReg, ', ', register(zn), $extReg, ', ', register(zm), $extReg )
    }

// SVE load scalar immediate single register models ****************************

  enumeration LDDtype : Bits<4> =          // load data type, memory and element size and type
    { DtUBB = 0b0000                       // unsigned load memory byte, element byte
    , DtUBH = 0b0001                       // unsigned load memory byte, element half
    , DtUBW = 0b0010                       // unsigned load memory byte, element word
    , DtUBD = 0b0011                       // unsigned load memory byte, element double
    , DtSWD = 0b0100                       //   signed load memory word, element double
    , DtUHH = 0b0101                       // unsigned load memory half, element half
    , DtUHW = 0b0110                       // unsigned load memory half, element word
    , DtUHD = 0b0111                       // unsigned load memory half, element double
    , DtSHD = 0b1000                       //   signed load memory half, element double
    , DtSHW = 0b1001                       //   signed load memory half, element word
    , DtUWW = 0b1010                       // unsigned load memory word, element word
    , DtUWD = 0b1011                       // unsigned load memory word, element double
    , DtSBD = 0b1100                       //   signed load memory byte, element double
    , DtSBW = 0b1101                       //   signed load memory byte, element word
    , DtSBH = 0b1110                       //   signed load memory byte, element half
    , DtUDD = 0b1111                       // unsigned load memory double, element double
    }

  format SVEMemScalarImmOneFormat: Instr = // arithmetic unpredicated SVE format
    { op       [31..25]        : Bits7     // opcode
    , dtype    [24..21]        : Bits4     // memory and element size adn type (LDDtype)
    , opc      [20,15..13]     : Bits4     // opcode second part
    , imm4     [19..16]        : Bits4     // signed scaled immediate offset
    , pg       [12..10]        : Bits3     // predicate register
    , rn       [9..5]          : Index     // base address X/SP register
    , zt       [4..0]          : Index     // destination Z register
    , offset = imm4 as SIntX
    }

  model SVELoadScalarImmOneInstr (i: InstrWithFunct, dtype: Id, elements: Id, memBytes: Int, elsize: Id, elStr: Str, eltype: Id, extStr: Str): IsaDefs = {
    instruction $i.id: SVEMemScalarImmOneFormat =
      let base = S(rn) + offset * $elements * $memBytes in
      let pred  = P(pg) in
        Z(zt) := forall i : SIntX in 0..$elements-1 tensor
          if pred(i << ElSize::$elsize)
            then MEM<$memBytes>(base + i * $memBytes) as $eltype<(8 << ElSize::$elsize)>
            else 0
    encoding $i.id = { op = 0b101'0010, opc = $i.opcode, dtype = LDDtype::$dtype }
    assembly $i.id = ( AsStr($i.mnemo, $extStr), ' ', register(zt), $elStr, ', ', register(pg), '/Z, ', XSizeSP(rn), ', #', sdec(imm4))
    }

// instruction enriching models ************************************************

  model-type InstrWithFunctLdType = (InstrWithFunct, Id, Id, Int, Id, Str, Id, Str) -> IsaDefs

  model InstrMemLD16 (modelid: InstrWithFunctLdType, i: InstrWithFunct): IsaDefs = {
    $modelid ($ExtInstrStr ($i; "UBB"); DtUBB; ElementsB; 1; SizeB; '.b'; Bits; "b" )
    $modelid ($ExtInstrStr ($i; "UBH"); DtUBH; ElementsH; 1; SizeH; '.h'; Bits; "b" )
    $modelid ($ExtInstrStr ($i; "UBW"); DtUBW; ElementsW; 1; SizeW; '.s'; Bits; "b" )
    $modelid ($ExtInstrStr ($i; "UBD"); DtUBD; ElementsD; 1; SizeD; '.d'; Bits; "b" )
    $modelid ($ExtInstrStr ($i; "SWD"); DtSWD; ElementsD; 4; SizeD; '.d'; SInt; "sw")
    $modelid ($ExtInstrStr ($i; "UHH"); DtUHH; ElementsH; 2; SizeH; '.h'; Bits; "h" )
    $modelid ($ExtInstrStr ($i; "UHW"); DtUHW; ElementsW; 2; SizeW; '.s'; Bits; "h" )
    $modelid ($ExtInstrStr ($i; "UHD"); DtUHD; ElementsD; 2; SizeD; '.d'; Bits; "h" )
    $modelid ($ExtInstrStr ($i; "SHD"); DtSHD; ElementsD; 2; SizeD; '.d'; SInt; "sh")
    $modelid ($ExtInstrStr ($i; "SHW"); DtSHW; ElementsW; 2; SizeW; '.s'; SInt; "sh")
    $modelid ($ExtInstrStr ($i; "UWW"); DtUWW; ElementsW; 4; SizeW; '.s'; Bits; "w" )
    $modelid ($ExtInstrStr ($i; "UWD"); DtUWD; ElementsD; 4; SizeD; '.d'; Bits; "w" )
    $modelid ($ExtInstrStr ($i; "SBD"); DtSBD; ElementsD; 1; SizeD; '.d'; SInt; "sb")
    $modelid ($ExtInstrStr ($i; "SBW"); DtSBW; ElementsW; 1; SizeW; '.s'; SInt; "sb")
    $modelid ($ExtInstrStr ($i; "SBH"); DtSBH; ElementsH; 1; SizeH; '.h'; SInt; "sb")
    $modelid ($ExtInstrStr ($i; "UDD"); DtUDD; ElementsD; 8; SizeD; '.d'; Bits; "d" )
    }

  model InstrBHSD (modelid: InstrWithFunctElemSizeType, i: InstrWithFunct): IsaDefs = {
    $modelid ($ExtInstrStr ($i; "B"); ElementsB; SizeB; ".b")
    $modelid ($ExtInstrStr ($i; "H"); ElementsH; SizeH; ".h")
    $modelid ($ExtInstrStr ($i; "S"); ElementsS; SizeS; ".s")
    $modelid ($ExtInstrStr ($i; "D"); ElementsD; SizeD; ".d")
    }

  model InstrSD (modelid: InstrWithFunctElemSizeType, i: InstrWithFunct): IsaDefs = {
    $modelid ($ExtInstrStr ($i; "S"); ElementsS; SizeS; ".s")
    $modelid ($ExtInstrStr ($i; "D"); ElementsD; SizeD; ".d")
    }


// sve instructions ************************************************************

  $InstrBHSD         (SVEArithmeticPredInstr   ; (SVEpredADD    ; "add"   ; 0b0000'0000      ; add      ))
  $InstrBHSD         (SVEArithmeticPredInstr   ; (SVEpredSUB    ; "sub"   ; 0b0000'1000      ; sub      ))
  $InstrBHSD         (SVEArithmeticPredInstr   ; (SVEpredMUL    ; "mul"   ; 0b1000'0000      ; mul      ))
  $InstrSD           (SVEArithmeticPredInstr   ; (SVEpredSDIV   ; "sdiv"  ; 0b1010'0000      ; sdiv     ))
  $InstrSD           (SVEArithmeticPredInstr   ; (SVEpredUDIV   ; "udiv"  ; 0b1010'1000      ; udiv     ))

  $InstrBHSD         (SVEArithmeticUnprInstr   ; (SVEunprADD    ; "add"   ; 0b000'000        ; add      ))
  $InstrBHSD         (SVEArithmeticUnprInstr   ; (SVEunprSUB    ; "sub"   ; 0b000'001        ; sub      ))
  $InstrBHSD         (SVEArithmeticUnprInstr   ; (SVEunprMUL    ; "mul"   ; 0b011'000        ; mul      ))

  $InstrMemLD16      (SVELoadScalarImmOneInstr ; (SVEimmOneLD1  ; "ld1"   ; 0b0'101          ; unused   ))

}
