import aarch64::AArch64Base

instruction set architecture AArch64SVEandSME extending AArch64Base = {

  constant VL        = 128              // vector length, number of bits in a vector register
  constant PL        = VL >> 3          // predicate length, number of elements in a predicate register
  constant ElementsB = VL >> 3          // number of byte   sized elements in a vector register
  constant ElementsH = VL >> 4          // number of half   sized elements in a vector register
  constant ElementsS = VL >> 5          // number of single sized elements in a vector register
  constant ElementsW = VL >> 5          // number of single sized elements in a vector register
  constant ElementsD = VL >> 6          // number of double sized elements in a vector register

  constant PTrueB = 0b1111'1111'1111'1111
  constant PTrueH = 0b0101'0101'0101'0101
  constant PTrueS = 0b0001'0001'0001'0001
  constant PTrueD = 0b0000'0001'0000'0001
  constant PFalse = 0b0000'0000'0000'0000

  constant LastActiveB = ElementsB - 1
  constant LastActiveH = ElementsB - 2
  constant LastActiveS = ElementsB - 4
  constant LastActiveD = ElementsB - 8

  constant Log2ElemB = 8                // number of bits required for the biggest element index
  constant NumZ = 32                    // number of vector registers in register file

  using IndexP = Bits4                  // index type for the 16 predicate register file
  using IndexE = Bits<Log2ElemB>        // the biggest index type for element indices
  using BitsZ  = Bits<VL>               // Bits type for vector register file
  using BitsP  = Bits<PL><1>            // Boolean type for predicate register file
  using BitsZB = Bits<ElementsB>< 8>    // byte   vector register file
  using BitsZH = Bits<ElementsH><16>    // half   vector register file
  using BitsZS = Bits<ElementsS><32>    // single vector register file
  using BitsZD = Bits<ElementsD><64>    // double vector register file
  using BitsB  = Byte                   // 8 bit Byte
  using BitsH  = Half                   // 16 bit half word type
  using BitsD  = BitsX                  // 64 bit double word type

  register   P : IndexP -> BitsP        // predicate register file
  register FFR :           BitsP        // first fault register, predicate register
                                        // which is set for first memory access operation
  register   Z : Index  -> BitsZ        // vector    register file
  alias register ZB : BitsZB<NumZ> = Z  // byte   vector register file
  alias register ZH : BitsZH<NumZ> = Z  // half   vector register file
  alias register ZS : BitsZS<NumZ> = Z  // single vector register file
  alias register ZD : BitsZD<NumZ> = Z  // double vector register file

  enumeration ElSize =                  // element size encoding, do not reorder
    { SizeB                             // byte   size
    , SizeH                             // half   size
    , SizeS                             // single size
    , SizeD                             // double size
    , SizeW = 2                         // word   size
    }

  // higher order model enriched with operation size
  model-type InstrWithFunctElemSizeType = (InstrWithFunct, Id, Id, Str) -> IsaDefs

  model ExtInstrIdMnemo (i: InstrWithFunct, ext: Str): InstrWithFunct = {
    (AsId ($i.id, $ext); AsStr($i.mnemo, ".", $ext); $i.opcode; $i.funct)
    }

  model BHSDReg (size: Id): Id = {
    match: Id ($size = SizeB => ZB ; $size = SizeH => ZH ; $size = SizeD => ZD ; _ => ZS)
  }

  model BitsBHSD (size: Id): Id = {
    match: Id ($size = SizeB => BitsZB ; $size = SizeH => BitsZH ; $size = SizeD => BitsZD ; _ => BitsZS)
  }

  model PtrueBHSD (size: Id): Id = {
    match: Id ($size = SizeB => PTrueB ; $size = SizeH => PTrueH ; $size = SizeD => PTrueD ; _ => PTrueS)
  }

  model LastActiveBHSD (size: Id): Id = {
    match: Id ($size = SizeB => LastActiveB ; $size = SizeH => LastActiveH ; $size = SizeD => LastActiveD ; _ => LastActiveS)
  }

// SVE arithmetic predicated models ********************************************

  format SVEArithmeticPredFormat: Instr =  // arithmetic unpredicated SVE format
    { op       [31..24,21] : Bits9         // opcode
    , size     [23..22]    : Bits2         // elements size (ElSize)
    , opc      [20..13]    : Bits8         // opcode second part
    , pg       [12..10]    : Bits3         // predicate register
    , zm       [9..5]      : Index         // 2st source register
    , zdn      [4..0]      : Index         // 1st source and destination register
    }

  model SVEArithmeticPredInstr (i: InstrWithFunct, elements: Id, size: Id, extReg: Str): IsaDefs = {
    instruction $i.id: SVEArithmeticPredFormat =
      let pred  = P(pg) in
      let left  = Z(zdn) as $BitsBHSD($size) in
      let right = Z(zm)  as $BitsBHSD($size) in 
        Z(zdn) := forall i : IndexE in 0..$elements-1
                    tensor if pred(i << ElSize::$size)
                      then VADL::$i.funct (left(i), right(i))
                      else left(i)
    encoding $i.id = { op = 0b0000'0100'0, opc = $i.opcode, size = ElSize::$size }
    assembly $i.id = ( $i.mnemo, ' ', register(zdn), $extReg, ', ', register(pg), '/m, ', register(zdn), $extReg, ', ', register(zm), $extReg )
    }

// SVE arithmetic unpredicated models ******************************************

  format SVEArithmeticUnprFormat: Instr =  // arithmetic unpredicated SVE format
    { op       [31..24,21] : Bits9         // opcode
    , size     [23..22]    : Bits2         // elements size (ElSize)
    , zm       [20..16]    : Index         // 2nd source register
    , opc      [15..10]    : Bits6         // opcode second part
    , zn       [9..5]      : Index         // 1st source register
    , zd       [4..0]      : Index         // destination register
    }

  model SVEArithmeticUnprInstr (i: InstrWithFunct, elements: Id, size: Id, extReg: Str): IsaDefs = {
    instruction $i.id: SVEArithmeticUnprFormat =
      let left  = Z(zn) as $BitsBHSD($size) in
      let right = Z(zm) as $BitsBHSD($size) in 
        Z(zd) := forall i : IndexE in 0..$elements-1
                   tensor VADL::$i.funct (left(i), right(i))
    encoding $i.id = { op = 0b0000'0100'1, opc = $i.opcode, size = ElSize::$size }
    assembly $i.id = ( $i.mnemo, ' ', register(zd), $extReg, ', ', register(zn), $extReg, ', ', register(zm), $extReg )
    }

// SVE increment models ********************************************************

  function DecodePredCount(pattern: Bits5, size: Bits2) -> BitsX =
    let elements = VL as BitsX >> (3+size) in
      match pattern with
        { 0b00000 => elements // elements is always a power of 2
        , 0b00001 => if elements >=   1 then   1 as BitsX else 0
        , 0b00010 => if elements >=   2 then   2 as BitsX else 0
        , 0b00011 => if elements >=   3 then   3 as BitsX else 0
        , 0b00100 => if elements >=   4 then   4 as BitsX else 0
        , 0b00101 => if elements >=   5 then   5 as BitsX else 0
        , 0b00110 => if elements >=   6 then   6 as BitsX else 0
        , 0b00111 => if elements >=   7 then   7 as BitsX else 0
        , 0b01000 => if elements >=   8 then   8 as BitsX else 0
        , 0b01001 => if elements >=  16 then  16 as BitsX else 0
        , 0b01010 => if elements >=  32 then  32 as BitsX else 0
        , 0b01011 => if elements >=  64 then  64 as BitsX else 0
        , 0b01100 => if elements >= 128 then 128 as BitsX else 0
        , 0b01101 => if elements >= 256 then 256 as BitsX else 0
        , 0b11101 => elements - elements % 4
        , 0b11110 => elements - elements % 3
        , 0b11111 => elements
        , _       => 0
        }

  format SVEIncrementFormat: Instr =       // SVE increment format
    { op       [31..24,21..20] : Bits10    // opcode
    , size     [23..22]        : Bits2     // elements size (ElSize)
    , imm4     [19..16]        : Bits4     // unsigned multiplier
    , opc      [15..10]        : Bits6     // opcode second part
    , pattern  [9..5]          : Bits5     // pattern
    , dn       [4..0]          : Index     // source and destination register
    , imm      = imm4 as BitsX + 1
    , countB   = DecodePredCount(pattern, ElSize::SizeB)
    , countH   = DecodePredCount(pattern, ElSize::SizeH)
    , countW   = DecodePredCount(pattern, ElSize::SizeW)
    , countD   = DecodePredCount(pattern, ElSize::SizeD)
    }

  model SVEIncrementBase (id: Id, mnemo: Str, count: Id, size: Id): IsaDefs = {
    instruction $id: SVEIncrementFormat =
      X(dn) := X(dn) + $count * imm
    encoding $id = { op = 0b0000'0100'1, opc = 0b111000, size = ElSize::$size }
    assembly $id = ( $mnemo, ' ', register(dn), ', all, mul #', udec(imm) )
    }

  model SVEIncrInstr (i: InstrWithFunct): IsaDefs = {
    $SVEIncrementBase (SVEINCB; "incb"; countB; SizeB)
    $SVEIncrementBase (SVEINCH; "inch"; countH; SizeH)
    $SVEIncrementBase (SVEINCW; "incw"; countW; SizeW)
    $SVEIncrementBase (SVEINCD; "incd"; countD; SizeD)
    }

// SVE while models ************************************************************

  constant MaxUIntX : UIntX = 0xffff'ffff'ffff'ffff
  constant MaxSIntX : SIntX = 0x7fff'ffff'ffff'ffff
  constant MaxUIntW : UIntW = 0xffff'ffff
  constant MaxSIntW : SIntW = 0x7fff'ffff
  constant MinUIntX : UIntX = 0x0000'0000'0000'0000
  constant MinSIntX : SIntX = 0x8000'0000'0000'0000
  constant MinUIntW : UIntW = 0x0000'0000
  constant MinSIntW : SIntW = 0x8000'0000

  model UMax (size: Id): Id = {
    match: Id ($size = WSize => MaxUIntW ; _ => MaxUIntX)
  }

  model SMax (size: Id): Id = {
    match: Id ($size = WSize => MaxSIntW ; _ => MaxSIntX)
  }

  model UMin (size: Id): Id = {
    match: Id ($size = WSize => MinUIntW ; _ => MinUIntX)
  }

  model SMin (size: Id): Id = {
    match: Id ($size = WSize => MinSIntW ; _ => MinSIntX)
  }

  enumeration CondSVE : Bits<3> =          // SVE condition code encodings
    { GE = 0b000                           // Greater or Equal signed   U == 0   LT == 0   EQ == 0
    , GT = 0b001                           // Greater Than     signed   U == 0   LT == 0   EQ == 1
    , LT = 0b010                           // Less Than        signed   U == 0   LT == 1   EQ == 0
    , LE = 0b011                           // Less or Equal    signed   U == 0   LT == 1   EQ == 1
    , HS = 0b100                           // Higer or Same  unsigned   U == 1   LT == 0   EQ == 0
    , HI = 0b101                           // HIgher         unsigned   U == 1   LT == 0   EQ == 1
    , LO = 0b110                           // LOwer than     unsigned   U == 1   LT == 1   EQ == 0
    , LS = 0b111                           // Lower or Same  unsigned   U == 1   LT == 1   EQ == 1
    }

  format SVEWhileFormat: Instr =           // SVE while predicate format
    { op       [31..24,21]     : Bits9     // opcode
    , size     [23..22]        : Bits2     // elements size (ElSize)
    , rm       [20..16]        : Index     // 2nd source counter register
    , opc      [15..13]        : Bits3     // opcode second part
    , sf       [12]            : Bits1     // size field (enum SF), if (sf = 0) 32 bit operation else 64 bit
    , cond     [11,10,4]       : Bits3     // condition (enum CondSVE)
    , rn       [9..5]          : Index     // 1st source counter register
    , pd       [3..0]          : IndexP    // destination predicate register
    }

  record WhileRec  (cond: Id, max: Id, ptrue: Id, notcmp: Id, elements: Id, elSize: Id, elStr: Str)

  model WXR (size: Id): Id = {
    match: Id ($size = WSize => W ; _ => X)
  }

  model SetFlagsSVE (lastActive: Id) : Stats = {
        P(pd)  := pred as BitsP
        NZCV_N := pred(0)
        NZCV_Z := pred = 0
        NZCV_C := pred($lastActive) = 0
        NZCV_V := false
  }
  model WhileStatLSLE (w: WhileRec, regSize: Id): Stat = {
    let left  = $WXR($regSize)(rn) in
    let right = $WXR($regSize)(rm) in
    let pred  = 
      if right = $w.max
        then $w.ptrue
        else
        if VADL::$w.notcmp(left, right)
        then PFalse
        else let diff = (right - left) as IndexE in
          if diff >= $w.elements
          then $w.ptrue
          else let shift = ($w.elements as IndexE - diff) * (1 + ElSize::$w.elSize) in
            $w.ptrue as Bits<PL> << shift
      in { $SetFlagsSVE($LastActiveBHSD($w.elSize)) }
  }

  model WhileStatLOLT (w: WhileRec, regSize: Id): Stat = {
    let left  = $WXR($regSize)(rn) in
    let right = $WXR($regSize)(rm) in
    let pred  = 
      //if right = $w.max
      //  then $w.ptrue
      //  else
        if VADL::$w.notcmp(left, right)
        then PFalse
        else let diff = (right - left) as IndexE in
          if diff >= $w.elements
          then $w.ptrue
          else let shift = ($w.elements as IndexE - diff) * (1 + ElSize::$w.elSize) in
            $w.ptrue as Bits<PL> << shift
      in { $SetFlagsSVE($LastActiveBHSD($w.elSize)) }
  }

    model WhileStatHSGE (w: WhileRec, regSize: Id): Stat = {
    let left  = $WXR($regSize)(rn) in
    let right = $WXR($regSize)(rm) in
    let pred  = 
      if right = $w.max
        then $w.ptrue
        else
        if VADL::$w.notcmp(left, right)
        then PFalse
        else let diff = (right - left) as IndexE in
          if diff >= $w.elements
          then $w.ptrue
          else let shift = ($w.elements as IndexE - diff) * (1 + ElSize::$w.elSize) in
            $w.ptrue as Bits<PL> >> shift
      in { $SetFlagsSVE($LastActiveBHSD($w.elSize)) }
  }

    model WhileStatHIGT (w: WhileRec, regSize: Id): Stat = {
    let left  = $WXR($regSize)(rn) in
    let right = $WXR($regSize)(rm) in
    let pred  = 
      //if right = $w.max
      //  then $w.ptrue
      //  else
        if VADL::$w.notcmp(left, right)
        then PFalse
        else let diff = (right - left) as IndexE in
          if diff >= $w.elements
          then $w.ptrue
          else let shift = ($w.elements as IndexE - diff) * (1 + ElSize::$w.elSize) in
            $w.ptrue as Bits<PL> >> shift
      in { $SetFlagsSVE($LastActiveBHSD($w.elSize)) }
  }

model-type SVEWhileStatModel = (WhileRec, Id) -> Stat

  model SVEWhileBaseInstr (m: SVEWhileStatModel, i: InstrWithFunct, w: WhileRec, regSize: Id): IsaDefs = {
    instruction $i.id: SVEWhileFormat = $m ($w ; $regSize)
    encoding $i.id = { op = 0b0010'0101'1, opc = $i.opcode, size = ElSize::$w.elSize, sf = SF::$regSize, cond = CondSVE::$w.cond }
    assembly $i.id = ( $i.mnemo, ' ', register(pd), $w.elStr, ', ', $regSize(rn), ', ', $regSize(rm))
    }

  model ExtInstrIdStr (i: InstrWithFunct, id: Id, mnemo: Str): InstrWithFunct = {
    (AsId ($i.id, $id); AsStr ($i.mnemo, $mnemo); $i.opcode; $i.funct)
    }

  model SVEWhileCondInstr (i: InstrWithFunct, regSize: Id, elements: Id, elSize: Id, elStr: Str): IsaDefs = {
    $SVEWhileBaseInstr (WhileStatLSLE ; $ExtInstrIdStr($i ; LS ; "ls"); (LS ; $UMax($regSize) ; $PtrueBHSD($elSize) ; ugth ; $elements ; $elSize ; $elStr) ; $regSize)
    $SVEWhileBaseInstr (WhileStatLSLE ; $ExtInstrIdStr($i ; LE ; "le"); (LE ; $SMax($regSize) ; $PtrueBHSD($elSize) ; sgth ; $elements ; $elSize ; $elStr) ; $regSize)
    $SVEWhileBaseInstr (WhileStatLOLT ; $ExtInstrIdStr($i ; LO ; "lo"); (LO ; Unused          ; $PtrueBHSD($elSize) ; ugeq ; $elements ; $elSize ; $elStr) ; $regSize)
    $SVEWhileBaseInstr (WhileStatLOLT ; $ExtInstrIdStr($i ; LT ; "lt"); (LT ; Unused          ; $PtrueBHSD($elSize) ; sgeq ; $elements ; $elSize ; $elStr) ; $regSize)
    $SVEWhileBaseInstr (WhileStatHSGE ; $ExtInstrIdStr($i ; HS ; "hs"); (HS ; $UMin($regSize) ; $PtrueBHSD($elSize) ; ulth ; $elements ; $elSize ; $elStr) ; $regSize)
    $SVEWhileBaseInstr (WhileStatHSGE ; $ExtInstrIdStr($i ; GE ; "ge"); (GE ; $SMin($regSize) ; $PtrueBHSD($elSize) ; slth ; $elements ; $elSize ; $elStr) ; $regSize)
    $SVEWhileBaseInstr (WhileStatHIGT ; $ExtInstrIdStr($i ; HI ; "hi"); (HI ; Unused          ; $PtrueBHSD($elSize) ; uleq ; $elements ; $elSize ; $elStr) ; $regSize)
    $SVEWhileBaseInstr (WhileStatHIGT ; $ExtInstrIdStr($i ; GT ; "gt"); (GT ; Unused          ; $PtrueBHSD($elSize) ; sleq ; $elements ; $elSize ; $elStr) ; $regSize)
    }

  model SVEWhileXWInstr (i: InstrWithFunct, elements: Id, elSize: Id, elStr: Str): IsaDefs = {
    $SVEWhileCondInstr ($ExtInstrStr ($i;  "W"); WSize ; $elements ; $elSize ; $elStr)
    $SVEWhileCondInstr ($ExtInstrStr ($i;  "X"); XSize ; $elements ; $elSize ; $elStr)
    }

// SVE load / store common definitions *****************************************

  enumeration LDDtype : Bits<4> =          // load data type, memory and element size and type
    { DtUBB = 0b0000                       // unsigned load memory byte, element byte
    , DtUBH = 0b0001                       // unsigned load memory byte, element half
    , DtUBW = 0b0010                       // unsigned load memory byte, element word
    , DtUBD = 0b0011                       // unsigned load memory byte, element double
    , DtSWD = 0b0100                       //   signed load memory word, element double
    , DtUHH = 0b0101                       // unsigned load memory half, element half
    , DtUHW = 0b0110                       // unsigned load memory half, element word
    , DtUHD = 0b0111                       // unsigned load memory half, element double
    , DtSHD = 0b1000                       //   signed load memory half, element double
    , DtSHW = 0b1001                       //   signed load memory half, element word
    , DtUWW = 0b1010                       // unsigned load memory word, element word
    , DtUWD = 0b1011                       // unsigned load memory word, element double
    , DtSBD = 0b1100                       //   signed load memory byte, element double
    , DtSBW = 0b1101                       //   signed load memory byte, element word
    , DtSBH = 0b1110                       //   signed load memory byte, element half
    , DtUDD = 0b1111                       // unsigned load memory double, element double
    }

  enumeration STDtype : Bits<4> =          // store data type, memory and element size and type
    { DtBB = 0b0000                        // store memory byte, element byte
    , DtBH = 0b0001                        // store memory byte, element half
    , DtBW = 0b0010                        // store memory byte, element word
    , DtBD = 0b0011                        // store memory byte, element double
    , DtHR = 0b0100                        // reserved
    , DtHH = 0b0101                        // store memory half, element half
    , DtHW = 0b0110                        // store memory half, element word
    , DtHD = 0b0111                        // store memory half, element double
    , DtWQ = 0b1000                        // store memory word, element quad
    , DtWR = 0b1001                        // reserved
    , DtWW = 0b1010                        // store memory word, element word
    , DtWD = 0b1011                        // store memory word, element double
    , DtR1 = 0b1100                        // reserved
    , DtR2 = 0b1100                        // reserved
    , DtDQ = 0b1110                        // store memory double, element quad
    , DtDD = 0b1111                        // store memory double, element double
    }

  function Imm2lslU  (imm: Bits<2>)  -> String =
    if imm = 0 then "" else (", lsl #", udec(imm))

  record MemSVE  (dtype: Id, elements: Id, memBytes: Int, elSize: Id, elStr: Str, elType: Id, extStr: Str)

// SVE load / store scalar scalar single register models ***********************

  format SVEMemScalarScalarFormat: Instr = // SVE memory scalar scalar format
    { op       [31..25]        : Bits7     // opcode
    , dtype    [24..21]        : Bits4     // memory and element size and type ((LD/ST)Dtype)
    , rm       [20..16]        : Index     // scaled index register
    , opc      [15..13]        : Bits3     // opcode second part
    , pg       [12..10]        : Bits3     // predicate register
    , rn       [9..5]          : Index     // base address X/SP register
    , zt       [4..0]          : Index     // destination Z register
    }

  model SVELoadScalarScalarInstr (i: InstrWithFunct, d: MemSVE): IsaDefs = {
    [undefined when : rm = 0b1'1111]
    instruction $i.id: SVEMemScalarScalarFormat =
      let offset = X(rm) in
      let base = S(rn) + offset * $d.memBytes in
      let pred  = P(pg) in
        Z(zt) := forall i : SIntX in 0..$d.elements-1 tensor
          if pred(i << ElSize::$d.elSize)
            then MEM<$d.memBytes>(base + i * $d.memBytes) as $d.elType<(8 << ElSize::$d.elSize)>
            else 0
    encoding $i.id = { op = 0b101'0010, opc = $i.opcode, dtype = LDDtype::$d.dtype }
    assembly $i.id = ( AsStr($i.mnemo, $d.extStr), ' ', register(zt), $d.elStr, ', ', register(pg), '/z, [', XSizeSP(rn), ',', XSize(rm), Imm2lslU(ElSize::$d.elSize), ']')
    }

  model SVEStoreScalarScalarInstr (i: InstrWithFunct, d: MemSVE): IsaDefs = {
    [undefined when : rm = 0b1'1111]
    instruction $i.id: SVEMemScalarScalarFormat =
      let offset = X(rm) in
      let base  = S(rn) + offset * $d.memBytes in
      let pred  = P(pg) in
      let elems = Z(zt) as $BitsBHSD($d.elSize) in
        forall i : SIntX in 0..$d.elements-1 do
          if pred(i << ElSize::$d.elSize)
            then MEM<$d.memBytes>(base + i * $d.memBytes) := elems(i) as Bits<(8 * $d.memBytes)>
    encoding $i.id = { op = 0b111'0010, opc = $i.opcode, dtype = STDtype::$d.dtype }
    assembly $i.id = ( AsStr($i.mnemo, $d.extStr), ' ', register(zt), $d.elStr, ', ', register(pg), '/z, [', XSizeSP(rn), ',', XSize(rm), Imm2lslU(ElSize::$d.elSize), ']')
    }

// SVE load / store scalar immediate single register models ********************

  format SVEMemScalarImmOneFormat: Instr = // SVE memory scalar immediate format
    { op       [31..25]        : Bits7     // opcode
    , dtype    [24..21]        : Bits4     // memory and element size and type ((LD/ST)Dtype)
    , opc      [20,15..13]     : Bits4     // opcode second part
    , imm4     [19..16]        : Bits4     // signed scaled immediate offset
    , pg       [12..10]        : Bits3     // predicate register
    , rn       [9..5]          : Index     // base address X/SP register
    , zt       [4..0]          : Index     // destination Z register
    , offset = imm4 as SIntX
    }

  model SVELoadScalarImmInstr (i: InstrWithFunct, d: MemSVE): IsaDefs = {
    instruction $i.id: SVEMemScalarImmOneFormat =
      let base = S(rn) + offset * $d.elements * $d.memBytes in
      let pred  = P(pg) in
        Z(zt) := forall i : SIntX in 0..$d.elements-1 tensor
          if pred(i << ElSize::$d.elSize)
            then MEM<$d.memBytes>(base + i * $d.memBytes) as $d.elType<(8 << ElSize::$d.elSize)>
            else 0
    encoding $i.id = { op = 0b101'0010, opc = $i.opcode, dtype = LDDtype::$d.dtype }
    assembly $i.id = ( AsStr($i.mnemo, $d.extStr), ' ', register(zt), $d.elStr, ', ', register(pg), '/z, ', XSizeSP(rn), ', #', sdec(imm4))
    }

  model SVEStoreScalarImmInstr (i: InstrWithFunct, d: MemSVE): IsaDefs = {
    instruction $i.id: SVEMemScalarImmOneFormat =
      let base = S(rn) + offset * $d.elements * $d.memBytes in
      let pred  = P(pg) in
      let elems = Z(zt) as $BitsBHSD($d.elSize) in
        forall i : SIntX in 0..$d.elements-1 do
          if pred(i << ElSize::$d.elSize)
            then MEM<$d.memBytes>(base + i * $d.memBytes) := elems(i) as Bits<(8 * $d.memBytes)>
    encoding $i.id = { op = 0b111'0010, opc = $i.opcode, dtype = STDtype::$d.dtype }
    assembly $i.id = ( AsStr($i.mnemo, $d.extStr), ' ', register(zt), $d.elStr, ', ', register(pg), '/z, ', XSizeSP(rn), ', #', sdec(imm4))
    }

// instruction enriching models ************************************************

  model-type InstrWithFunctMemSVE = (InstrWithFunct, MemSVE) -> IsaDefs

  model InstrMemLD16 (modelid: InstrWithFunctMemSVE, i: InstrWithFunct): IsaDefs = {
    $modelid ($ExtInstrStr ($i; "UBB"); (DtUBB; ElementsB; 1; SizeB; '.b'; Bits; "b" ))
    $modelid ($ExtInstrStr ($i; "UBH"); (DtUBH; ElementsH; 1; SizeH; '.h'; Bits; "b" ))
    $modelid ($ExtInstrStr ($i; "UBW"); (DtUBW; ElementsW; 1; SizeW; '.s'; Bits; "b" ))
    $modelid ($ExtInstrStr ($i; "UBD"); (DtUBD; ElementsD; 1; SizeD; '.d'; Bits; "b" ))
    $modelid ($ExtInstrStr ($i; "SWD"); (DtSWD; ElementsD; 4; SizeD; '.d'; SInt; "sw"))
    $modelid ($ExtInstrStr ($i; "UHH"); (DtUHH; ElementsH; 2; SizeH; '.h'; Bits; "h" ))
    $modelid ($ExtInstrStr ($i; "UHW"); (DtUHW; ElementsW; 2; SizeW; '.s'; Bits; "h" ))
    $modelid ($ExtInstrStr ($i; "UHD"); (DtUHD; ElementsD; 2; SizeD; '.d'; Bits; "h" ))
    $modelid ($ExtInstrStr ($i; "SHD"); (DtSHD; ElementsD; 2; SizeD; '.d'; SInt; "sh"))
    $modelid ($ExtInstrStr ($i; "SHW"); (DtSHW; ElementsW; 2; SizeW; '.s'; SInt; "sh"))
    $modelid ($ExtInstrStr ($i; "UWW"); (DtUWW; ElementsW; 4; SizeW; '.s'; Bits; "w" ))
    $modelid ($ExtInstrStr ($i; "UWD"); (DtUWD; ElementsD; 4; SizeD; '.d'; Bits; "w" ))
    $modelid ($ExtInstrStr ($i; "SBD"); (DtSBD; ElementsD; 1; SizeD; '.d'; SInt; "sb"))
    $modelid ($ExtInstrStr ($i; "SBW"); (DtSBW; ElementsW; 1; SizeW; '.s'; SInt; "sb"))
    $modelid ($ExtInstrStr ($i; "SBH"); (DtSBH; ElementsH; 1; SizeH; '.h'; SInt; "sb"))
    $modelid ($ExtInstrStr ($i; "UDD"); (DtUDD; ElementsD; 8; SizeD; '.d'; Bits; "d" ))
    }

  model InstrMemST10 (modelid: InstrWithFunctMemSVE, i: InstrWithFunct): IsaDefs = {
    $modelid ($ExtInstrStr ($i; "BB"); (DtBB; ElementsB; 1; SizeB; '.b'; Bits; "b" ))
    $modelid ($ExtInstrStr ($i; "BH"); (DtBH; ElementsH; 1; SizeH; '.h'; Bits; "b" ))
    $modelid ($ExtInstrStr ($i; "BW"); (DtBW; ElementsW; 1; SizeW; '.s'; Bits; "b" ))
    $modelid ($ExtInstrStr ($i; "BD"); (DtBD; ElementsD; 1; SizeD; '.d'; Bits; "b" ))
    $modelid ($ExtInstrStr ($i; "HH"); (DtHH; ElementsH; 2; SizeH; '.h'; Bits; "h" ))
    $modelid ($ExtInstrStr ($i; "HW"); (DtHW; ElementsW; 2; SizeW; '.s'; Bits; "h" ))
    $modelid ($ExtInstrStr ($i; "HD"); (DtHD; ElementsD; 2; SizeD; '.d'; Bits; "h" ))
    $modelid ($ExtInstrStr ($i; "WW"); (DtWW; ElementsW; 4; SizeW; '.s'; Bits; "w" ))
    $modelid ($ExtInstrStr ($i; "WD"); (DtWD; ElementsD; 4; SizeD; '.d'; Bits; "w" ))
    $modelid ($ExtInstrStr ($i; "DD"); (DtDD; ElementsD; 8; SizeD; '.d'; Bits; "d" ))
    }

  model InstrBHSD (modelid: InstrWithFunctElemSizeType, i: InstrWithFunct): IsaDefs = {
    $modelid ($ExtInstrStr ($i; "B"); ElementsB; SizeB; ".b")
    $modelid ($ExtInstrStr ($i; "H"); ElementsH; SizeH; ".h")
    $modelid ($ExtInstrStr ($i; "S"); ElementsS; SizeS; ".s")
    $modelid ($ExtInstrStr ($i; "D"); ElementsD; SizeD; ".d")
    }

  model InstrSD (modelid: InstrWithFunctElemSizeType, i: InstrWithFunct): IsaDefs = {
    $modelid ($ExtInstrStr ($i; "S"); ElementsS; SizeS; ".s")
    $modelid ($ExtInstrStr ($i; "D"); ElementsD; SizeD; ".d")
    }


// common sve and sme instructions *********************************************

  $InstrBHSD        (SVEArithmeticPredInstr    ; (SVEpredADD    ; "add"   ; 0b0000'0000      ; add      ))
  $InstrBHSD        (SVEArithmeticPredInstr    ; (SVEpredSUB    ; "sub"   ; 0b0000'1000      ; sub      ))
  $InstrBHSD        (SVEArithmeticPredInstr    ; (SVEpredMUL    ; "mul"   ; 0b1000'0000      ; mul      ))
  $InstrSD          (SVEArithmeticPredInstr    ; (SVEpredSDIV   ; "sdiv"  ; 0b1010'0000      ; sdiv     ))
  $InstrSD          (SVEArithmeticPredInstr    ; (SVEpredUDIV   ; "udiv"  ; 0b1010'1000      ; udiv     ))

  $InstrBHSD        (SVEArithmeticUnprInstr    ; (SVEunprADD    ; "add"   ; 0b000'000        ; add      ))
  $InstrBHSD        (SVEArithmeticUnprInstr    ; (SVEunprSUB    ; "sub"   ; 0b000'001        ; sub      ))
  $InstrBHSD        (SVEArithmeticUnprInstr    ; (SVEunprMUL    ; "mul"   ; 0b011'000        ; mul      ))

  $SVEIncrInstr     (                            (SVEINC        ; "inc"   ; 0b111'000        ; inc      ))

  $InstrBHSD        (SVEWhileXWInstr           ; (SVEWHILE      ; "while" ; 0b000            ; unused   ))

  $InstrMemLD16     (SVELoadScalarScalarInstr  ; (SVEsclLD1     ; "ld1"   ;  0b010           ; unused   ))
  $InstrMemST10     (SVEStoreScalarScalarInstr ; (SVEsclST1     ; "st1"   ;  0b010           ; unused   ))
  $InstrMemLD16     (SVELoadScalarImmInstr     ; (SVEimmLD1     ; "ld1"   ; 0b0101           ; unused   ))
  $InstrMemST10     (SVEStoreScalarImmInstr    ; (SVEimmST1     ; "st1"   ; 0b0111           ; unused   ))

}
