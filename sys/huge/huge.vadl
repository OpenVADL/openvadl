// huge instruction set specification for stress tests of the OpenVADL tool chain

instruction set architecture HUGE = {

  using Index    = Bits<5>              // register file index for 32 registers
  using IndexC   = Bits<4>              // register file index for the lower 16 registers
  using Shift    = Bits<6>              // size for shift amounts
  using BitsB    = Bits<8>              // memory size / byte operations
  using BitsH    = Bits<16>             // half word size (16 bit)
  using BitsW    = Bits<32>             // full word size (32 bit)
  using BitsD    = Bits<64>             // double word size
  using SIntD    = SInt<64>             // double word size
  using Addrs    = BitsD                // address has double word size
  using Instr    = BitsD                // instructions have double word size

  memory MEM : Addrs  -> BitsB          // byte addressed memory

  program counter PC : Addrs            // program counter TODO alias R(15)

  [zero: R(0)]                          // register with index 0 always is 0
  register R : Index -> BitsD           // general purpose register file

  [overwrite source: sign]              // RB is sign extended on write
  alias register RB = R(*)( 7..0)       // byte   register file
  [overwrite source: sign]              // RH is sign extended on write
  alias register RH = R(*)(15..0)       // half   register file
  [overwrite source: sign]              // RW is sign extended on write
  alias register RW = R(*)(31..0)       // word   register file
  alias register RD = R                 // double register file

  enumeration OpSize : Bits<2> =        // instruction operation size
    { B                                 // Byte
    , H                                 // Half
    , W                                 // Word
    , D                                 // Double
    }

  enumeration Condition : Bits<3> =     // condition code encodings
    { EQ                                // EQual
    , NE                                // Not Equal
    , SLT                               // Signed Less Than
    , SLE                               // Signed Less than or Equal
    , ULT                               // Unsigned Less Than
    , ULE                               // Unsigned Less than or Equal
    , AL                                // Always
    , IL                                // ILligal
    }

  enumeration OpShift : Bits<2> =       // operation with shifted operand
    { Add                               // Addition
    , Sub                               // Subtraction
    , And                               // bitwise And
    , Or                                // bitwise Or
    }

  enumeration AddSub : Bits<1> =        // operation with index register
    { Add                               // Addition
    , Sub                               // Subtraction
    }

  // instruction: instruction id, assembly name,  id, opcode
  record InstrRec (id : Id, name : Str, op : Id, opcode : Ex)

  // condition: CondCode id, assembly extension string, condition expression
  record CondRec  (condId : Id, condSize : Id, condStr : Str, condEx : Ex, encs : Encs)

  // shifted operands: operand identifier, operand expression, encodings, assembly elements
  record OpRec (opId : Id, opEx : Ex, encs : Encs, asms : Ex)

  model-type InstrModel = (Id, Str, CondRec, InstrRec, OpRec) -> IsaDefs
  model-type OperandModel = (InstrModel, Id, Str, CondRec, InstrRec) -> IsaDefs

// arithmetic register models **************************************************

  format ArithmeticRegFormat : Instr =  // arithmetic register +-&| shifted register format
    { opsize   : Bits<2>                // operation size
    , cond     : Bits<3>                // condition
    , ccsz     : Bits<2>                // condition size
    , cregl    : IndexC                 // condition register left
    , cregr    : IndexC                 // condition register right
    , op       : Bits<7>                // opcode
    , regd     : Index                  // destination  register
    , regl     : Index                  // left  source register
    , regr     : Index                  // right source register
    , regs     : Index                  // shift source register
    , opShift  : Bits<2>                // operation with shifted register
    , funct    : Bits<14>               // function code
    , shift    : Shift                  // shift amount
    }

  model ArithmeticRegInstr (size: Id, sizeStr: Str, c : CondRec, i : InstrRec, o : OpRec) : IsaDefs = {
    instruction AsId ($i.id, $size, $o.opId, $c.condStr) : ArithmeticRegFormat =
      if ($c.condEx) then
        AsId (R, $size)(regd) := VADL::$i.op (AsId (R, $size)(regl), $o.opEx) as AsId(Bits, $size)
    encoding AsId ($i.id, $size, $o.opId, $c.condStr) = {
      opsize = OpSize::$size, cond = Condition::$c.condId, ccsz = OpSize::$c.condSize,
      op = 0b111'1111, funct = $i.opcode, $c.encs, $o.encs
      }
    assembly AsId ($i.id, $size, $o.opId, $c.condStr) = (AsStr($i.name, $sizeStr, $c.condStr), ' ', register(cregl), ',', register(cregr), ',', 
      register(regd), ',', register(regl), ',', register(regr), $o.asms)
    }

  model JumpInstr (size: Id, sizeStr: Str, c : CondRec, i : InstrRec, o : OpRec) : IsaDefs = {
    instruction AsId ($i.id, $size, $o.opId, $c.condStr) : ArithmeticRegFormat =
      if ($c.condEx) then
        let return = PC.next in {
          PC := (RD(regl) + ($o.opEx) as SIntD) & -8 as BitsD
          RD(regd) := return
        }
    encoding AsId ($i.id, $size, $o.opId, $c.condStr) = {
      opsize = OpSize::$size, cond = Condition::$c.condId, ccsz = OpSize::$c.condSize,
      op = 0b111'1111, funct = $i.opcode, $c.encs, $o.encs
      }
    assembly AsId ($i.id, $size, $o.opId, $c.condStr) = (AsStr($i.name, $sizeStr, $c.condStr), ' ', register(cregl), ',', register(cregr), ',', 
      register(regd), ',', register(regl), ',', register(regr), $o.asms)
    }

  model OpShiftReg (m: InstrModel, size: Id, sizeStr: Str, c : CondRec, i : InstrRec) : IsaDefs = {
    $m ($size ; $sizeStr ; $c ; $i ; (Zero   ; (AsId(R, $size)(regr)) ;               regs= 0, shift = 0, opShift = OpShift::Add ;  ""                                     ))
    $m ($size ; $sizeStr ; $c ; $i ; (Add    ; (AsId(R, $size)(regr) + AsId(R, $size)(regs)) ; shift = 0, opShift = OpShift::Add ; ("+", register(regs)                   )))
    $m ($size ; $sizeStr ; $c ; $i ; (Sub    ; (AsId(R, $size)(regr) - AsId(R, $size)(regs)) ; shift = 0, opShift = OpShift::Sub ; ("-", register(regs)                   )))
    $m ($size ; $sizeStr ; $c ; $i ; (And    ; (AsId(R, $size)(regr) & AsId(R, $size)(regs)) ; shift = 0, opShift = OpShift::And ; ("&", register(regs)                   )))
    $m ($size ; $sizeStr ; $c ; $i ; (Or     ; (AsId(R, $size)(regr) | AsId(R, $size)(regs)) ; shift = 0, opShift = OpShift::Or  ; ("|", register(regs)                   )))
    $m ($size ; $sizeStr ; $c ; $i ; (AddSft ; (AsId(R, $size)(regr) + AsId(R, $size)(regs) << shift)   ; opShift = OpShift::Add ; ("+", register(regs), "<<", udec(shift))))
    $m ($size ; $sizeStr ; $c ; $i ; (SubSft ; (AsId(R, $size)(regr) - AsId(R, $size)(regs) << shift)   ; opShift = OpShift::Sub ; ("-", register(regs), "<<", udec(shift))))
    $m ($size ; $sizeStr ; $c ; $i ; (AndSft ; (AsId(R, $size)(regr) & AsId(R, $size)(regs) << shift)   ; opShift = OpShift::And ; ("&", register(regs), "<<", udec(shift))))
    $m ($size ; $sizeStr ; $c ; $i ; (OrSft  ; (AsId(R, $size)(regr) | AsId(R, $size)(regs) << shift)   ; opShift = OpShift::Or  ; ("|", register(regs), "<<", udec(shift))))
    }

// arithmetic immediate models *************************************************

  format ArithmeticImmFormat : Instr =  // arithmetic immediate shifted format
    { opsize   : Bits<2>                // operation size
    , cond     : Bits<3>                // condition
    , ccsz     : Bits<2>                // condition size
    , cregl    : IndexC                 // condition register left
    , cregr    : IndexC                 // condition register right
    , op       : Bits<5>                // opcode
    , immShift : Bits<2>                // shift kind for immediate value
    , regd     : Index                  // destination  register
    , regl     : Index                  // left  source register
    , imm      : BitsW                  // immediate value
    , imm0     = imm as SIntD           // sign extended immediate value
    , imm1     = imm as SIntD << 16     // sign extended shifted immediate value
    , imm2     = imm as SIntD << 32     // sign extended shifted immediate value
    , imm3     = imm as SIntD << 48     // sign extended shifted immediate value
    }

  model ArithmeticImmInstr (size: Id, sizeStr: Str, c : CondRec, i : InstrRec, o : OpRec) : IsaDefs = {
    instruction AsId ($i.id, $size, $o.opId, $c.condStr) : ArithmeticImmFormat =
      if ($c.condEx) then
        AsId (R, $size)(regd) := VADL::$i.op (AsId (R, $size)(regl), $o.opEx) as AsId(Bits, $size)
    encoding AsId ($i.id, $size, $o.opId, $c.condStr) = {
      opsize = OpSize::$size, cond = Condition::$c.condId, ccsz = OpSize::$c.condSize,
      op = $i.opcode, $c.encs, $o.encs
      }
    assembly AsId ($i.id, $size, $o.opId, $c.condStr) = (AsStr($i.name, $sizeStr, $c.condStr), ' ', register(cregl), ',', register(cregr), ',', 
      register(regd), ',', register(regl), ',', $o.asms)
    }

  model OpShiftImm (m: InstrModel, size: Id, sizeStr: Str, c : CondRec, i : InstrRec) : IsaDefs = {
    $m ($size ; $sizeStr ; $c ; $i ; (Sft00 ; (imm0 as AsId(Bits, $size)) ; immShift = 0 ; (udec(imm)        )))
    $m ($size ; $sizeStr ; $c ; $i ; (Sft16 ; (imm1 as AsId(Bits, $size)) ; immShift = 1 ; (udec(imm), "<<16")))
    $m ($size ; $sizeStr ; $c ; $i ; (Sft32 ; (imm2 as AsId(Bits, $size)) ; immShift = 2 ; (udec(imm), "<<32")))
    $m ($size ; $sizeStr ; $c ; $i ; (Sft48 ; (imm3 as AsId(Bits, $size)) ; immShift = 3 ; (udec(imm), "<<48")))
    }

// memory models ***************************************************************

  format MemoryFormat : Instr =         // memory format
    { opsize   : Bits<2>                // operation size
    , cond     : Bits<3>                // condition
    , ccsz     : Bits<2>                // condition size
    , cregl    : IndexC                 // condition register left
    , cregr    : IndexC                 // condition register right
    , op       : Bits<7>                // opcode
    , regd     : Index                  // source / destination  register
    , base     : Index                  // address base register
    , index    : Index                  // shifted index register
    , addsub   : Bits<1>                // operation with index register
    , shift    : Shift                  // shift amount
    , offset   : Bits<20>               // signed offset
    , offsetB  = offset as SIntD        // byte offset
    , offsetH  = offset as SIntD << 1   // half offset
    , offsetW  = offset as SIntD << 2   // word offset
    , offsetD  = offset as SIntD << 3   // double offset
    }

  model MemEncAsm (size: Id, sizeStr: Str, c : CondRec, i : InstrRec, o : OpRec) : IsaDefs = {
      encoding AsId ($i.id, $size, $o.opId, $c.condStr) = {
      opsize = OpSize::$size, cond = Condition::$c.condId, ccsz = OpSize::$c.condSize,
      op = $i.opcode, $c.encs, $o.encs
      }
    assembly AsId ($i.id, $size, $o.opId, $c.condStr) = (AsStr($i.name, $sizeStr, $c.condStr), ' ', register(cregl), ',', register(cregr), ',', 
      register(regd), ',', register(base), $o.asms)
    }

  model LoadInstr (size: Id, sizeStr: Str, c : CondRec, i : InstrRec, o : OpRec) : IsaDefs = {
    instruction AsId ($i.id, $size, $o.opId, $c.condStr) : MemoryFormat =
      if ($c.condEx) then
        let addr = ($o.opEx) as BitsD + AsId (offset, $size) in 
          RD(regd) := MEM<(1 << OpSize::$size)>(addr) as $i.op
    $MemEncAsm ($size ; $sizeStr ; $c ; $i ; $o)
    }

  model StoreInstr (size: Id, sizeStr: Str, c : CondRec, i : InstrRec, o : OpRec) : IsaDefs = {
    instruction AsId ($i.id, $size, $o.opId, $c.condStr) : MemoryFormat =
      if ($c.condEx) then
        let addr = ($o.opEx) as BitsD + AsId (offset, $size) in 
          MEM<(1 << OpSize::$size)>(addr) := AsId (R, $size)(regd)
    $MemEncAsm ($size ; $sizeStr ; $c ; $i ; $o)
    }

  model OpMemory (m: InstrModel, size: Id, sizeStr: Str, c : CondRec, i : InstrRec) : IsaDefs = {
    $m ($size ; $sizeStr ; $c ; $i ; (Zero   ; (AsId(R, $size)(base)) ;               index= 0, shift = 0, addsub = AddSub::Add ;  ""                                      ))
    $m ($size ; $sizeStr ; $c ; $i ; (Add    ; (AsId(R, $size)(base) + AsId(R, $size)(index)) ; shift = 0, addsub = AddSub::Add ; ("+", register(index)                   )))
    $m ($size ; $sizeStr ; $c ; $i ; (Sub    ; (AsId(R, $size)(base) - AsId(R, $size)(index)) ; shift = 0, addsub = AddSub::Sub ; ("-", register(index)                   )))
    $m ($size ; $sizeStr ; $c ; $i ; (AddSft ; (AsId(R, $size)(base) + AsId(R, $size)(index) << shift)   ; addsub = AddSub::Add ; ("+", register(index), "<<", udec(shift))))
    $m ($size ; $sizeStr ; $c ; $i ; (SubSft ; (AsId(R, $size)(base) - AsId(R, $size)(index) << shift)   ; addsub = AddSub::Sub ; ("-", register(index), "<<", udec(shift))))
    }

// branch models ***************************************************************

  format BranchFormat : Instr =         // branch format
    { opsize   : Bits<2>                // operation size
    , cond     : Bits<3>                // condition
    , ccsz     : Bits<2>                // condition size
    , cregl    : IndexC                 // condition register left
    , cregr    : IndexC                 // condition register right
    , op       : Bits<7>                // opcode
    , regd     : Index                  // destination register (return address)
    , off      : Bits<37>               // branch offset
    , offset   = off as SIntD << 3      // sign extended and shifted branch offset
    }

  model BranchInstr (size: Id, sizeStr: Str, c : CondRec, i : InstrRec, o : OpRec) : IsaDefs = {
    instruction AsId ($i.id, $c.condStr) : BranchFormat =
      if ($c.condEx) then {
        RD(regd) := PC.next
        PC := PC + offset
        }
    encoding AsId ($i.id, $c.condStr) = {
      opsize = OpSize::$size, cond = Condition::$c.condId, ccsz = OpSize::$c.condSize,
      op = $i.opcode, $c.encs
      }
    assembly AsId ($i.id, $c.condStr) = (AsStr($i.name, $sizeStr, $c.condStr), ' ', register(cregl), ',', register(cregr), ',', 
      register(regd), ',', sdec(offset))
    }

  model NoOperand (m: InstrModel, size: Id, sizeStr: Str, c : CondRec, i : InstrRec) : IsaDefs = {
    $m ($size ; $sizeStr ; $c ; $i ; (none ; none ; none ; ""))
  }

  model OperandCondInstr (m: InstrModel, o: OperandModel, size: Id, sizeStr: Str, i : InstrRec) : IsaDefs = {
    $o ($m ;$size ; $sizeStr ; (EQ  ; B ; "" ; true ; cregl = 0,           cregr = 0)     ; $i)
    $o ($m ;$size ; $sizeStr ; (EQ  ; B ; "beq"  ; RB(cregl)          = RB(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (EQ  ; H ; "heq"  ; RH(cregl)          = RH(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (EQ  ; W ; "weq"  ; RW(cregl)          = RW(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (EQ  ; D ; "deq"  ; RD(cregl)          = RD(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (NE  ; B ; "bne"  ; RB(cregl)         != RB(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (NE  ; H ; "hne"  ; RH(cregl)         != RH(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (NE  ; W ; "wne"  ; RW(cregl)         != RW(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (NE  ; D ; "dne"  ; RD(cregl)         != RD(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (SLT ; B ; "bslt" ; RB(cregl) as SInt <  RB(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (SLT ; H ; "hslt" ; RH(cregl) as SInt <  RH(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (SLT ; W ; "wslt" ; RW(cregl) as SInt <  RW(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (SLT ; D ; "dslt" ; RD(cregl) as SInt <  RD(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (SLE ; B ; "bsle" ; RB(cregl) as SInt <= RB(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (SLE ; H ; "hsle" ; RH(cregl) as SInt <= RH(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (SLE ; W ; "wsle" ; RW(cregl) as SInt <= RW(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (SLE ; D ; "dsle" ; RD(cregl) as SInt <= RD(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (ULT ; B ; "bult" ; RB(cregl)         <  RB(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (ULT ; H ; "hult" ; RH(cregl)         <  RH(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (ULT ; W ; "wult" ; RW(cregl)         <  RW(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (ULT ; D ; "dult" ; RD(cregl)         <  RD(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (ULE ; B ; "bule" ; RB(cregl)         <= RB(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (ULE ; H ; "hule" ; RH(cregl)         <= RH(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (ULE ; W ; "wule" ; RW(cregl)         <= RW(cregr); none ) ; $i)
    $o ($m ;$size ; $sizeStr ; (ULE ; D ; "dule" ; RD(cregl)         <= RD(cregr); none ) ; $i)
    }

  model SizeCondInstr (m: InstrModel, o: OperandModel, i : InstrRec) : IsaDefs = {
    $OperandCondInstr ($m ; $o; B ; "b" ; $i )
    $OperandCondInstr ($m ; $o; H ; "h" ; $i )
    $OperandCondInstr ($m ; $o; W ; "w" ; $i )
    $OperandCondInstr ($m ; $o; D ; "d" ; $i )
  }

  model DoubleCondInstr (m: InstrModel, o: OperandModel, i : InstrRec) : IsaDefs = {
    $OperandCondInstr ($m ; $o; D ; "d" ; $i )
  }

// arithmetic register instructions ********************************************

  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (ADD     ; "add"   ; add    ; 0b00'0000'0000'0000))
  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (SUB     ; "sub"   ; sub    ; 0b00'0000'0000'0001))
  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (AND     ; "and"   ; and    ; 0b00'0000'0000'0010))
  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (OR      ; "or"    ; or     ; 0b00'0000'0000'0011))
  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (XOR     ; "xor"   ; xor    ; 0b00'0000'0000'0100))
  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (LSL     ; "lsl"   ; lsl    ; 0b00'0000'0000'0101))
  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (LSR     ; "lsr"   ; lsr    ; 0b00'0000'0000'0110))
  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (ASR     ; "asr"   ; asr    ; 0b00'0000'0000'0111))

  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (SDIV    ; "sdiv"  ; sdiv   ; 0b00'0000'0000'1000))
  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (UDIV    ; "udiv"  ; udiv   ; 0b00'0000'0000'1001))
  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (SMOD    ; "smod"  ; smod   ; 0b00'0000'0000'1010))
  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (UMOD    ; "umod"  ; umod   ; 0b00'0000'0000'1011))

  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (MUL     ; "mul"   ; mul    ; 0b00'0000'0000'1100))

  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (SEQ     ; "seq"   ; equ    ; 0b00'0000'0000'1110))
  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (SNE     ; "seq"   ; equ    ; 0b00'0000'0000'1111))
  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (SSLT    ; "sslt"  ; slth   ; 0b00'0000'0001'0000))
  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (SSLE    ; "ssle"  ; sleq   ; 0b00'0000'0001'0001))
  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (SSGT    ; "ssgt"  ; sgth   ; 0b00'0000'0001'0010))
  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (SSGE    ; "ssge"  ; sgeq   ; 0b00'0000'0001'0011))
  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (USLT    ; "uslt"  ; ulth   ; 0b00'0000'0001'0100))
  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (USLE    ; "usle"  ; uleq   ; 0b00'0000'0001'0101))
  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (USGT    ; "usgt"  ; ugth   ; 0b00'0000'0001'0110))
  $SizeCondInstr    (ArithmeticRegInstr ; OpShiftReg ;  (USGE    ; "usge"  ; ugeq   ; 0b00'0000'0001'0111))

  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (ADD     ; "add"   ; add    ;            0b0'0000))
  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (SUB     ; "sub"   ; sub    ;            0b0'0001))
  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (AND     ; "and"   ; and    ;            0b0'0010))
  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (OR      ; "or"    ; or     ;            0b0'0011))
  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (XOR     ; "xor"   ; xor    ;            0b0'0100))
  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (LSL     ; "lsl"   ; lsl    ;            0b0'0101))
  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (LSR     ; "lsr"   ; lsr    ;            0b0'0110))
  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (ASR     ; "asr"   ; asr    ;            0b0'0111))

  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (SDIV    ; "sdiv"  ; sdiv   ;            0b0'1000))
  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (UDIV    ; "udiv"  ; udiv   ;            0b0'1001))
  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (SMOD    ; "smod"  ; smod   ;            0b0'1010))
  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (UMOD    ; "umod"  ; umod   ;            0b0'1011))

  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (MUL     ; "mul"   ; mul    ;            0b0'1100))

  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (SEQ     ; "seq"   ; equ    ;            0b0'1110))
  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (SNE     ; "seq"   ; equ    ;            0b0'1111))
  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (SSLT    ; "sslt"  ; slth   ;            0b1'0000))
  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (SSLE    ; "ssle"  ; sleq   ;            0b1'0001))
  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (SSGT    ; "ssgt"  ; sgth   ;            0b1'0010))
  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (SSGE    ; "ssge"  ; sgeq   ;            0b1'0011))
  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (USLT    ; "uslt"  ; ulth   ;            0b1'0100))
  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (USLE    ; "usle"  ; uleq   ;            0b1'0101))
  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (USGT    ; "usgt"  ; ugth   ;            0b1'0110))
  $SizeCondInstr    (ArithmeticImmInstr ; OpShiftImm ;  (USGE    ; "usge"  ; ugeq   ;            0b1'0111))

  $SizeCondInstr    (StoreInstr         ; OpMemory   ;  (ST      ; "st"    ; none   ;          0b111'1011))
  $SizeCondInstr    (LoadInstr          ; OpMemory   ;  (SLD     ; "sld"   ; SIntD  ;          0b111'1100))
  $SizeCondInstr    (LoadInstr          ; OpMemory   ;  (ULD     ; "uld"   ; BitsD  ;          0b111'1101))

  $DoubleCondInstr  (BranchInstr        ; NoOperand  ;  (BR      ; "br"    ; none   ;          0b111'1110))
  $SizeCondInstr    (JumpInstr          ; OpShiftReg ;  (JMP     ; "jmp"   ; none   ; 0b11'1111'1111'1111))
