// Description of the RISC-V SoomRV architecture.
//
// Information used in modelling collected from:
// - The SoomRV github repository's README
//   (https://github.com/mathis-s/SoomRV)
//
// SoomRV appears to be a very small RISC-V out-of-order implementation,
// currently only listing three contributors. However, it is still mature
// enough to boot a linux kernel.
micro architecture SoomRV = {

  //-------------------------------------------------------------------------//
  //                             (Silly) Frontend                            //
  //-------------------------------------------------------------------------//

  stage FETCH -> FetchResult = {
    FETCH := fetchNext
  }

  stage DECODE -> Instruction = {
    DECODE := decode(consume(FETCH))
  }

  //-------------------------------------------------------------------------//
  //              Centralized Resources in the Execution Engine              //
  //-------------------------------------------------------------------------//

  [size : 64]
  [controls : INT_PRF]
  [consume : DECODE]
  logic [reorder buffer] ROB

  [size : 64]
  [renames : X]
  logic [physical register file] INT_PRF

  [size : 8]
  [consume : ROB, ALU0Ops]
  logic [reservation station] ALU0_ISSUE_QUEUE

  [size : 8]
  [consume : ROB, ALU1Ops]
  logic [reservation station] ALU1_ISSUE_QUEUE

  [size : 8]
  [consume : ROB, MemOps]
  logic [reservation station] AGU0_ISSUE_QUEUE

  [size : 8]
  [consume : ROB, MemOps]
  logic [reservation station] AGU1_ISSUE_QUEUE

  // FIXME: Every store is split into an address generation and a store data
  //        uop. The address generation is dispatched to one of the
  //        AGU_ISSUE_QUEUEs, while the store data is dispatched to one of the
  //        STORE_DATA_ISSUE_QUEUEs. Such dual dispatch cannot currently be
  //        modelled in OpenVADL.
  [size : 8]
  [consume : ROB, StoreOps]
  logic [reservation station] STU0_ISSUE_QUEUE

  [size : 8]
  [consume : ROB, StoreOps]
  logic [reservation station] STU1_ISSUE_QUEUE

  [size : 16]
  logic [load buffer] LOAD_QUEUE

  [size : 16]
  logic [store buffer] STORE_BUFFER



  //-------------------------------------------------------------------------//
  //                     Instruction Classes for Dispatch                    //
  //-------------------------------------------------------------------------//

  operation ALUOps = {}

  operation BranchOps = {}

  operation CSROps = {}

  operation LoadOps = {}

  operation StoreOps = {}

  operation ALU0Ops = { ALUOps, BranchOps, CSROps }

  operation ALU1Ops = { ALUOps, BranchOps }

  operation MemOps = { LoadOps, StoreOps }



  //-------------------------------------------------------------------------//
  //                           Execution Pipelines                           //
  //-------------------------------------------------------------------------//

  stage ALU0 -> Instruction = {
    let insn = consume(ALU0_ISSUE_QUEUE) in {
      // TODO: Your behaviour here :)
      ALU0 := insn
    }
  }

  stage ALU1 -> Instruction = {
    let insn = consume(ALU1_ISSUE_QUEUE) in {
      // TODO: Your behaviour here :)
      ALU1 := insn
    }
  }



  stage AGU0 -> Instruction = {
    let insn = consume(AGU0_ISSUE_QUEUE) in {
      // TODO: Your behaviour here :)
      AGU0 := insn
    }
  }

  stage AGU1 -> Instruction = {
    let insn = consume(AGU1_ISSUE_QUEUE) in {
      // TODO: Your behaviour here :)
      AGU1 := insn
    }
  }



  stage STU0 -> Instruction = {
    let insn = consume(STU0_ISSUE_QUEUE) in {
      // TODO: Your behaviour here :)
      STU0 := insn
    }
  }

  stage STU1 -> Instruction = {
    let insn = consume(STU1_ISSUE_QUEUE) in {
      // TODO: Your behaviour here :)
      STU1 := insn
    }
  }
}