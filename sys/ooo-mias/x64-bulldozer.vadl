// Description of the AMD Bulldozer Microarchitecture.
//
// Information used in modelling collected from:
// - Real World Tech's Bulldozer Microarchitecture writeup by David Kanter
//   (https://www.realworldtech.com/bulldozer)
micro architecture Bulldozer = {

  //-------------------------------------------------------------------------//
  //                             (Silly) Frontend                            //
  //-------------------------------------------------------------------------//

  stage FETCH -> FetchResult = {
    FETCH := fetchNext
  }

  stage DECODE -> Instruction = {
    DECODE := decode(consume(FETCH))
  }

  //-------------------------------------------------------------------------//
  //              Centralized Resources in the Execution Engine              //
  //-------------------------------------------------------------------------//

  // FIXME: The realwordtech article this is based on calls this a "retirement
  //        queue", not a reorder buffer. I think it's essentially the same
  //        thing, but I'm not sure.
  [size : 128]
  [controls : GP_PRF, FP_PRF]
  [consume : DECODE]
  logic [reorder buffer] ROB

  [size : 96]
  [renames : X]
  logic [physical register file] GP_PRF

  // FIXME: These 160 entries seem to be 128-bit wide, so they are effectively
  //        XMM and not YMM. This cannot currently be described in OpenVADL.
  [size : 160]
  [renames : YMM]
  logic [physical register file] FP_PRF

  [size : 40]
  [consume : ROB, GPOps]
  logic [reservation station] GP_SCHEDULER

  [size : 60]
  [consume : ROB, FPUAllOps]
  logic [reservation station] FP_SCHEDULER

  [size : 40]
  logic [load buffer] LoadBuffer

  [size : 24]
  logic [store buffer] StoreBuffer



  //-------------------------------------------------------------------------//
  //                     Instruction Classes for Dispatch                    //
  //-------------------------------------------------------------------------//

  operation ALUOps = {}

  operation IDIVOps = {}

  operation CountOps = {}

  operation IMULOps = {}

  operation BranchOps = {}

  operation VecOps = {}

  operation FMACOps = {}

  operation IMACOps = {}

  operation XBAROps = {}

  operation MMXOps = {}

  operation FSTOOps = {}

  operation AGUOps = {}



  operation FPU0Ops = { VecOps, FMACOps, IMACOps }

  operation FPU1Ops = { VecOps, FMACOps, XBAROps }

  operation FPU2Ops = { VecOps, MMXOps }

  operation FPU3Ops = { VecOps, MMXOps, FSTOOps }

  operation FPUAllOps = { FPU0Ops, FPU1Ops, FPU2Ops, FPU3Ops }

  operation ALU0Ops = { ALUOps, IDIVOps, CountOps }

  operation ALU1Ops = { ALUOps, IMULOps, BranchOps }

  operation GPOps = { ALU0Ops, ALU1Ops, AGUOps }



  //-------------------------------------------------------------------------//
  //                           Execution Pipelines                           //
  //-------------------------------------------------------------------------//

  stage FPU_0 -> Instruction = {
    let insn = consume(FP_SCHEDULER, FPU0Ops) in {
      // TODO: Your behaviour here :)
      FPU_0 := insn
    }
  }

  stage FPU_1 -> Instruction = {
    let insn = consume(FP_SCHEDULER, FPU1Ops) in {
      // TODO: Your behaviour here :)
      FPU_1 := insn
    }
  }

  stage FPU_2 -> Instruction = {
    let insn = consume(FP_SCHEDULER, FPU2Ops) in {
      // TODO: Your behaviour here :)
      FPU_2 := insn
    }
  }

  stage FPU_3 -> Instruction = {
    let insn = consume(FP_SCHEDULER, FPU3Ops) in {
      // TODO: Your behaviour here :)
      FPU_3 := insn
    }
  }

  stage ALU_0 -> Instruction = {
    let insn = consume(GP_SCHEDULER, ALU0Ops) in {
      // TODO: Your behaviour here :)
      ALU_0 := insn
    }
  }

  stage ALU_1 -> Instruction = {
    let insn = consume(GP_SCHEDULER, ALU1Ops) in {
      // TODO: Your behaviour here :)
      ALU_1 := insn
    }
  }

  stage AGU_0 -> Instruction = {
    let insn = consume(GP_SCHEDULER, AGUOps) in {
      insn.compute
      insn.write(LoadBuffer)
      insn.write(StoreBuffer)
      AGU_0 := insn
    }
  }

  stage AGU_1 -> Instruction = {
    let insn = consume(GP_SCHEDULER, AGUOps) in {
      insn.compute
      insn.write(LoadBuffer)
      insn.write(StoreBuffer)
      AGU_1 := insn
    }
  }
}
