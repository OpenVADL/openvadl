// A micro architectural description of the AMD Zen4 x86-64 architecture.
//
// Information used in modelling collected from:
// - LLVM's Zen4 scheduling model
//   (https://github.com/llvm/llvm-project/blob/main/llvm/lib/Target/X86/X86ScheduleZnver4.td)
// - ChipsAndCheese's "AMD's Zen 4 Part 1: Frontend and Execution Engine"
//   (https://chipsandcheese.com/p/amds-zen-4-part-1-frontend-and-execution-engine)
//
// This description currently mostly ignores the frontend and memory subsystem,
// instead focusing on the Zen4 execution engine.
// Dispatch for individual instructions is derived from the LLVM scheduling
// model without consulting the exact assignment `SchedWriteRes`s, meaning it
// is not necessarily 100% accurate, and certainly leaves some ambiguities.
// This can of course be fixed with sufficient effort.
// The execution pipes have also only been modelled as single stages with no
// real behaviour. The exact length of the pipes is not entirely clear to me.
micro architecture Zen4 implements x86_64 = {

  //-------------------------------------------------------------------------//
  //                             (Silly) Frontend                            //
  //-------------------------------------------------------------------------//

  stage FETCH -> FetchResult = {
    FETCH := fetchNext
  }

  stage DECODE -> Instruction = {
    DECODE := decode(consume(FETCH))
  }



  // Nice and big reorder buffer sitting at the very front of our execution engine.

  [size : 320]
  [controls : IntPRF, FlagsPRF, MaskPRF, VectorPRF]
  [consume : DECODE]
  logic [reorder buffer] ROB



  //-------------------------------------------------------------------------//
  //                         Integer Execution Engine                        //
  //-------------------------------------------------------------------------//

  operation GeneralAluOps = {}

  operation AguOps = {}

  operation ControlFlowOps = {}

  operation ConditionalOps = {}

  operation ComplexBitwiseOps = {}

  operation GeneralBitwiseOps = {}

  operation IntDivOps = {}

  operation IntMulOps = {}



  operation Alu0Ops = { GeneralAluOps, ControlFlowOps, ConditionalOps, IntDivOps }

  operation Alu1Ops = { GeneralAluOps, ComplexBitwiseOps, GeneralBitwiseOps, IntMulOps }

  operation Alu2Ops = { GeneralAluOps, GeneralBitwiseOps }

  operation Alu3Ops = { GeneralAluOps, ConditionalOps }

  operation IntSched0Ops = { Alu0Ops, AguOps }

  operation IntSched1Ops = { Alu1Ops, AguOps }

  operation IntSched2Ops = { Alu2Ops, AguOps }

  operation IntSched3Ops = { Alu3Ops, ControlFlowOps }



  [size : 224]
  [renames : X]
  logic [physical register file] IntPRF

  [size : 238]
  [renames : X.RFLAGS]
  logic [physical register file] FlagsPRF



  // ALU0, AGU0
  [size : 24]
  [consume : ROB, IntSched0Ops]
  logic [reservation station] IntSched0

  // ALU1, AGU1
  [size : 24]
  [consume : ROB, IntSched1Ops]
  logic [reservation station] IntSched1

  // ALU2, AGU2
  [size : 24]
  [consume : ROB, IntSched2Ops]
  logic [reservation station] IntSched2

  // ALU3, BRU1
  [size : 24]
  [consume : ROB, IntSched3Ops]
  logic [reservation station] IntSched3



  stage ALU0 -> Instruction = {
    let insn = consume(IntSched0, Alu0Ops) in {
      // TODO: Your behaviour here :)
      ALU0 := insn
    }
  }

  stage AGU0 -> Instruction = {
    let insn = consume(IntSched0, AguOps) in {
      // TODO: Your behaviour here :)
      AGU0 := insn
    }
  }

  stage ALU1 -> Instruction = {
    let insn = consume(IntSched1, Alu1Ops) in {
      // TODO: Your behaviour here :)
      ALU1 := insn
    }
  }

  stage AGU1 -> Instruction = {
    let insn = consume(IntSched1, AguOps) in {
      // TODO: Your behaviour here :)
      AGU1 := insn
    }
  }

  stage ALU2 -> Instruction = {
    let insn = consume(IntSched2, Alu2Ops) in {
      // TODO: Your behaviour here :)
      ALU2 := insn
    }
  }

  stage AGU2 -> Instruction = {
    let insn = consume(IntSched2, AguOps) in {
      // TODO: Your behaviour here :)
      AGU2 := insn
    }
  }

  stage ALU3 -> Instruction = {
    let insn = consume(IntSched3, Alu3Ops) in {
      // TODO: Your behaviour here :)
      ALU3 := insn
    }
  }

  stage BRU1 -> Instruction = {
    let insn = consume(IntSched3, ControlFlowOps) in {
      // TODO: Your behaviour here :)
      BRU1 := insn
    }
  }



  //-------------------------------------------------------------------------//
  //                      Vector and FP Execution Engine                     //
  //-------------------------------------------------------------------------//

  operation VFMulOps = {}

  operation VFMAOps = {}

  operation VFCompareOps = {}

  operation VFBlendOps = {}

  operation VFAddOps = {}

  // FIXME: AMD SOG Zen4, 2.11.1 Floating Point Execution Resources:
  //        > FDIV unit can support 2 simultaneous operations in flight
  //        > even though it occupies a single pipe.
  //        This cannot currently be modelled in OpenVADL.
  operation FDivOps = {}

  operation VMovOps = {}

  operation VLogicalOps = {}

  operation VIAddSubOps = {}

  operation VICompareOps = {}

  operation VIMulOps = {}

  operation VISADOps = {}

  operation VIBlendOps = {}

  operation VShuffleOps = {}

  operation VComplexShuffleOps = {}

  operation VBitShiftOps = {}

  operation VAESOps = {}

  operation VCLMOps = {}

  // FIXME: AMD SOG Zen4, 2.11 Floating-Point Unit:
  //        > Note that FP stores are supported on two pipelines,
  //        > but throughput is limited to one per cycle.
  //        This cannot currently be modelled in OpenVADL.
  operation VStoreOps = {}

  operation VFMovToGPROps = {}



  operation Fpu0Ops = { VFMulOps, VFMAOps, VFCompareOps, VFBlendOps, VMovOps, VLogicalOps, VIAddSubOps, VICompareOps, VIMulOps, VISADOps, VIBlendOps, VAESOps, VCLMOps }

  operation Fpu1Ops = { VFMulOps, VFMAOps, VFCompareOps, VFBlendOps, FDivOps, VMovOps, VLogicalOps, VIAddSubOps, VICompareOps, VShuffleOps, VBitShiftOps, VAESOps, VCLMOps }

  operation Fpu2Ops = { VFAddOps, VMovOps, VLogicalOps, VIAddSubOps, VICompareOps, VShuffleOps, VComplexShuffleOps, VBitShiftOps}

  operation Fpu3Ops = { VFAddOps, VMovOps, VLogicalOps, VIAddSubOps, VICompareOps, VIMulOps, VISADOps, VIBlendOps }

  operation Fpu4Or5Ops = { VStoreOps, VFMovToGPROps }

  operation VectorSched0Ops = { Fpu0Ops, Fpu2Ops, Fpu4Or5Ops }

  operation VectorSched1Ops = { Fpu1Ops, Fpu3Ops, Fpu4Or5Ops }

  operation VectorAllOps = { VectorSched0Ops, VectorSched1Ops }



  [size : 192]
  [renames : ZMM]
  logic [physical register file] VectorPRF

  [size : 68]
  [renames : K]
  logic [physical register file] MaskPRF

  [size : 64]
  [consume : ROB, VectorAllOps]
  logic [non scheduling queue] VectorQueue

  [size : 32]
  [consume : VectorQueue, VectorSched0Ops]
  logic [reservation station] VectorSched0

  [size : 32]
  [consume : VectorQueue, VectorSched1Ops]
  logic [reservation station] VectorSched1



  stage FPU0 -> Instruction = {
    let insn = consume(VectorSched0, Fpu0Ops) in {
      // TODO: Your behaviour here :)
      FPU0 := insn
    }
  }

  stage FPU1 -> Instruction = {
    let insn = consume(VectorSched1, Fpu1Ops) in {
      // TODO: Your behaviour here :)
      FPU1 := insn
    }
  }

  stage FPU2 -> Instruction = {
    let insn = consume(VectorSched0, Fpu2Ops) in {
      // TODO: Your behaviour here :)
      FPU2 := insn
    }
  }

  stage FPU3 -> Instruction = {
    let insn = consume(VectorSched1, Fpu3Ops) in {
      // TODO: Your behaviour here :)
      FPU3 := insn
    }
  }

  stage FPU4 -> Instruction = {
    let insn = consume(VectorSched0, Fpu4Or5Ops) in {
      // TODO: Your behaviour here :)
      FPU4 := insn
    }
  }

  stage FPU5 -> Instruction = {
    let insn = consume(VectorSched1, Fpu4Or5Ops) in {
      // TODO: Your behaviour here :)
      FPU5 := insn
    }
  }



  //-------------------------------------------------------------------------//
  //                           Load / Store Engine                           //
  //-------------------------------------------------------------------------//

  [size : 72]
  logic [load buffer] LoadQueue

  [size : 64]
  logic [store buffer] StoreQueue

  // FIXME: AMD SOG Zen4, 2.12 Load-Store Unit:
  //        > The LS unit contains three largely independent pipe-lines
  //        > enabling the execution of three 256-bit memory operations per
  //        > cycle.
  //        > All three memory operations can be loads.
  //        > A maximum of two of the memory operations can be stores.
  //        Declaring these as stages, with one of them only able to perform
  //        reads and not writes seems somewhat natural here. However, it's not
  //        at all clear where they consume their instructions from, seeing
  //        that these happen *after* the ROB has put everything in-order
  //        again, and after the relatively strict x86-64 memory model's
  //        semantics have been ensured.
  //        Maybe it would make sense to have instructions `retire`, thus
  //        putting them back in the ROB as completed. stages that depend on
  //        such `retire`d instructions would then have to wait until the ROB
  //        actually committed the instructions.
  //        The main problem with this is that the non-pipeline behaviour in
  //        such a stage-on-stage dependency would be super-unclear, only
  //        surfacing once the `insn.retire` command in the consumed stage is
  //        noticed.
  //        Oh, and it might not be what HW actually does. Oh well.
  stage LoadStore0 -> Instruction = {
    let insn = consume(TODO) in {
      insn.read(LoadQueue)
      insn.write(StoreQueue)
      LoadStore0 := insn
    }
  }

  stage LoadStore1 -> Instruction = {
    let insn = consume(TODO) in {
      insn.read(LoadQueue)
      insn.write(StoreQueue)
      LoadStore1 := insn
    }
  }

  stage Load2 -> Instruction = {
    let insn = consume(TODO) in {
      insn.read(LoadQueue)
      Load2 := insn
    }
  }
}
