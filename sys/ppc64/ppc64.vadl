instruction set architecture PPC64 = {

  constant mask32  : Bits<64> = 0x0000'0000'FFFF'FFFF      // mask for lower 32-bits

  constant minS32  : Bits<32> = 0x8000'0000                // smallest 32-bit signed value
  constant maxS32  : Bits<32> = 0x7FFF'FFFF                // largest 32-bit signed value
  constant minS32E : Bits<64> = 0xFFFF'FFFF'8000'0000      // smallest 32-bit signed value sign extended to 64 bits
  constant maxS32E : Bits<64> = 0x0000'0000'7FFF'FFFF      // largest 32-bit signed value sign extended to 64 bits
  constant minS64  : Bits<64> = 0x8000'0000'0000'0000      // smallest 64-bit signed value
  constant maxS64  : Bits<64> = 0x7FFF'FFFF'FFFF'FFFF      // largest 64-bit signed value

  using Nibble = Bits<4>
  using Byte   = Bits<8>
  using Half   = Bits<16>
  using Word   = Bits<32>
  using DWord  = Bits<64>
  using SByte  = SInt<8>
  using SHalf  = SInt<16>
  using SWord  = SInt<32>
  using SDWord = SInt<64>
  using UByte  = UInt<8>
  using UHalf  = UInt<16>
  using UWord  = UInt<32>
  using UDWord = UInt<64>

  using GPRIndex    = Bits<5>                    // general purpose register index
  using SPRIndex    = Bits<10>                   // special purpose register index
  using CRFIndex    = Bits<3>                    // condition register field index
  using CRBIndex    = Bits<5>                    // condition register bit index
  using Reg         = DWord                      // 64-bit register
  using ExReg       = Word                       // 32-bit exception/ status register
  using Address     = DWord                      // 64-bit address, top 32-bits are always zero in 32-bit Mode
  using Instruction = Word                       // 32-bit instruction, prefixed instructions are not supported

  using OpCode      = Bits<6>
  using Ext8        = Bits<8>
  using Ext9        = Bits<9>
  using Ext10       = Bits<10>

  program counter PC  : Address
  memory          MEM : Address -> Byte

  // TODO: needs relational alias
  register CR  : CRFIndex -> CRField             // 8x4-bit condition register fields
  register CRB : CRBIndex -> Bits<1>             // alias for condition register to access single bits
  //alias register CRB : CRBIndex -> Bit = CR

  register GPR  : GPRIndex -> Reg                // 32x64-bit general purpose registers
  [zero : GPRZ(0)]
  alias register GPRZ = GPR                      // alias for general purpose registers where GPR(0) is always 0

  register XER  : XERFormat                      // exception/ status register
  register LR   : Reg                            // link register
  register CTR  : Reg                            // count register
  register TB   : Reg                            // time base register
  register TAR  : Reg                            // target address register
  register SRR0 : Reg                            // machine status save/ restore register 1
  register SRR1 : Reg                            // machine status save/ restore register 2

  register MSR : MSRFormat                       // machine state register

  enumeration Mode : Bits<1> =                   // computation modes, M32 = 32-bit mode
  { M32
  , M64
  }

  enumeration Unit : Bits<2> =
  { Byte
  , Half
  , Word
  }

  enumeration Flags : Bits<2> =                  // specifies which flags the SetXER macro should set. OV = overflow, CA = carry
  { OVCA
  , OV
  , CA
  , NONE
  }

  format CRField : Nibble =
  { lt [3]                                       // result < 0 or operand1 < operand2
  , gt [2]                                       // result > 0 or operand1 > operand2
  , eq [1]                                       // result = 0 or operand1 = operand2
  , so [0]                                       // usually a copy of XER.so
  }

  format XERFormat : Reg =
  { rsv1   : Word
  , so     : Bits<1>                             // summary overflow, is set whenever ov is set: so = so | ov
  , ov     : Bits<1>                             // overflow, is equal to ov32 in 32-bit mode
  , ca     : Bits<1>                             // carry, is equal to ca32 in 32-bit mode
  , rsv2   : Bits<9>
  , ov32   : Bits<1>                             // overflow32, overflow when using 32-bit operands
  , ca32   : Bits<1>                             // carry32, carry when using 32-bit operands
  , rsv3   : Bits<11>
  , nbytes : Bits<7>                             // number of bytes to be transferred by string indexed instructions (not implemented)
  }

  // note: most of the functionality here is not implemented, because it is not a part of the subset
  format MSRFormat : Reg =
  { sf   : Bits<1>                               // [s]ixty-[f]our bit, if set the processor is in 64-bit Mode
  , rsv1 : Bits<2>
  , hv   : Bits<1>                               // together with pr defines the privilege state of the processor (not implemented)
  , rsv2 : Bits<1>
  , idk  : Bits<1>                               // this bit must be 0 or all instructions are boundedly undefined (not implemented)
  , rsv3 : Word
  , vec  : Bits<1>                               // if set the thread can execute vector instructions (not implemented)
  , rsv4 : Bits<1>
  , vsx  : Bits<1>                               // if set the thread can execute VSX instructions (not implemented)
  , s    : Bits<1>                               // if set the thread is in secure state (not implemented)
  , rsv5 : Bits<6>
  , ee   : Bits<1>                               // if set additional interrupts are enabled (not implemented)
  , pr   : Bits<1>                               // together with hv defines the privilege state of the processor
  , fp   : Bits<1>  	                           // if set the thread can execute floating-point instructions (not implemented)
  , me   : Bits<1>                               // if set machine check interrupts are enabled (not implemented)
  , fe0  : Bits<1>                               // floating-point exception mode bit 1 (not implemented)
  , te   : Bits<2>                               // controls branch tracing (not implemented)
  , fe1  : Bits<1>                               // floating-point exception mode bit 2 (not implemented)
  , rsv6 : Bits<2>
  , ir   : Bits<1>                               // if set instruction address translation is enabled (not implemented)
  , dr   : Bits<1>                               // if set data address translation is enabled (not implemented)
  , rsv7 : Bits<1>
  , pmm  : Bits<1>                               // this bit is used by the performance monitoring facility (not implemented)
  , ri   : Bits<1>                               // if set interrupt is recoverable (not implemented)
  , le   : Bits<1>                               // if set the thread is in little endian mode (not implemented)
  }

  // TODO?: zero hint bits in branch instr
  format BForm : Instruction =
  { opcd : OpCode                                // opcode
  , bo   : Bits<5>                               // branch options and hints
  , crbs : CRBIndex                              // CR bit to test
  , bd   : Bits<14>                              // part of the branch address
  , aa   : Bits<1>                               // if set the branch address is absolute
  , lk   : Bits<1>                               // if set the link register is set to PC.next
  , extBd = bd as SDWord << 2
  }

  format DFormA : Instruction =
  { opcd   : OpCode                              // opcode
  , rs     : GPRIndex                            // store: source register, other: target register
  , ra     : GPRIndex                            // source register
  , imm    : Half                                // immediate value
  , immU   = imm as UDWord                       // immediate value zero extended to 64 bits
  , immS   = imm as SDWord                       // immediate value sign extended to 64 bits
  , shImmU = imm as UDWord << 16                 // immediate value zero extended to 64 bits and shifted
  , shImmS = imm as SDWord << 16                 // immediate value sign extended to 64 bits and shifted
  }

  format DFormB : Instruction =
  { opcd : OpCode                                // opcode
  , crt  : CRFIndex                              // target CR field
  , rsv  : Bits<1>
  , l    : Bits<1>                               // if set the instruction uses 64-bit operands
  , rs   : GPRIndex                              // source register
  , imm  : Half                                  // immediate value
  }

  format DFormC : Instruction =
  { opcd   : OpCode                              // opcode
  , to     : Bits<5>                             // selects trap condition(s)
  , rs     : GPRIndex                            // source register
  , imm    : Half                                // immediate value
  , immS   = imm as SDWord                       // immediate value sign extended to 64 bits
  }

  format DXForm : Instruction =
  { opcd [31..26]           : OpCode             // opcode
  , rs   [25..21]           : GPRIndex           // target register
  , imm  [15..6, 20..16, 0] : Half               // immediate value
  , rsv  [5..1]             : Bits<5>
  , shImmS = imm as SDWord << 16                 // immediate value sign extended to 64 bits and shifted
  }

  format IForm : Instruction =
  { opcd : OpCode                                // opcode
  , li   : Bits<24>                              // part of the branch address
  , aa   : Bits<1>                               // if set the branch address is absolute
  , lk   : Bits<1>                               // if set the link register is set to PC.next
  , extLi = li as SDWord << 2                    // branch target address base
  }

  format MForm : Instruction =
  { opcd : OpCode                                // opcode
  , rs   : GPRIndex                              // source register
  , ra   : GPRIndex                              // target register
  , sh   : Bits<5>                               // source register/ immediate value
  , mb   : Bits<5>                               // start index of bit mask
  , me   : Bits<5>                               // end index of bit mask
  , rc   : Bits<1>                               // if set the instruction modifies the CR
  , mb6  = mb as Bits<6>
  , me6  = me as Bits<6>
  }

  format SCForm : Instruction = 
  { opcd    : OpCode                             // opcode
  , rsv1    : Bits<14>
  , lev     : Bits<7>                            // defines change to privilege level
  , rsv2    : Bits<3>
  , extopcd : Bits<2>                            // extended opcode
  }

  format XFormA : Instruction =
  { opcd    : OpCode                             // opcode
  , rs      : GPRIndex                           // source/ target register
  , ra      : GPRIndex                           // source/ target register
  , rb      : GPRIndex                           // source register/ immediate value
  , extopcd : Ext10                              // extended opcode
  , rc      : Bits<1>                            // if set the instruction modifies the CR
  }

  format XFormB : Instruction =
  { opcd    : OpCode                             // opcode
  , crt     : CRFIndex                           // target CR field
  , rsv1    : Bits<1>
  , l       : Bits<1>                            // if set the instruction uses 64-bit operands
  , ra      : GPRIndex                           // source register
  , rb      : GPRIndex                           // source register
  , extopcd : Ext10                              // extended opcode
  , rsv2    : Bits<1>
  }

  format XFormC : Instruction =
  { opcd    : OpCode                             // opcode
  , rs      : GPRIndex                           // target register
  , crs     : CRFIndex                           // source CR field
  , rsv1    : Bits<7>
  , extopcd : Ext10                              // extended opcode
  , rsv2    : Bits<1>
  }

  format XFormD : Instruction =
  { opcd    : OpCode                             // opcode
  , rs      : GPRIndex                           // target register
  , crbs    : CRBIndex                           // source CR bit
  , rsv1    : Bits<5>
  , extopcd : Ext10                              // extended opcode
  , rsv2    : Bits<1>
  }

  format XFormE : Instruction =
  { opcd    : OpCode                             // opcode
  , crt     : CRFIndex                           // target CR field
  , rsv1    : Bits<2> 
  , ra      : GPRIndex                           // source register
  , rb      : GPRIndex                           // source register
  , extopcd : Ext10                              // extended opcode
  , rsv2    : Bits<1>
  }

  format XFormF : Instruction =
  { opcd    : OpCode                             // opcode
  , rs      : GPRIndex                           // source register
  , rsv1    : Nibble
  , l       : Bits<1>                            // changes which bits of MSR are set
  , rsv2    : Bits<5>
  , extopcd : Ext10                              // extended opcode
  , rsv3    : Bits<1>
  }

  format XFormG : Instruction =
  { opcd    : OpCode                             // opcode
  , to      : Bits<5>                            // selects trap condition(s)
  , ra      : GPRIndex                           // source register
  , rb      : GPRIndex                           // source register
  , extopcd : Ext10                              // extended opcode
  , rsv     : Bits<1>
  }

  format XFXFormA : Instruction =
  { opcd    : OpCode                             // opcode
  , rs      : GPRIndex                           // source/ target register
  , m       : Bits<1>                            // if set the instruction only reads from/ writes to a single CR field
  , fxm     : Bits<8>                            // CR field mask
  , rsv1    : Bits<1>
  , extopcd : Ext10                              // extended opcode
  , rsv2    : Bits<1>
  }

  format XFXFormB : Instruction =
  { opcd    : OpCode                             // opcode
  , rs      : GPRIndex                           // source/ target register
  , spr     : SPRIndex                           // source/ target special purpose register
  , extopcd : Ext10                              // extended opcode
  , rsv     : Bits<1>
  }

  format XLFormA : Instruction =
  { opcd    : OpCode                             // opcode
  , crbt    : CRBIndex                           // target CR bit
  , crbs1   : CRBIndex                           // source CR bit
  , crbs2   : CRBIndex                           // source CR bit
  , extopcd : Ext10                              // extended opcode
  , rsv     : Bits<1>
  }

  format XLFormB : Instruction =
  { opcd    : OpCode                             // opcode
  , bo      : Bits<5>                            // branch options and hints
  , crbs    : CRBIndex                           // CR bit to test
  , rsv     : Bits<3>
  , bh      : Bits<2>                            // branch return hints
  , extopcd : Ext10                              // extended opcode
  , lk      : Bits<1>                            // if set the link register is set to PC.next
  }

  format XLFormC : Instruction = 
  { opcd : OpCode                                // opcode
  , crt  : CRFIndex                              // target CR field
  , rsv1 : Bits<2>
  , crs  : CRFIndex                              // source CR field
  , rsv2 : Bits<18>
  }

  format XOForm : Instruction =
  { opcd    : OpCode                             // opcode
  , rs      : GPRIndex                           // target register
  , ra      : GPRIndex                           // source register
  , rb      : GPRIndex                           // source register
  , oe      : Bits<1>                            // if set the instruction modifies so, ov and ov32
  , extopcd : Ext9                               // extended opcode
  , rc      : Bits<1>                            // if set the instruction modifies the CR
  }

  format Z23Form : Instruction =
  { opcd    : OpCode                             // opcode
  , rs      : GPRIndex                           // target register
  , ra      : GPRIndex                           // source register
  , rb      : GPRIndex                           // source register
  , cy      : Bits<2>                            // all values other than 0b00 are reserved
  , extopcd : Ext8                               // extended opcode
  , rsv     : Bits<1>
  }

  record IdOp        (id : Id, op : SymEx)
  record IdExt       (id : Id, ext : Bin)
  record IdOpcd      (id : Id, opcd : Bin)
  record IdOpExt     (id : Id, op : SymEx, ext : Bin)
  record IdOpOpcd    (id : Id, op : SymEx, opcd : Bin)
  record IdOpcdExt   (id : Id, opcd : Bin, ext : Bin)
  record IdStrOpOpcd (id : Id, str : Str, op : SymEx, opcd : Bin)   // required for addic and addic.
  record TwoArgs     (arg1 : Ex, arg2 : Ex)

  function oStr (o : Bool) -> String = if o then "O" else ""        // indicates that a instruction modifies the overflow bits
  function rStr (r : Bool) -> String = if r then "." else ""        // indicates that a instruction modifies the condition register
  function lStr (l : Bool) -> String = if l then "L" else ""        // indicates that a instruction modifies the link register
  function aStr (a : Bool) -> String = if a then "A" else ""        // indicates that a branch instruction uses absolute addressing

  function nand1 (a : Bool, b : Bool) -> Bool = ~(a & b)
  function nor1  (a : Bool, b : Bool) -> Bool = ~(a | b)
  function nxor1 (a : Bool, b : Bool) -> Bool = ~(a ^ b)

  function nand64 (a : DWord, b : DWord) -> DWord = ~(a & b)
  function nor64  (a : DWord, b : DWord) -> DWord = ~(a | b)
  function nxor64 (a : DWord, b : DWord) -> DWord = ~(a ^ b)

  // converts overflow and carry booleans to flags enumeration
  function toflags (sov : Bool, sca : Bool) -> Bits<2> = 
    if sov then if sca then Flags::OVCA else Flags::OV
           else if sca then Flags::CA   else Flags::NONE

  // converts lev field to 2-bit SRR representation
  function srrlev (lev : Bits<7>) -> Bits<2> =
    match lev with 
    { 1 as Bits<7> => 1 as Bits<2>
    , 2 as Bits<7> => 2 as Bits<2>
    , _            => 0 as Bits<2>
    }

  // converts binary coded decimal to declet
  function bcdtodpd (n : Bits<12>) -> Bits<10> = 
    ( (n(6) & n(11) & n(3) & ~n(7)) | (n(2) & n(11) & ~n(3)) | (n(10) & ~n(11))
    , (n(5) & n(11) & n(3) & ~n(7)) | (n(1) & n(11) & ~n(3)) | (n(9) & ~n(11))
    , n(8)
    , (n(2) & ~n(11) & n(7) & ~n(3)) | (n(6) & ~n(3) & ~n(7)) | (n(6) & ~n(11) & ~n(7)) | (n(7) & n(3))
    , (n(1) & ~n(11) & n(7) & ~n(3)) | (n(5) & ~n(3) & ~n(7)) | (n(5) & ~n(11) & ~n(7)) | (n(11) & n(3))
    , n(4)
    , n(11) | n(7) | n(3)
    , (~n(7) & n(2) & ~n(3)) | (n(7) & n(3)) | n(11)
    , (~n(11) & n(1) & ~n(3)) | (n(11) & n(3)) | n(7)
    , n(0)
    )

  // converts declet to binary coded decimal
  function dpdtobcd (n : Bits<10>) -> Bits<12> = 
    ( (~n(6) & n(3) & n(2)) | (n(5) & n(3) & n(2) & n(6)) | (n(3) & n(2) & ~n(1))
    , (n(9) & n(6) & n(1) & ~n(5)) | (n(9) & ~n(2)) | (n(9) & ~n(3))
    , (n(8) & n(6) & n(1) & ~n(5)) | (n(8) & ~n(2)) | (n(8) & ~n(3))
    , n(7)
    , (n(3) & ~n(2) & n(1)) | (n(6) & n(3) & n(2) & n(1)) | (~n(5) & n(3) & n(1) & n(2))
    , (n(9) & n(5) & n(3) & n(2) & n(1) & ~n(6)) | (n(6) & ~n(1) & n(3)) | (n(6) & ~n(3))
    , (n(8) & n(5) & n(2) & n(3) & n(1) & ~n(6)) | (n(5) & ~n(1) & n(3)) | (n(5) & ~n(3))
    , n(4)
    , (n(5) & n(3) & n(2) & n(1)) | (n(6) & n(3) & n(2) & n(1)) | (n(3) & ~n(2) & ~n(1))
    , (n(9) & ~n(6) & ~n(5) & n(2) & n(3)) | (n(6) & n(3) & ~n(2) & n(1)) | (n(9) & n(2) & ~n(1) & n(3)) | (n(2) & ~n(3))
    , (n(8) & ~n(6) & ~n(5) & n(3) & n(2)) | (n(5) & n(3) & ~n(2) & n(1)) | (n(8) & n(3) & n(2) & ~n(1)) | (n(1) & ~n(3))
    , n(0)
    )

  // reverses the byte order of each halfword in a word
  function byterevhinw (n : Word) -> Word =
    (n(23..16), n(31..24), n(7..0), n(15..8))
  
  // reverses the byte order of a word
  function byterevw (n : Word) -> Word =
    (n(7..0), n(15..8), n(23..16), n(31..24))

  // generates a wrapping 64-bit mask
  // needs forall
  function mask (start : Bits<6>, end : Bits<6>) -> DWord =
    maxS64
    //if VADL::ulth(start, end) then
    //  forall i in 0..63 tensor if VADL::ugeq(i, start) && VADL::uleq(i, end) then 0b1 else 0b0
    //else
    //  forall i in 0..63 tensor if VADL::ugeq(i, start) || VADL::uleq(i, end) then 0b1 else 0b0

  // triggered by the tw and twi instructions if at least one trap condition evaluates to true
  exception Trap () = {
    SRR0 := PC
    SRR1 := (MSR(63..31), 0 as Bits<4>, MSR(26..22), 0 as Bits<4>, 1 as Bits<1>, 0 as Bits<1>, MSR(15..0))
    PC   := 0x0000'0000'0000'0700
  }

  // triggered when a privileged instruction gets called in an unprivileged processor state
  exception Privilege () = {
    SRR0 := PC
    SRR1 := (MSR(63..31), 0 as Bits<4>, MSR(26..22), 0 as Bits<3>, 1 as Bits<1>, 0 as Bits<2>, MSR(15..0))
    PC   := 0x0000'0000'0000'0700
  }

  // TODO?: complete exception
  // note: named hypervisor emulation assistance interrupt in PowerPC specification, not implemented
  // triggered by an illegal instruction format
  exception Illegal () = {}

  // triggered by a system call instruction
  exception SysCall (lev : Bits<7>) = {
    SRR0 := PC.next
    SRR1 := (MSR(63..31), 0 as Bits<4>, MSR(26..22), srrlev(lev), 0 as Bits<4>, MSR(15..0))
    PC   := 0x0000'0000'0000'0C00
  }

  // triggered by a system call vectored instruction
  exception SysCallVectored () = {
    LR  := PC.next
    CTR := (MSR(63..31), 0 as Bits<4>, MSR(26..22), 0 as Bits<6>, MSR(15..0))
    PC   := 0x0000'0000'0001'0700
  }

  // CR access functions, inverted to match powerpc conventions
  model CRField (index : Ex) : Ex = { CR(7 - $index) }
  model CRBit (index : Ex) : Ex = { CRB(31 - $index) }

  model SetCRType (dst : Ex, a : TwoArgs, type : Id) : Stat = {
    $CRField($dst) := ($a.arg1 as $type < $a.arg2 as $type, $a.arg1 as $type > $a.arg2 as $type, $a.arg1 as $type = $a.arg2 as $type, XER.so)
  }

  // sets the CR field 0 based on signed comparison of the result to zero
  model SetCR0 (result : Id) : Stat = {
    if MSR.sf = Mode::M32 then $SetCRType(0; ($result; 0); SWord )
                          else $SetCRType(0; ($result; 0); SDWord)
  }

  // sets the CR field 0 based on signed comparison between two arguments
  model SetCRCmp (a : TwoArgs, logical : Bool) : Stat = {
    if $logical
    then if l = Mode::M32 then $SetCRType(crt; $a; UWord) else $SetCRType(crt; $a; UDWord)
    else if l = Mode::M32 then $SetCRType(crt; $a; SWord) else $SetCRType(crt; $a; SDWord)
  }

  // sets fixed-point exception register
  model SetXER (flags : Ex) : Stat = {
    let mov = if MSR.sf = Mode::M32 then flags32.overflow else flags64.overflow in
      let mca = if MSR.sf = Mode::M32 then flags32.carry else flags64.carry in
        match $flags with 
        { Flags::OVCA => XER := (XER.rsv1, XER.so | mov, mov   , mca   , XER.rsv2, flags32.overflow, flags32.carry, XER.rsv3, XER.nbytes)
        , Flags::OV   => XER := (XER.rsv1, XER.so | mov, mov   , XER.ca, XER.rsv2, flags32.overflow, XER.ca32     , XER.rsv3, XER.nbytes)
        , Flags::CA   => XER := (XER.rsv1, XER.so      , XER.ov, mca   , XER.rsv2, XER.ov32        , flags32.carry, XER.rsv3, XER.nbytes)
        , _ => {}
        }
  }

  // read value from special purpose register to GPR(rs)
  model ReadSPR () : Stat = {
    let rspr = (spr(4..0), spr(9..5)) in
      match rspr with 
      { 0b00000'00001 => GPR(rs) := XER
      , 0b00000'01000 => GPR(rs) := LR
      , 0b00000'01001 => GPR(rs) := CTR
      , 0b01000'01100 => GPR(rs) := TB
      , 0b01000'01101 => GPR(rs) := TB(63..32) as UDWord
      , 0b11001'01000 => {}
      , 0b11001'01001 => {}
      , 0b11001'01010 => {}
      , 0b11001'01011 => {}
      , 0b11001'01111 => GPR(rs) := TAR
      , _ => if spr(9) = 0b0 then raise Illegal
                             else raise Privilege
      }
  }

  // writes value from GPR(rs) to special purpose register
  model WriteSPR () : Stat = {
    let rspr = (spr(4..0), spr(9..5)) in
      match rspr with 
      { 0b00000'00001 => XER := GPR(rs)
      , 0b00000'01000 => LR  := GPR(rs) 
      , 0b00000'01001 => CTR := GPR(rs)
      , 0b11001'01000 => {}
      , 0b11001'01001 => {}
      , 0b11001'01010 => {}
      , 0b11001'01011 => {}
      , 0b11001'01111 => TAR := GPR(rs) 
      , _ => if spr(9) = 0b0 then raise Illegal
                             else raise Privilege
      }
  }

  // reads Byte/ Halfword/ Word from memory into GPR(dst)
  model ReadMem (ea : Id, unit : SymEx, dst : Ex, rev : Bool, type : Id) : Stat = {
    match : Stat
    ( $unit = Unit::Word => if $rev
                            then GPR($dst) := ((MEM($ea + 3) as Word << 24) + (MEM($ea + 2) as Word << 16) +
                                              (MEM($ea + 1) as Word << 8) + (MEM($ea) as Word)) as $type
                            else GPR($dst) := MEM<4>($ea) as $type
    ; $unit = Unit::Half => if $rev
                            then GPR($dst) := ((MEM($ea + 1) as Half << 8) + (MEM($ea) as Half)) as $type
                            else GPR($dst) := MEM<2>($ea) as $type
    ; _ => GPR($dst) := MEM($ea) as $type
    )
  }

  // writes Byte/ Halfword/ Word from GPR(src) into memory
  model WriteMem (ea : Id, unit : SymEx, src : Id, rev : Bool) : Stat = {
    match : Stat
    ( $unit = Unit::Word => if $rev
                            then MEM<4>($ea) := (GPR($src)(7..0), GPR($src)(15..8), GPR($src)(23..16), GPR($src)(31..24))
                            else MEM<4>($ea) := GPR($src)(31..0)
    ; $unit = Unit::Half => if $rev
                            then MEM<2>($ea) := (GPR($src)(7..0), GPR($src)(15..8))
                            else MEM<2>($ea) := GPR($src)(15..0)
    ; _ => MEM($ea) := GPR($src)(7..0)
    )
  }

  // computes the target address for b and bc instructions
  model TargetAddrImm (imm : Id) : Ex = {
    let ta = if aa then $imm else PC + $imm in 
      if MSR.sf = Mode::M32 then ta & mask32 else ta
  }

  // computes the target address for bclr, bcctr and bctar instructions
  model TargetAddrReg (reg : Id) : Ex = {
    let ta = $reg(63..2) as UDWord << 2 in
      if MSR.sf = Mode::M32 then ta & mask32 else ta
  }

  // instructions: bc[l][a]
  model BFormBranchInstr (id : Id) : IsaDefs = {
    instruction $id : BForm = { 
      if lk then LR := PC.next
      if ~bo(2) then CTR := CTR - 1
      let mctr = if MSR.sf = Mode::M32 then CTR & mask32 else CTR in
        if (bo(2) | ((mctr != 0) ^ bo(1))) & (bo(4) | ($CRBit(crbs) = bo(3))) then
          PC := $TargetAddrImm(extBd)
    } 
    encoding $id = {opcd = 0b010000}
    assembly $id = (AsStr($id), lStr(lk), aStr(aa), " ", decimal(bo), ",", decimal(crbs), ",", decimal($TargetAddrImm(extBd)))
  }

  // instructions: addi, addic, addic., addis, subfic  
  model DFormAddSubInstr (x : IdStrOpOpcd, a : TwoArgs, logcr : Bool, logca : Bool) : IsaDefs = {
    instruction $x.id : DFormA =
      let result32, flags32 = VADL::$x.op($a.arg1 as SWord, $a.arg2 as SWord) in
        let result64, flags64 = VADL::$x.op($a.arg1 as SDWord, $a.arg2 as SDWord) in {
          GPR(rs) := result64
          if $logca then $SetXER(Flags::CA)
          if $logcr then $SetCR0(result64)
        }
    encoding $x.id = {opcd = $x.opcd}
    assembly $x.id = ($x.str, rStr($logcr), " ", decimal(rs), ",", decimal(ra), ",", decimal(imm))
  }

  // instructions: andi., andis., ori, oris, xori, xoris
  model DFormLogicalInstr (x : IdOpOpcd, arg2 : Id, logcr : Bool) : IsaDefs = {
    instruction $x.id : DFormA =
      let result = VADL::$x.op(GPR(ra), $arg2) in {
        GPR(rs) := result
        if $logcr then $SetCR0(result)
      }
    encoding $x.id = {opcd = $x.opcd}
    assembly $x.id = (AsStr($x.id), rStr($logcr), " ", decimal(rs), ",", decimal(ra), ",", decimal(imm))
  }

  // instructions: lbz, lbzu, lha, lhau, lhz, lhzu, lwz, lwzu
  model DFormLoadInstr (x : IdOpcd, unit : SymEx, update : Bool, type : Id) : IsaDefs = {
    [undefined when : $update && (ra = 0 || ra = rs)]
    instruction $x.id : DFormA =
      let ea = GPRZ(ra) + immS in
        let mea = if MSR.sf = Mode::M32 then ea & mask32 else ea in {
          $ReadMem(mea; $unit; rs; false; $type)
          if $update then GPR(ra) := ea
        }
    encoding $x.id = {opcd = $x.opcd}
    assembly $x.id = (AsStr($x.id), " ", decimal(rs), ",", decimal(imm), "(", decimal(ra), ")")
  }

  // instructions: mulli
  model DFormMulInstr (id : Id) : IsaDefs = {
    instruction $id : DFormA =
      GPR(rs) := GPR(ra) * immS
    encoding $id = {opcd = 0b000111}
    assembly $id = (AsStr($id), " ", decimal(rs), ",", decimal(ra), ",", decimal(imm))
  }

  // instructions: stb, stbu, sth, sthu, stw, stwu
  model DFormStoreInstr (x : IdOpcd, unit : SymEx, update : Bool) : IsaDefs = {
    [undefined when : $update && ra = 0]
    instruction $x.id : DFormA =
      let ea = GPRZ(ra) + immS in
        let mea = if MSR.sf = Mode::M32 then ea & mask32 else ea in {
          $WriteMem(mea; $unit; rs; false)
          if $update then GPR(ra) := ea
        }
    encoding $x.id = {opcd = $x.opcd}
    assembly $x.id = (AsStr($x.id), " ", decimal(rs), ",", decimal(imm), "(", decimal(ra), ")")
  }

  // instructions: cmpi, cmpli
  model DFormCmpInstr (x : IdOpcd, logical : Bool) : IsaDefs = {
    instruction $x.id : DFormB =
      $SetCRCmp((GPR(rs); imm); $logical)
    encoding $x.id = {opcd = $x.opcd, rsv = 0b0}
    assembly $x.id = (AsStr($x.id), " ", decimal(crt), ",", decimal(l), ",", decimal(rs), ",", decimal(imm))
  }

  // instructions: twi
  model DFormTrapInstr (id : Id) : IsaDefs = {
    instruction $id : DFormC =
      let a = GPR(rs)(31..0) as SDWord in
        if ((VADL::slth(a, immS)) & to(4)) | ((VADL::sgth(a, immS)) & to(3)) |
           ((a = immS)            & to(2)) | ((VADL::ulth(a, immS)) & to(1)) |
           ((VADL::ugth(a, immS)) & to(0)) then
          raise Trap
    encoding $id = {opcd = 0b000011}
    assembly $id = (AsStr($id), " ", decimal(to), ",", decimal(rs), ",", decimal(imm))
  }

  // instructions: addpcis
  model DXFormAddInstr (id : Id) : IsaDefs = {
    instruction $id : DXForm =
      GPR(rs) := PC.next + shImmS
    encoding $id = {opcd = 0b010011, rsv = 0b00010}
    assembly $id = (AsStr($id), " ", decimal(rs), ",", decimal(imm))
  }

  // instructions: b[l][a]
  model IFormBranchInstr (id : Id) : IsaDefs = {
    instruction $id : IForm = { 
      if lk then LR := PC.next
      PC := $TargetAddrImm(extLi)
    } 
    encoding $id = {opcd = 0b010010}
    assembly $id = (AsStr($id), lStr(lk), aStr(aa), " ", decimal($TargetAddrImm(extLi)))
  }

  // instructions: rlwimi[.], rlwinm[.], rlwnm[.]
  model MFormRotateInstr (x : IdOpcd, rotsrc : Ex, res : Ex) : IsaDefs = {
    instruction $x.id : MForm =
      let r = VADL::ror(GPR(rs)(31..0), $rotsrc) as UDWord in
        let m = mask (mb6 + 32, me6 + 32) in
          let result = $res in {
            GPR(ra) := result
            if rc then $SetCR0(result)
          }
    encoding $x.id = {opcd = $x.opcd}
    assembly $x.id = (AsStr($x.id), rStr(rc), " ", decimal(ra), ",", decimal(rs), ",", decimal(sh), ",", decimal(mb), ",", decimal(me))
  }

  // instructions: sc, scv
  model SCFormSysCallInstr (x : IdExt, ex : CallEx) : IsaDefs = {
    instruction $x.id : SCForm = raise $ex
    encoding $x.id = {opcd = 0b010001, rsv1 = 0b00000'00000'0000, rsv2 = 0b000, extopcd = $x.ext}
    assembly $x.id = (AsStr($x.id), " ", decimal(lev))
  }

  // instructions: sraw[.], srawi[.]
  model XFormArithmeticShiftInstr (x : IdExt, shiftsrc : Ex) : IsaDefs = {
    instruction $x.id : XFormA =
      let r = VADL::asr((GPR(rs)(31..0), 0 as UWord), $shiftsrc) in 
        let result = r(63..32) as SDWord in
          let ca = if GPR(rs)(31) && r(31..0) != 0 then 0b1 as Bits<1> else 0b0 in {
            GPR(ra) := result
            if rc then $SetCR0(result)
            XER := (XER.rsv1, XER.so, XER.ov, ca, XER.rsv2, XER.ov32, ca, XER.rsv3, XER.nbytes)
          }
    encoding $x.id = {opcd = 0b011111, extopcd = $x.ext}
    assembly $x.id = (AsStr($x.id), rStr(rc), " ", decimal(ra), ",", decimal(rs), ",", decimal(rb))
  }

  // instructions: cbcdtd, cdtbcd
  model XFormBinCodedDecInstr (x : IdExt, decsrc : Bool) : IsaDefs = {
    instruction $x.id : XFormA =
      GPR(ra) := if $decsrc
                  then (0 as Byte, dpdtobcd(GPR(rs)(51..42)), dpdtobcd(GPR(rs)(41..32)), 
                        0 as Byte, dpdtobcd(GPR(rs)(19..10)), dpdtobcd(GPR(rs)(9..0)))
                  else (0 as Bits<12>, bcdtodpd(GPR(rs)(55..44)), bcdtodpd(GPR(rs)(43..32)), 
                        0 as Bits<12>, bcdtodpd(GPR(rs)(23..12)), bcdtodpd(GPR(rs)(11..0)))
    encoding $x.id = {opcd = 0b011111, rb = 0b00000, extopcd = $x.ext, rc = 0b0}
    assembly $x.id = (AsStr($x.id), " ", decimal(ra), ",", decimal(rs))
  }

  // instructions: cmpb
  model XFormCmpBytesInstr (id : Id) : IsaDefs = {
    instruction $id : XFormA =
      GPR(ra) := forall i in 7..0 tensor if GPR(rs)(i * 8 + 7..i * 8) = GPR(rb)(i * 8 + 7..i * 8) then 0xFF else 0x00
    encoding $id = {opcd = 0b011111, extopcd = 0b01111'11100, rc = 0b0}
    assembly $id = (AsStr($id), " ", decimal(ra), ",", decimal(rs), ",", decimal(rb))
  }

  // instructions: extsb[.], extsh[.], cntlzw[.], cnttzw[.]
  model XFormExCRInstr (x : IdExt, res : Ex) : IsaDefs = {
    instruction $x.id : XFormA =
      let result = $res as SDWord in {
        GPR(ra) := result
        if rc then $SetCR0(result)
      }
    encoding $x.id = {opcd = 0b011111, rb = 0b00000, extopcd = $x.ext}
    assembly $x.id = (AsStr($x.id), rStr(rc), " ", decimal(ra), ",", decimal(rs))
  }

  // instructions: lbzx, lbzux, lhax, lhaux, lhzx, lhzux, lwzx, lwzux, lwbrx
  model XFormLoadInstr (x : IdExt, unit : SymEx, type : Id, update : Bool, rev : Bool) : IsaDefs = {
    [undefined when : $update && (ra = 0 || rb = rs)]
    instruction $x.id : XFormA =
      let ea = GPRZ(ra) + GPR(rb) in
        let mea = if MSR.sf = Mode::M32 then ea & mask32 else ea in {
          $ReadMem(mea; $unit; rs; $rev; $type)
          if $update then GPR(ra) := ea
        }
    encoding $x.id = {opcd = 0b011111, extopcd = $x.ext, rc = 0b0}
    assembly $x.id = (AsStr($x.id), " ", decimal(rs), ",", decimal(ra), ",", decimal(rb))
  }

  // instructions: and[.], andc[.], eqv[.], nand[.], nor[.], or[.], orc[.], xor[.]
  model XFormLogicalInstr (x : IdOpExt, arg2 : Ex) : IsaDefs = {
    instruction $x.id : XFormA =
      let result = $x.op(GPR(ra), $arg2) in {
        GPR(rs) := result
        if rc then $SetCR0(result)
      }
    encoding $x.id = {opcd = 0b011111, extopcd = $x.ext}
    assembly $x.id = (AsStr($x.id), rStr(rc), " ", decimal(rs), ",", decimal(ra), ",", decimal(rb))
  }

  // instructions: slw[.], srw[.]
  model XFormLogicalShiftInstr (x : IdOpExt) : IsaDefs = {
    instruction $x.id : XFormA =
      let result = VADL::$x.op(GPR(rs)(31..0), GPR(rb)(5..0)) as UDWord in {
        GPR(ra) := result
        if rc then $SetCR0(result)
      }
    encoding $x.id = {opcd = 0b011111, extopcd = $x.ext}
    assembly $x.id = (AsStr($x.id), rStr(rc), " ", decimal(ra), ",", decimal(rs), ",", decimal(rb))
  }

  // instructions: modsw, moduw
  model XFormModInstr (x : IdOpExt) : IsaDefs = {
    instruction $x.id : XFormA =
      GPR(rs) := (VADL::$x.op(GPR(ra)(31..0), GPR(rb)(31..0)) as UWord) as UDWord
    encoding $x.id = {opcd = 0b011111, extopcd = $x.ext, rc = 0b0}
    assembly $x.id = (AsStr($x.id), " ", decimal(rs), ",", decimal(ra), ",", decimal(rb))
  }

  // instruction: mfmsr
  model XFormMSRGPRInstr (id : Id) : IsaDefs = {
    instruction $id : XFormA =
      if MSR.pr = 0b0 then GPR(rs) := MSR
      else raise Privilege
    encoding $id = {opcd = 0b011111, ra = 0b00000, rb = 0b00000, extopcd = 0b00010'10011, rc = 0b0}
    assembly $id = (AsStr($id), " ", decimal(rs))
  }
  
  // instructions: prtyw
  model XFormParityInstr (id : Id) : IsaDefs = {
    instruction $id : XFormA =
      GPR(ra) := (if VADL::cob(GPR(rs)(63..32)) % 2 = 1 then 1 as UWord else 0 as UWord,
                  if VADL::cob(GPR(rs)(31..0)) % 2 = 1 then 1 as UWord else 0 as UWord)                 
    encoding $id = {opcd = 0b011111, rb = 0b00000, extopcd = 0b00100'11010, rc = 0b0}
    assembly $id = (AsStr($id), " ", decimal(ra), ",", decimal(rs))
  }

  // instructions: popcntb, popcntw
  model XFormPopCountInstr (x : IdExt, unit : SymEx) : IsaDefs = {
    instruction $x.id : XFormA =
      if $unit = Unit::Byte
      then GPR(ra) := forall i in 7..0 tensor VADL::cob(GPR(rs)(i * 8 + 7..i * 8))
      else GPR(ra) := (VADL::cob(GPR(rs)(63..32)), VADL::cob(GPR(rs)(31..0)))                 
    encoding $x.id = {opcd = 0b011111, rb = 0b00000, extopcd = $x.ext, rc = 0b0}
    assembly $x.id = (AsStr($x.id), " ", decimal(ra), ",", decimal(rs))
  }

  // instructions: brh, brw
  model XFormReverseInstr (x : IdExt, unit : SymEx) : IsaDefs = {
    instruction $x.id : XFormA =
      GPR(ra) := if $unit = Unit::Half
                  then (byterevhinw(GPR(rs)(63..32)), byterevhinw(GPR(rs)(31..0)))
                  else (byterevw   (GPR(rs)(63..32)), byterevw   (GPR(rs)(31..0)))
    encoding $x.id = {opcd = 0b011111, rb = 0b00000, extopcd = $x.ext, rc = 0b0}
    assembly $x.id = (AsStr($x.id), " ", decimal(ra), ",", decimal(rs))
  }

  // instructions: stbx, stbux, sthx, sthux, sthbrx, stwx, stwux, stwbrx
  model XFormStoreInstr (x : IdExt, unit : SymEx, update : Bool, rev : Bool) : IsaDefs = {
    [undefined when : $update && ra = 0]
    instruction $x.id : XFormA =
      let ea = GPRZ(ra) + GPR(rb) in
        let mea = if MSR.sf = Mode::M32 then ea & mask32 else ea in {
          $WriteMem(mea; $unit; rs; $rev)
          if $update then GPR(ra) := ea
        }
    encoding $x.id = {opcd = 0b011111, extopcd = $x.ext, rc = 0b0}
    assembly $x.id = (AsStr($x.id), " ", decimal(rs), ",", decimal(ra), ",", decimal(rb))
  }

  // instructions: cmp, cmpl
  model XFormCmpInstr (x : IdExt, logical : Bool) : IsaDefs = {
    instruction $x.id : XFormB =
      $SetCRCmp((GPR(ra); GPR(rb)); $logical)
    encoding $x.id = {opcd = 0b011111, rsv1 = 0b0, extopcd = $x.ext, rsv2 = 0b0}
    assembly $x.id = (AsStr($x.id), " ", decimal(crt), ",", decimal(l), ",", decimal(ra), ",", decimal(rb))
  }

  // instructions: cmprb
  model XFormCmpRangedBytesInstr (id : Id) : IsaDefs = {
    instruction $id : XFormB =
      let b = GPR(ra)(7..0) as UByte in
        let m = if l then (GPR(rb)(7..0)   <= b) & (b <= GPR(rb)(15..8))
                     else (GPR(rb)(7..0)   <= b) & (b <= GPR(rb)(15..8)) & 
                          (GPR(rb)(23..16) <= b) & (b <= GPR(rb)(31..24)) in
          $CRField(crt) := (0 as Bits<1>, m, 0 as Bits<2>)
    encoding $id = {opcd = 0b011111, rsv1 = 0b0, extopcd = 0b00110'00000, rsv2 = 0b0}
    assembly $id = (AsStr($id), " ", decimal(crt), ",", decimal(l), ",", decimal(ra), ",", decimal(rb))
  }

  // instructions: setb
  model XFormBoolInstr (id : Id) : IsaDefs = {
    instruction $id : XFormC =
      GPR(rs) := match 0b1 as Bits<1> with
        { CR(crs).lt => -1 as SDWord
        , CR(crs).gt =>  1 as SDWord
        , _          =>  0 as SDWord
        }
    encoding $id = {opcd = 0b011111, rsv1 = 0b0000000, extopcd =  0b00100'00000, rsv2 = 0b0}
    assembly $id = (AsStr($id), " ", decimal(rs), ",", decimal(crs))
  }

  // instructions: setbc, setbcr, setnbc, setnbcr
  model XFormBoolCondInstr (x : IdExt, tval : Ex, fval : Ex) : IsaDefs = {
    instruction $x.id : XFormD =
      GPR(rs) := if $CRBit(crbs) then $tval else $fval
    encoding $x.id = {opcd = 0b011111, rsv1 = 0b00000, extopcd = $x.ext, rsv2 = 0b0}
    assembly $x.id = (AsStr($x.id), " ", decimal(rs), ",", decimal(crbs))
  }

  // instructions: cmpeqb
  model XFormCmpEqBytesInstr (id : Id) : IsaDefs = {
    instruction $id : XFormE =
      let b = GPR(ra)(7..0) in
        let m = forall i in 0..7 fold | with b = GPR(rb)(i * 8 + 7..i * 8) in
          $CRField(crt) := (0 as Bits<1>, m, 0 as Bits<2>)
    encoding $id = {opcd = 0b011111, rsv1 = 0b00, extopcd = 0b00111'00000, rsv2 = 0b0}
    assembly $id = (AsStr($id), " ", decimal(crt), ",", decimal(ra), ",", decimal(rb))
  }

  // instructions: mcrxrx
  model XFormMoveXERCRFInstr (id : Id) : IsaDefs = {
    instruction $id : XFormE =
      $CRField(crt) := (XER.ov, XER.ov32, XER.ca, XER.ca32)
    encoding $id = {opcd = 0b011111, rsv1 = 0b00, ra = 0b00000, rb = 0b00000, extopcd = 0b10010'00000, rsv2 = 0b0}
    assembly $id = (AsStr($id), " ", decimal(crt))
  }

  // instructions: mtmsr
  model XFormMoveGPRMSRInstr (id : Id) : IsaDefs = {
    instruction $id : XFormF =
      if MSR.pr = 0b0 then
        if l = 0b0 then
          MSR := (MSR(63..32), GPR(rs)(31..23), MSR(22), GPR(rs)(21..16),
                  GPR(rs)(15) | GPR(rs)(14), GPR(rs)(14..13), MSR(12), GPR(rs)(11..6),
                  (GPR(rs)(5) | GPR(rs)(14)) & ~(MSR(22) & MSR(60) & ~GPR(rs)(14)),
                  (GPR(rs)(4) | GPR(rs)(14)) & ~(MSR(22) & MSR(60) & ~GPR(rs)(14)),
                  GPR(rs)(3..1), MSR(0))
        else
          MSR := (MSR(63..16), GPR(rs)(15), MSR(14..2), GPR(rs)(1), MSR(0))
      else raise Privilege
    encoding $id = {opcd = 0b011111, rsv1 = 0b0000, rsv2 = 0b00000, extopcd = 0b00100'10010, rsv3 = 0b0}
    assembly $id = (AsStr($id), " ", decimal(rs), ",", decimal(l))
  }

  // instructions: tw
  model XFormTrapInstr (id : Id) : IsaDefs = {
    instruction $id : XFormG =
      let a = GPR(ra)(31..0) as SDWord in
        let b = GPR(rb)(31..0) as SDWord in
          if ((VADL::slth(a, b)) & to(4)) | ((VADL::sgth(a, b)) & to(3)) |
             ((a = b)            & to(2)) | ((VADL::ulth(a, b)) & to(1)) |
             ((VADL::ugth(a, b)) & to(0)) then
            raise Trap
    encoding $id = {opcd = 0b011111, extopcd = 0b00000'00100, rsv = 0b0}
    assembly $id = (AsStr($id), " ", decimal(to), ",", decimal(ra), ",", decimal(rb))
  }

  // instructions: mfcr
  model XFXMoveCRGPRInstr (id : Id) : IsaDefs = {
    instruction $id : XFXFormA =
      GPR(rs) := (forall i in 0..7 tensor $CRField(i)) as UDWord
    encoding $id = {opcd = 0b011111, m = 0b0, fxm = 0b0000'0000, rsv1 = 0b0, extopcd = 0b00000'10011, rsv2 = 0b0}
    assembly $id = (AsStr($id), " ", decimal(rs))
  }

  // instructions: mtcrf
  model XFXMoveGPRCRFInstr (id : Id) : IsaDefs = {
    instruction $id : XFXFormA =
      let mask = forall i in 7..0 tensor if fxm(i) then 0xF else 0x0 in
        CR := (GPR(rs)(31..0) & mask) | (CR & ~mask)
    encoding $id = {opcd = 0b011111, m = 0b0, rsv1 = 0b0, extopcd = 0b00100'10000, rsv2 = 0b0}
    assembly $id = (AsStr($id), " ", decimal(fxm), ",", decimal(rs))
  }

  // instructions: mtocrf
  model XFXMoveGPROCRFInstr (id : Id) : IsaDefs = {
    instruction $id : XFXFormA =
      if VADL::cob(fxm) = 1
      then let si = VADL::clz(fxm) in 
        CR := forall i in 0..7 tensor if i = si then GPR(rs)(31 - i * 4..28 - i * 4) else $CRField(i)
      else CR := 0
    encoding $id = {opcd = 0b011111, m = 0b1, rsv1 = 0b0, extopcd = 0b00100'10000, rsv2 = 0b0}
    assembly $id = (AsStr($id), " ", decimal(fxm), ",", decimal(rs))
  }

  // instructions: mfocrf
  model XFXMoveOCRFGPRInstr (id : Id) : IsaDefs = {
    instruction $id : XFXFormA =
      if VADL::cob(fxm) = 1
      then let si = VADL::clz(fxm) in 
        GPR(rs) := (forall i in 0..7 tensor if i = si then $CRField(i) else 0x0) as UDWord
      else GPR(rs) := 0
    encoding $id = {opcd = 0b011111, m = 0b1, rsv1 = 0b0, extopcd = 0b00000'10011, rsv2 = 0b0}
    assembly $id = (AsStr($id), " ", decimal(rs), ",", decimal(fxm))
  }

  // instructions: mfspr, mtspr, mftb
  model XFXMoveSPRInstr (x : IdExt, read : Bool) : IsaDefs = {
    instruction $x.id : XFXFormB = if $read then $ReadSPR() else $WriteSPR()
    encoding $x.id = {opcd = 0b011111, extopcd = $x.ext, rsv = 0b0}
    assembly $x.id = (AsStr($x.id), " ", if $read then decimal(rs) else decimal(spr), ",", if $read then decimal(spr) else decimal(rs))
  }

  // instructions: crand, crandc, creqv, crnand, crnor, cror, crorc, crxor
  model XLFormLogicalInstr (x : IdOpExt, arg2 : Ex) : IsaDefs = {
    instruction $x.id : XLFormA =
      $CRBit(crbt) := $x.op($CRBit(crbs1), $arg2)
    encoding $x.id = {opcd = 0b010011, extopcd = $x.ext, rsv = 0b0}
    assembly $x.id = (AsStr($x.id), " ", decimal(crbt), ",", decimal(crbs1), ",", decimal(crbs2))
  }

  // instructions: bcctr[l], bclr[l], bctar[l]
  model XLFormBranchInstr (x : IdExt, breg : Id, ctrcntr : Bool) : IsaDefs = {
    instruction $x.id : XLFormB =
      let lrv = PC.next in {
        if ($ctrcntr as Bits<1>) & ~bo(2) then CTR := CTR - 1
        let mctr = if MSR.sf = Mode::M32 then CTR & mask32 else CTR in
          if (~($ctrcntr as Bits<1>) | bo(2) | ((mctr != 0) ^ bo(1))) & (bo(4) | ($CRBit(crbs) = bo(3))) then
            PC := $TargetAddrReg($breg)
        if lk then LR := lrv  
      }
    encoding $x.id = {opcd = 0b010011, rsv = 0b000, bh = 0b00, extopcd = $x.ext}
    assembly $x.id = (AsStr($x.id), lStr(lk), " ", decimal(bo), ",", decimal(crbs), ",", decimal(bh))
  }

  // instructions: mcrf
  model XLFormMoveCRFCRFInstr (id : Id) : IsaDefs = {
    instruction $id : XLFormC =
      $CRField(crt) := $CRField(crs)
    encoding $id = {opcd = 0b010011, rsv1 = 0b00, rsv2 = 0b00'00000'00000'000000}
    assembly $id = (AsStr($id), " ", decimal(crt), ",", decimal(crs))
  }

  // instructions: addg6s
  model XOFormAddGen6Instr (id : Id) : IsaDefs = {
    instruction $id : XOForm =
      GPR(rs) := forall i in 15..0 tensor 
                   let result, flags = VADL::adds(GPR(ra)(i * 4 + 3..0), GPR(rb)(i * 4 + 3..0)) in
                     if flags.carry then 0x0 else 0x6
    encoding $id = {opcd = 0b011111, oe = 0b0, extopcd = 0b0010'01010, rc = 0b0}
    assembly $id = (AsStr($id), " ", decimal(rs), ",", decimal(ra), ",", decimal(rb))
  }

  // instructions: add[o][.], addc[o][.], adde[o][.], subf[o][.], subfc[o][.], subfe[o][.], addme[o][.], addze[o][.], subfme[o][.], subfze[o][.]
  model XOFormAddSubInstr (x : IdOpExt, a : TwoArgs, enc : Encs, carry : Ex, logca : Bool) : IsaDefs = {
    instruction $x.id : XOForm =
      let result32, flags32 = VADL::$x.op($a.arg1 as SWord, $a.arg2 as SWord, $carry) in
        let result64, flags64 = VADL::$x.op($a.arg1 as SDWord, $a.arg2 as SDWord, $carry) in {
          GPR(rs) := result64
          $SetXER(toflags(oe, $logca))
          if rc then $SetCR0(result64)
        }
    encoding $x.id = {opcd = 0b011111, extopcd = $x.ext, $enc}
    assembly $x.id = (AsStr($x.id), oStr(oe), rStr(rc), " ", decimal(rs), ",", decimal(ra), ",", decimal(rb))
  }

  // instructions: divw[o][.], divwu[o][.], divwe[o][.], divweu[o][.]
  model XOFormDivInstr (x : IdOpExt, a : TwoArgs, extcond : Ex) : IsaDefs = {
    instruction $x.id : XOForm =
      let result, flags = VADL::$x.op($a.arg1, $a.arg2) in
        let ov = if $extcond & GPR(rb)(31..0) != 0 then flags.overflow else 0b1 in {
          GPR(rs) := (result(31..0) as UWord) as UDWord
          if oe then XER := (XER.rsv1, XER.so | ov, ov, XER.ca, XER.rsv2, ov, XER.ca32, XER.rsv3, XER.nbytes)
          if rc then $SetCR0(result)
        }
    encoding $x.id = {opcd = 0b011111, extopcd = $x.ext}
    assembly $x.id = (AsStr($x.id), oStr(oe), rStr(rc), " ", decimal(rs), ",", decimal(ra), ",", decimal(rb))
  }

  // instructions: mullw[o][.], mulhw[o][.], mulhwu[o][.]
  model XOFormMulInstr (x : IdOpExt, res : Ex, enc : Encs) : IsaDefs = {
    instruction $x.id : XOForm =
      let prod = VADL::$x.op(GPR(ra)(31..0), GPR(rb)(31..0)) in
        let result = $res as UDWord in {
          GPR(rs) := result
          if oe & (VADL::slth(result, minS32E) | VADL::sgth(result, maxS32E))
          then XER := (XER.rsv1, 0b1 as Bits<1>, 0b1 as Bits<1>, XER.ca, XER.rsv2, 0b1 as Bits<1>, XER.ca32, XER.rsv3, XER.nbytes)
        }
    encoding $x.id = {opcd = 0b011111, extopcd = $x.ext, $enc}
    assembly $x.id = (AsStr($x.id), oStr(oe), rStr(rc), " ", decimal(rs), ",", decimal(ra), ",", decimal(rb))
  }

  // instructions: neg[o][.]
  model XOFormNegateInstr (id : Id) : IsaDefs = {
    instruction $id : XOForm =
      let ov32 = if GPR(ra)(31..0) = minS32 then 0b1 as Bits<1> else 0b0 in
        let mov = if MSR.sf = Mode::M32 then ov32 else GPR(ra) = minS64 in
          let result = ~GPR(ra) + 1 in {
            GPR(rs) := result
            if oe then XER := (XER.rsv1, XER.so | mov, mov, XER.ca, XER.rsv2, ov32, XER.ca32, XER.rsv3, XER.nbytes)
            if rc then $SetCR0(result)
          }
    encoding $id = {opcd = 0b011111, rb = 0b00000, extopcd = 0b0011'01000}
    assembly $id = (AsStr($id), oStr(oe), rStr(rc), " ", decimal(rs), ",", decimal(ra))
  }

  // instructions: addex
  model Z23FormAddInstr (id : Id) : IsaDefs = {
    instruction $id : Z23Form =
      let result32, flags32 = VADL::addc(GPR(ra) as SWord, GPR(rb) as SWord, XER.ov) in
        let result64, flags64 = VADL::addc(GPR(ra) as SDWord, GPR(rb) as SDWord, XER.ov) in {
          GPR(rs) := result64
          let mca = if MSR.sf = Mode::M32 then flags32.carry else flags64.carry in
            XER := (XER.rsv1, XER.so, mca, XER.ca, XER.rsv2, flags32.carry, XER.ca32, XER.rsv3, XER.nbytes)
        }
    encoding $id = {opcd = 0b011111, cy = 0b00, extopcd = 0b101'01010, rsv = 0b0}
    assembly $id = (AsStr($id), " ", decimal(rs), ",", decimal(ra), ",", decimal(rb), ",", decimal(cy))
  }

  //------------------------Arithmetic-------------------------
  //DXFormAddInstr (id : Id)
  $DXFormAddInstr(ADDPCIS)

  //XOFormAddSubInstr (x : IdOpExt, a : TwoArgs, enc : Encs, carry : Ex, logca : Bool)
  $XOFormAddSubInstr((ADD   ; addc; 0b1000'01010); (GPR(ra); GPR(rb)); none         ; false ; false)
  $XOFormAddSubInstr((ADDC  ; addc; 0b0000'01010); (GPR(ra); GPR(rb)); none         ; false ; true )
  $XOFormAddSubInstr((ADDE  ; addc; 0b0100'01010); (GPR(ra); GPR(rb)); none         ; XER.ca; true )
  $XOFormAddSubInstr((SUBF  ; subc; 0b0001'01000); (GPR(rb); GPR(ra)); none         ; false ; false)
  $XOFormAddSubInstr((SUBFC ; subc; 0b0000'01000); (GPR(rb); GPR(ra)); none         ; false ; true )
  $XOFormAddSubInstr((SUBFE ; subc; 0b0100'01000); (GPR(rb); GPR(ra)); none         ; XER.ca; true )
  $XOFormAddSubInstr((ADDME ; addc; 0b0111'01010); (GPR(ra); -1     ); rb = 0b00000 ; XER.ca; true )
  $XOFormAddSubInstr((ADDZE ; addc; 0b0110'01010); (GPR(ra);  0     ); rb = 0b00000 ; XER.ca; true )
  $XOFormAddSubInstr((SUBFME; subc; 0b0111'01000); (-1     ; GPR(ra)); rb = 0b00000 ; XER.ca; true )
  $XOFormAddSubInstr((SUBFZE; subc; 0b0110'01000); ( 0     ; GPR(ra)); rb = 0b00000 ; XER.ca; true )

  //DFormAddSubInstr (x : IdStrOpOpcd, a : TwoArgs, logcr : Bool, logca : Bool)
  $DFormAddSubInstr((ADDI  ; "ADDI"  ; adds ; 0b001110); (GPRZ(ra); immS    ); false; false)
  $DFormAddSubInstr((ADDIC ; "ADDIC" ; adds ; 0b001100); (GPR(ra) ; immS    ); false; true )
  $DFormAddSubInstr((ADDIC_; "ADDIC" ; adds ; 0b001101); (GPR(ra) ; immS    ); true ; true )
  $DFormAddSubInstr((ADDIS ; "ADDIS" ; adds ; 0b001111); (GPRZ(ra); shImmS  ); false; false)
  $DFormAddSubInstr((SUBFIC; "SUBFIC"; subsc; 0b001000); (immS    ; GPR(ra) ); false; true )

  // TODO: needs forall
  //XOFormAddGen6Instr (id : Id)
  //$XOFormAddGen6Instr(ADDG6S)

  //Z23FormAddInstr (id : Id)
  $Z23FormAddInstr(ADDEX)

  //DFormMulInstr (id : Id)
  $DFormMulInstr(MULLI)

  //XOFormMulInstr (x : IdOpExt, res : Ex, enc : Encs)
  $XOFormMulInstr((MULLW ; smull; 0b0111'01011); prod        ; none    )
  $XOFormMulInstr((MULHW ; smull; 0b0010'01011); prod(63..32); oe = 0b0)
  $XOFormMulInstr((MULHWU; umull; 0b0000'01011); prod(63..32); oe = 0b0)

  //XOFormDivInstr (x : IdOpExt, a : TwoArgs, extcond : Ex)
  $XOFormDivInstr((DIVW  ; sdivs; 0b1111'01011); (GPR(ra)(31..0) as SWord       ; GPR(rb)(31..0) as SWord ); 
                  (GPR(ra)(31..0) != 0x8000'0000 || GPR(ra)(31..0) != 0xFFFF'FFFF))
  $XOFormDivInstr((DIVWU ; udivs; 0b1110'01011); (GPR(ra)(31..0) as UWord       ; GPR(rb)(31..0) as UWord ); 
                  true)
  $XOFormDivInstr((DIVWE ; sdivs; 0b1101'01011); (GPR(ra)(31..0) as SDWord << 32; GPR(rb)(31..0) as SDWord); 
                  (VADL::slth(result, maxS32E) && VADL::sgth(result, minS32E)))                
  $XOFormDivInstr((DIVWEU; udivs; 0b1100'01011); (GPR(ra)(31..0) as UDWord << 32; GPR(rb)(31..0) as UDWord); 
                  VADL::ulth(GPR(ra)(31..0), GPR(rb)(31..0)))

  //XOFormNegateInstr (id : Id)
  $XOFormNegateInstr(NEG)

  //XFormModInstr (x : IdOpExt)
  $XFormModInstr((MODSW; smod; 0b11000'01011))
  $XFormModInstr((MODUW; umod; 0b01000'01011))

  //------------------------Logical----------------------------
  //XFormLogicalInstr (x : IdOpExt, arg2 : Ex)
  $XFormLogicalInstr((AND ; VADL::and; 0b00000'11100);  GPR(rb))
  $XFormLogicalInstr((ANDC; VADL::and; 0b00001'11100); ~GPR(rb))
  $XFormLogicalInstr((EQV ; nxor64   ; 0b01000'11100);  GPR(rb))
  $XFormLogicalInstr((NAND; nand64   ; 0b01110'11100);  GPR(rb))
  $XFormLogicalInstr((NOR ; nor64    ; 0b00011'11100);  GPR(rb))
  $XFormLogicalInstr((OR  ; VADL::or ; 0b01101'11100);  GPR(rb))
  $XFormLogicalInstr((ORC ; VADL::or ; 0b01100'11100); ~GPR(rb))
  $XFormLogicalInstr((XOR ; VADL::xor; 0b01001'11100);  GPR(rb))

  //XLFormLogicalInstr (x : IdOpExt, arg2 : Ex)
  $XLFormLogicalInstr((CRAND ; VADL::and; 0b01000'00001);  $CRBit(crbs2))
  $XLFormLogicalInstr((CRANDC; VADL::and; 0b00100'00001); ~$CRBit(crbs2))
  $XLFormLogicalInstr((CREQV ; nxor1    ; 0b01001'00001);  $CRBit(crbs2))
  $XLFormLogicalInstr((CRNAND; nand1    ; 0b00111'00001);  $CRBit(crbs2))
  $XLFormLogicalInstr((CRNOR ; nor1     ; 0b00001'00001);  $CRBit(crbs2))
  $XLFormLogicalInstr((CROR  ; VADL::or ; 0b01110'00001);  $CRBit(crbs2))
  $XLFormLogicalInstr((CRORC ; VADL::or ; 0b01101'00001); ~$CRBit(crbs2))
  $XLFormLogicalInstr((CRXOR ; VADL::xor; 0b00110'00001);  $CRBit(crbs2))

  //DFormLogicalInstr (x : IdOpOpcd, arg2 : Id, logcr : Bool)
  $DFormLogicalInstr((ANDI ; and; 0b011100); immU  ; true )
  $DFormLogicalInstr((ANDIS; and; 0b011101); shImmU; true )
  $DFormLogicalInstr((ORI  ; or ; 0b011000); immU  ; false)
  $DFormLogicalInstr((ORIS ; or ; 0b011001); shImmU; false)
  $DFormLogicalInstr((XORI ; xor; 0b011010); immU  ; false)
  $DFormLogicalInstr((XORIS; xor; 0b011011); shImmU; false)

  //XFormBoolInstr (id : Id)
  $XFormBoolInstr(SETB)

  //XFormBoolCondInstr (x : IdExt, tval : Ex, fval : Ex)
  $XFormBoolCondInstr((SETBC  ; 0b01100'00000);  1 as SDWord;  0 as SDWord)
  $XFormBoolCondInstr((SETBCR ; 0b01101'00000);  0 as SDWord;  1 as SDWord)
  $XFormBoolCondInstr((SETNBC ; 0b01110'00000); -1 as SDWord;  0 as SDWord)
  $XFormBoolCondInstr((SETNBCR; 0b01111'00000);  0 as SDWord; -1 as SDWord)

  //------------------------Rotate/Shift-----------------------
  //MFormRotateInstr (x : IdOpcd, rotsrc : Ex, res : Ex) 
  $MFormRotateInstr((RLWIMI; 0b010100); sh           ; (r & m) | (GPR(ra) & ~m))
  $MFormRotateInstr((RLWINM; 0b010101); sh           ; r & m                   )
  $MFormRotateInstr((RLWNM ; 0b010111); GPR(sh)(4..0); r & m                   )

  //XFormLogicalShiftInstr (x : IdOpExt)
  $XFormLogicalShiftInstr((SLW; lsl; 0b00000'11000))
  $XFormLogicalShiftInstr((SRW; lsr; 0b10000'11000))

  //XFormArithmeticShiftInstr (x : IdExt, shiftsrc : Ex)
  $XFormArithmeticShiftInstr((SRAW ; 0b11000'11000); GPR(rb)(4..0))
  $XFormArithmeticShiftInstr((SRAWI; 0b11001'11000); rb           )

  //------------------------Compare----------------------------
  //XFormCmpInstr (x : IdExt, logical : Bool)
  $XFormCmpInstr((CMP ; 0b00000'00000); false)
  $XFormCmpInstr((CMPL; 0b00001'00000); true )

  //DFormCmpInstr (x : IdOpcd, logical : Bool)
  $DFormCmpInstr((CMPI ; 0b001011); false)
  $DFormCmpInstr((CMPLI; 0b001010); true )

  // TODO: needs forall
  //XFormCmpBytesInstr (id : Id)
  //$XFormCmpBytesInstr(CMPB)

  // TODO: needs forall
  //XFormCmpEqBytesInstr (id : Id)
  //$XFormCmpEqBytesInstr(CMPEQB)

  //XFormCmpRangedBytesInstr (id : Id)
  $XFormCmpRangedBytesInstr(CMPRB)

  //------------------------Load-------------------------------
  //DFormLoadInstr (x : IdOpcd, unit : SymEx, update : Bool, type : Id)
  $DFormLoadInstr((LBZ ; 0b100010); Unit::Byte; false; UDWord)
  $DFormLoadInstr((LBZU; 0b100011); Unit::Byte; true ; UDWord)
  $DFormLoadInstr((LHA ; 0b101010); Unit::Half; false; SDWord)
  $DFormLoadInstr((LHAU; 0b101011); Unit::Half; true ; SDWord)
  $DFormLoadInstr((LHZ ; 0b101000); Unit::Half; false; UDWord)
  $DFormLoadInstr((LHZU; 0b101001); Unit::Half; true ; UDWord)
  $DFormLoadInstr((LWZ ; 0b100000); Unit::Word; false; UDWord)
  $DFormLoadInstr((LWZU; 0b100001); Unit::Word; true ; UDWord)

  //XFormLoadInstr (x : IdExt, unit : SymEx, type : Id, update : Bool, rev : Bool)
  $XFormLoadInstr((LBZX ; 0b00010'10111); Unit::Byte; UDWord; false; false)
  $XFormLoadInstr((LBZUX; 0b00011'10111); Unit::Byte; UDWord; true ; false)
  $XFormLoadInstr((LHAX ; 0b01010'10111); Unit::Half; SDWord; false; false)
  $XFormLoadInstr((LHAUX; 0b01011'10111); Unit::Half; SDWord; true ; false)
  $XFormLoadInstr((LHZX ; 0b01000'10111); Unit::Half; UDWord; false; false)
  $XFormLoadInstr((LHZUX; 0b01001'10111); Unit::Half; UDWord; true ; false)
  $XFormLoadInstr((LWZX ; 0b00000'10111); Unit::Word; UDWord; false; false)
  $XFormLoadInstr((LWZUX; 0b00001'10111); Unit::Word; UDWord; true ; false)
  $XFormLoadInstr((LWBRX; 0b10000'10110); Unit::Word; UDWord; false; true )

  //------------------------Store------------------------------
  //DFormStoreInstr (x : IdOpcd, unit : SymEx, update : Bool)
  $DFormStoreInstr((STB ; 0b100110); Unit::Byte; false)
  $DFormStoreInstr((STBU; 0b100111); Unit::Byte; true )
  $DFormStoreInstr((STH ; 0b101100); Unit::Half; false)
  $DFormStoreInstr((STHU; 0b101101); Unit::Half; true )
  $DFormStoreInstr((STW ; 0b100100); Unit::Word; false)
  $DFormStoreInstr((STWU; 0b100101); Unit::Word; true )

  //XFormStoreInstr (x : IdExt, unit : SymEx, update : Bool, rev : Bool)
  $XFormStoreInstr((STBX  ; 0b00110'10111); Unit::Byte; false; false)
  $XFormStoreInstr((STBUX ; 0b00111'10111); Unit::Byte; true ; false)
  $XFormStoreInstr((STHX  ; 0b01100'10111); Unit::Half; false; false)
  $XFormStoreInstr((STHUX ; 0b01101'10111); Unit::Half; true ; false)
  $XFormStoreInstr((STHBRX; 0b11100'10110); Unit::Half; false; true )
  $XFormStoreInstr((STWX  ; 0b00100'10111); Unit::Word; false; false)
  $XFormStoreInstr((STWUX ; 0b00101'10111); Unit::Word; true ; false)
  $XFormStoreInstr((STWBRX; 0b10100'10110); Unit::Word; false; true )

  //------------------------Branch-----------------------------
  //IFormBranchInstr (id : Id)
  $IFormBranchInstr(B)

  //BFormBranchInstr (id : Id)
  $BFormBranchInstr(BC)

  //XLFormBranchInstr (x : IdExt, breg : Id, ctrcntr : Bool)
  $XLFormBranchInstr((BCCTR; 0b10000'10000); CTR; false)
  $XLFormBranchInstr((BCLR ; 0b00000'10000); LR ; true )
  $XLFormBranchInstr((BCTAR; 0b10001'10000); TAR; true )

  //------------------------Move-------------------------------
  //XFormMSRGPRInstr (id : Id)
  $XFormMSRGPRInstr(MFMSR)

  //XFormMoveGPRMSRInstr (id : Id)
  $XFormMoveGPRMSRInstr(MTMSR)

  // TODO: needs forall
  //XFXMoveOCRFGPRInstr (id : Id)
  //$XFXMoveOCRFGPRInstr(MFOCRF)

  // TODO: needs forall
  //XFXMoveGPROCRFInstr (id : Id)
  //$XFXMoveGPROCRFInstr(MTOCRF)

  // TODO: needs forall
  //XFXMoveCRGPRInstr (id : Id)
  //$XFXMoveCRGPRInstr(MFCR)

  // TODO: needs forall
  //XFXMoveGPRCRFInstr (id : Id)
  //$XFXMoveGPRCRFInstr(MTCRF)

  //XLFormMoveCRFCRFInstr (id : Id)
  $XLFormMoveCRFCRFInstr(MCRF)

  //XFormMoveXERCRFInstr (id : Id)
  $XFormMoveXERCRFInstr(MCRXRX)

  //XFXMoveSPRInstr (x : IdExt, read : Bool)
  $XFXMoveSPRInstr((MFSPR; 0b01010'10011); true )
  $XFXMoveSPRInstr((MTSPR; 0b01110'10011); false)
  $XFXMoveSPRInstr((MFTB ; 0b01011'10011); true ) // marked as phased-out

  //------------------------Other------------------------------
  //XFormReverseInstr (x : IdExt, unit : SymEx)
  $XFormReverseInstr((BRH; 0b00110'11011); Unit::Half)
  $XFormReverseInstr((BRW; 0b00100'11011); Unit::Word)

  //XFormBinCodedDecInstr (x : IdExt, decsrc : Bool)
  $XFormBinCodedDecInstr((CBCDTD; 0b01001'11010); false)
  $XFormBinCodedDecInstr((CDTBCD; 0b01000'11010); true )

  // TODO: needs forall
  //XFormPopCountInstr (x : IdExt, unit : SymEx)
  //$XFormPopCountInstr((POPCNTB; 0b00011'11010); Unit::Byte)
  //$XFormPopCountInstr((POPCNTW; 0b01011'11010); Unit::Word)

  //XFormParityInstr (id : Id)
  $XFormParityInstr(PRTYW)

  //XFormTrapInstr (id : Id)
  $XFormTrapInstr(TW)

  //DFormTrapInstr (id : Id)
  $DFormTrapInstr(TWI)

  //XFormExCRInstr (x : IdExt, res : Ex)
  $XFormExCRInstr((EXTSB ; 0b11101'11010); GPR(rs)( 7..0)           )
  $XFormExCRInstr((EXTSH ; 0b11100'11010); GPR(rs)(15..0)           )
  $XFormExCRInstr((CNTLZW; 0b00000'11010); VADL::clz(GPR(rs)(31..0)))
  $XFormExCRInstr((CNTTZW; 0b10000'11010); VADL::ctz(GPR(rs)(31..0)))

  //SCFormSysCallInstr (x : IdExt, ex : CallEx)
  $SCFormSysCallInstr((SC ; 0b10); SysCall(lev)   )
  $SCFormSysCallInstr((SCV; 0b01); SysCallVectored)
}

processor CPU implements PPC64 = {
  reset = PC := 0x0

  [ firmware ]
  [ base: 0x00000000 ]
  memory region [RAM] DRAM in MEM
}