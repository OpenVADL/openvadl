/* PPC64SFS is a 64-bit implementation of the scalar fixed-point subset defined in PowerISA 3.1b.
 * It includes 132 instructions (excluding variants). The simulator boots in 32-bit compatibility mode.
 * Setting MSR.sf to 1 enables 64-bit mode.
 *
 * Explanation of instruction mnemonic suffixes:
 * _L : set the link register to PC.next (PC + 4)
 * _A : use absolute addressing in branch instructions
 * _O : set the overflow flags
 * _. : set the condition register
 *
 * Note: in instruction identifiers, "." is written as "_", since dots are not allowed in identifiers
 */

instruction set architecture PPC64SFS = {

  constant minS32  : Bits<32> = 0x8000'0000                // smallest 32-bit signed value
  constant maxS32  : Bits<32> = 0x7FFF'FFFF                // largest 32-bit signed value
  constant minS32E : Bits<64> = 0xFFFF'FFFF'8000'0000      // smallest 32-bit signed value sign extended to 64 bits
  constant maxS32E : Bits<64> = 0x0000'0000'7FFF'FFFF      // largest 32-bit signed value sign extended to 64 bits
  constant minS64  : Bits<64> = 0x8000'0000'0000'0000      // smallest 64-bit signed value
  constant maxS64  : Bits<64> = 0x7FFF'FFFF'FFFF'FFFF      // largest 64-bit signed value
  constant maxU32             = -1 as Bits<32>             // largest 32-bit unsigned value
  constant maxU32E            = -1 as Bits<32> as Bits<64> // largest 32-bit unsigned value zero extended to 64 bits
  constant oneU64             =  1 as Bits<64>             // one as 64-bit unsigned value
  constant zeroU64            =  0 as Bits<64>             // zero as 64-bit unsigned value
  constant maxU64             = -1 as Bits<64>             // largest 64-bit unsigned value

  using Bit     = Bits<1>
  using Nibble  = Bits<4>
  using Byte    = Bits<8>
  using Half    = Bits<16>
  using Word    = Bits<32>
  using DWord   = Bits<64>
  using SNibble = SInt<4>
  using SByte   = SInt<8>
  using SHalf   = SInt<16>
  using SWord   = SInt<32>
  using SDWord  = SInt<64>
  using UNibble = UInt<4>
  using UByte   = UInt<8>
  using UHalf   = UInt<16>
  using UWord   = UInt<32>
  using UDWord  = UInt<64>

  using XIndex      = Bits<5>                    // general-purpose register index
  using SIndex      = Bits<10>                   // special-purpose register index
  using CRFIndex    = Bits<3>                    // condition register field index
  using CRBIndex    = Bits<5>                    // condition register bit index
  using Reg64       = DWord                      // 64-bit register
  using Reg32       = Word                       // 32-bit exception/ status register
  using Address     = DWord                      // 64-bit address, top 32-bits are always zero in 32-bit Mode
  using Instr       = Word                       // 32-bit instruction, prefixed instructions are not supported
  using OpCode      = Bits<6>                    // opcode
  using Ext8        = Byte                       // 8-bit extended opcode
  using Ext9        = Bits<9>                    // 9-bit extended opcode
  using Ext10       = Bits<10>                   // 10-bit extended opcode

  program counter PC  : Address

  [ bigEndian ]
  memory          MEM : Address -> Byte

  register X : XIndex -> Reg64                   // 32 general-purpose 64-bit registers
  [zero : XZ(0)]
  alias register XZ = X                          // alias for general-purpose registers where index zero is always the value zero
  alias register XW = X(*)(31..0)                // lowest 32 bits of general-purpose registers
  alias register XH = X(*)(15..0)                // lowest 16 bits of general-purpose registers
  alias register XB = X(*)(7..0)                 // lowest 8 bits of general-purpose registers

  register CRF  : Nibble<8>                      // 8x4-bit condition register fields

  [ execution state : sf, pr ]
  register MSR  : MSRFormat                      // machine state register
  register SRR0 : Reg64                          // machine status save/ restore register 1
  register SRR1 : Reg64                          // machine status save/ restore register 2

  register XER_BASE   : Reg32                    // exception/ status register (non-flag fields only)
  register XER_SO     : Bit                      // summary overflow, is set whenever ov is set: so = so | ov
  register XER_OV     : Bit                      // overflow, is equal to ov32 in 32-bit mode
  register XER_CA     : Bit                      // carry, is equal to ca32 in 32-bit mode
  register XER_OV32   : Bit                      // overflow32, overflow when using 32-bit operands
  register XER_CA32   : Bit                      // carry32, carry when using 32-bit operands

  register LR   : Reg64                          // link register
  register CTR  : Reg64                          // count register
  register TB   : Reg64                          // time base register
  register TAR  : Reg64                          // target address register

  enumeration SPRIndex : Bits<10> =              // index of special purpose registers
  { XER = 0b00000'00001
  , LR  = 0b00000'01000
  , CTR
  , TBL = 0b01000'01100
  , TBH
  , TAR = 0b11001'01111
  }

  enumeration Unit : Bits<2> =                   // units for macro definitions
  { Byte
  , Half
  , Word
  }

  // note: most of the functionality here is not implemented, because it is not a part of the subset
  format MSRFormat : Reg64 =
  { sf   : Bit                                   // [s]ixty-[f]our bit, if set the processor is in 64-bit Mode
  , rsv1 : Bits<2>
  , hv   : Bit                                   // together with pr defines the privilege state of the processor (not implemented)
  , rsv2 : Bit
  , idk  : Bit                                   // this bit must be 0 or all instructions are boundedly undefined (not implemented)
  , rsv3 : Word
  , vec  : Bit                                   // if set the thread can execute vector instructions (not implemented)
  , rsv4 : Bit
  , vsx  : Bit                                   // if set the thread can execute VSX instructions (not implemented)
  , s    : Bit                                   // if set the thread is in secure state (not implemented)
  , rsv5 : Bits<6>
  , ee   : Bit                                   // if set additional interrupts are enabled (not implemented)
  , pr   : Bit                                   // together with hv defines the privilege state of the processor
  , fp   : Bit      	                           // if set the thread can execute floating-point instructions (not implemented)
  , me   : Bit                                   // if set machine check interrupts are enabled (not implemented)
  , fe0  : Bit                                   // floating-point exception mode bit 1 (not implemented)
  , te   : Bits<2>                               // controls branch tracing (not implemented)
  , fe1  : Bit                                   // floating-point exception mode bit 2 (not implemented)
  , rsv6 : Bits<2>
  , ir   : Bit                                   // if set instruction address translation is enabled (not implemented)
  , dr   : Bit                                   // if set data address translation is enabled (not implemented)
  , rsv7 : Bit
  , pmm  : Bit                                   // this bit is used by the performance monitoring facility (not implemented)
  , ri   : Bit                                   // if set interrupt is recoverable (not implemented)
  , le   : Bit                                   // if set the thread is in little endian mode (not implemented)
  }

  format BForm : Instr =
  { opcd  : OpCode                               // opcode
  , bo    : Bits<5>                              // branch options and hints
  , crbs  : CRBIndex                             // CR bit to test
  , bd    : Bits<14>                             // part of the branch address
  , aa    : Bit                                  // if set the branch address is absolute
  , lk    : Bit                                  // if set the link register is set to PC.next
  , extBd = bd as SDWord << 2
  }

  format DFormA : Instr =
  { opcd   : OpCode                              // opcode
  , rs     : XIndex                              // store: source register, other: target register
  , ra     : XIndex                              // source register
  , imm    : Half                                // immediate value
  , immU   = imm as UDWord                       // immediate value zero extended to 64 bits
  , immS   = imm as SDWord                       // immediate value sign extended to 64 bits
  , shImmU = imm as UDWord << 16                 // immediate value zero extended to 64 bits and shifted
  , shImmS = imm as SDWord << 16                 // immediate value sign extended to 64 bits and shifted
  }

  format DFormB : Instr =
  { opcd : OpCode                                // opcode
  , crft : CRFIndex                              // target CR field
  , rsv  : Bit
  , l    : Bit                                   // if set the instruction uses 64-bit operands
  , rs   : XIndex                                // source register
  , imm  : Half                                  // immediate value
  , immU = imm as UDWord                         // immediate value zero extended to 64 bits
  , immS = imm as SDWord                         // immediate value sign extended to 64 bits
  }

  format DFormC : Instr =
  { opcd : OpCode                                // opcode
  , to   : Bits<5>                               // selects trap condition(s)
  , rs   : XIndex                                // source register
  , imm  : Half                                  // immediate value
  , immS = imm as SDWord                         // immediate value sign extended to 64 bits
  }

  format DXForm : Instr =
  { opcd [31..26]           : OpCode             // opcode
  , rs   [25..21]           : XIndex             // target register
  , imm  [15..6, 20..16, 0] : Half               // immediate value
  , rsv  [5..1]             : Bits<5>
  , shImmS = imm as SDWord << 16                 // immediate value sign extended to 64 bits and shifted
  }

  format IForm : Instr =
  { opcd  : OpCode                               // opcode
  , li    : Bits<24>                             // part of the branch address
  , aa    : Bit                                  // if set the branch address is absolute
  , lk    : Bit                                  // if set the link register is set to PC.next
  , extLi = li as SDWord << 2                    // branch target address base
  }

  format MForm : Instr =
  { opcd : OpCode                                // opcode
  , rs   : XIndex                                // source register
  , ra   : XIndex                                // target register
  , sh   : Bits<5>                               // source register/ immediate value
  , mb   : Bits<5>                               // start index of bit mask
  , me   : Bits<5>                               // end index of bit mask
  , rc   : Bit                                   // if set the instruction modifies the CR
  , mb6  = mb as Bits<6>                         // start index zero extended to 6 bits
  , me6  = me as Bits<6>                         // end index zero extended to 6 bits
  }

  format SCForm : Instr =
  { opcd    : OpCode                             // opcode
  , rsv1    : Bits<14>
  , lev     : Bits<7>                            // defines change to privilege level
  , rsv2    : Bits<3>
  , extopcd : Bits<2>                            // extended opcode
  }

  format XFormA : Instr =
  { opcd    : OpCode                             // opcode
  , rs      : XIndex                             // source/ target register
  , ra      : XIndex                             // source/ target register
  , rb      : XIndex                             // source register/ immediate value
  , extopcd : Ext10                              // extended opcode
  , rc      : Bit                                // if set the instruction modifies the CR
  }

  format XFormB : Instr =
  { opcd    : OpCode                             // opcode
  , crft    : CRFIndex                           // target CR field
  , rsv1    : Bit
  , l       : Bit                                // if set the instruction uses 64-bit operands
  , ra      : XIndex                             // source register
  , rb      : XIndex                             // source register
  , extopcd : Ext10                              // extended opcode
  , rsv2    : Bit
  }

  format XFormC : Instr =
  { opcd    : OpCode                             // opcode
  , rs      : XIndex                             // target register
  , crfs    : CRFIndex                           // source CR field
  , rsv1    : Bits<7>
  , extopcd : Ext10                              // extended opcode
  , rsv2    : Bit
  }

  format XFormD : Instr =
  { opcd    : OpCode                             // opcode
  , rs      : XIndex                             // target register
  , crbs    : CRBIndex                           // source CR bit
  , rsv1    : Bits<5>
  , extopcd : Ext10                              // extended opcode
  , rsv2    : Bit
  }

  format XFormE : Instr =
  { opcd    : OpCode                             // opcode
  , crft    : CRFIndex                           // target CR field
  , rsv1    : Bits<2>
  , ra      : XIndex                             // source register
  , rb      : XIndex                             // source register
  , extopcd : Ext10                              // extended opcode
  , rsv2    : Bit
  }

  format XFormF : Instr =
  { opcd    : OpCode                             // opcode
  , rs      : XIndex                             // source register
  , rsv1    : Nibble
  , l       : Bit                                // changes which bits of MSR are set
  , rsv2    : Bits<5>
  , extopcd : Ext10                              // extended opcode
  , rsv3    : Bit
  }

  format XFormG : Instr =
  { opcd    : OpCode                             // opcode
  , to      : Bits<5>                            // selects trap condition(s)
  , ra      : XIndex                             // source register
  , rb      : XIndex                             // source register
  , extopcd : Ext10                              // extended opcode
  , rsv     : Bit
  }

  format XFXFormA : Instr =
  { opcd    : OpCode                             // opcode
  , rs      : XIndex                             // source/ target register
  , m       : Bit                                // if set the instruction only reads from/ writes to a single CR field
  , fxm     : Bits<8>                            // CR field mask
  , rsv1    : Bit
  , extopcd : Ext10                              // extended opcode
  , rsv2    : Bit
  }

  format XFXFormB : Instr =
  { opcd    : OpCode                             // opcode
  , rs      : XIndex                             // source/ target register
  , spr     : SIndex                             // source/ target special-purpose register
  , extopcd : Ext10                              // extended opcode
  , rsv     : Bit
  }

  format XLFormA : Instr =
  { opcd    : OpCode                             // opcode
  , crbt    : CRBIndex                           // target CR bit
  , crbs1   : CRBIndex                           // source CR bit
  , crbs2   : CRBIndex                           // source CR bit
  , extopcd : Ext10                              // extended opcode
  , rsv     : Bit
  }

  format XLFormB : Instr =
  { opcd    : OpCode                             // opcode
  , bo      : Bits<5>                            // branch options and hints
  , crbs    : CRBIndex                           // CR bit to test
  , rsv     : Bits<3>
  , bh      : Bits<2>                            // branch return hints
  , extopcd : Ext10                              // extended opcode
  , lk      : Bit                                // if set the link register is set to PC.next
  }

  format XLFormC : Instr =
  { opcd : OpCode                                // opcode
  , crft : CRFIndex                              // target CR field
  , rsv1 : Bits<2>
  , crfs : CRFIndex                              // source CR field
  , rsv2 : Bits<18>
  }

  format XOForm : Instr =
  { opcd    : OpCode                             // opcode
  , rs      : XIndex                             // target register
  , ra      : XIndex                             // source register
  , rb      : XIndex                             // source register
  , oe      : Bit                                // if set the instruction modifies so, ov and ov32
  , extopcd : Ext9                               // extended opcode
  , rc      : Bit                                // if set the instruction modifies the CR
  }

  format Z23Form : Instr =
  { opcd    : OpCode                             // opcode
  , rs      : XIndex                             // target register
  , ra      : XIndex                             // source register
  , rb      : XIndex                             // source register
  , cy      : Bits<2>                            // all values other than 0b00 are reserved
  , extopcd : Ext8                               // extended opcode
  , rsv     : Bit
  }

  record AsmExt       (asm : Str, ext : Bin)
  record AsmOpcd      (asm : Str, opcd : Bin)
  record AsmOpExt     (asm : Str, op : SymEx, ext : Bin)
  record AsmOpOpcd    (asm : Str, op : SymEx, opcd : Bin)
  record AsmOpOpcdId  (asm : Str, op : SymEx, opcd : Bin, id : Id)    // required for addic[.]
  record TwoArgs      (arg1 : Ex, arg2 : Ex)

  function nand1 (a : Bool, b : Bool) -> Bool = ~(a & b)
  function nor1  (a : Bool, b : Bool) -> Bool = ~(a | b)
  function nxor1 (a : Bool, b : Bool) -> Bool = ~(a ^ b)

  function nand64 (a : DWord, b : DWord) -> DWord = ~(a & b)
  function nor64  (a : DWord, b : DWord) -> DWord = ~(a | b)
  function nxor64 (a : DWord, b : DWord) -> DWord = ~(a ^ b)

  // converts lev field to 2-bit SRR representation
  function srrlev (lev : Bits<7>) -> Bits<2> =
    match lev with
    { 1 as Bits<7> => 1 as Bits<2>
    , 2 as Bits<7> => 2 as Bits<2>
    , _            => 0 as Bits<2>
    }

  // converts binary coded decimal to declet
  function bcdtodpd (n : Bits<12>) -> Bits<10> =
    ((n(6) & n(11) & n(3) & ~n(7)) | (n(2) & n(11) & ~n(3)) | (n(10) & ~n(11)),
     (n(5) & n(11) & n(3) & ~n(7)) | (n(1) & n(11) & ~n(3)) | (n(9) & ~n(11)),
     n(8),
     (n(2) & ~n(11) & n(7) & ~n(3)) | (n(6) & ~n(3) & ~n(7)) | (n(6) & ~n(11) & ~n(7)) | (n(7) & n(3)),
     (n(1) & ~n(11) & n(7) & ~n(3)) | (n(5) & ~n(3) & ~n(7)) | (n(5) & ~n(11) & ~n(7)) | (n(11) & n(3)),
     n(4),
     n(11) | n(7) | n(3),
     (~n(7) & n(2) & ~n(3)) | (n(7) & n(3)) | n(11),
     (~n(11) & n(1) & ~n(3)) | (n(11) & n(3)) | n(7),
     n(0))

  // converts declet to binary coded decimal
  function dpdtobcd (n : Bits<10>) -> Bits<12> =
    ((~n(6) & n(3) & n(2)) | (n(5) & n(3) & n(2) & n(6)) | (n(3) & n(2) & ~n(1)),
     (n(9) & n(6) & n(1) & ~n(5)) | (n(9) & ~n(2)) | (n(9) & ~n(3)),
     (n(8) & n(6) & n(1) & ~n(5)) | (n(8) & ~n(2)) | (n(8) & ~n(3)),
     n(7),
     (n(3) & ~n(2) & n(1)) | (n(6) & n(3) & n(2) & n(1)) | (~n(5) & n(3) & n(1) & n(2)),
     (n(9) & n(5) & n(3) & n(2) & n(1) & ~n(6)) | (n(6) & ~n(1) & n(3)) | (n(6) & ~n(3)),
     (n(8) & n(5) & n(2) & n(3) & n(1) & ~n(6)) | (n(5) & ~n(1) & n(3)) | (n(5) & ~n(3)),
     n(4),
     (n(5) & n(3) & n(2) & n(1)) | (n(6) & n(3) & n(2) & n(1)) | (n(3) & ~n(2) & ~n(1)),
     (n(9) & ~n(6) & ~n(5) & n(2) & n(3)) | (n(6) & n(3) & ~n(2) & n(1)) | (n(9) & n(2) & ~n(1) & n(3)) | (n(2) & ~n(3)),
     (n(8) & ~n(6) & ~n(5) & n(3) & n(2)) | (n(5) & n(3) & ~n(2) & n(1)) | (n(8) & n(3) & n(2) & ~n(1)) | (n(1) & ~n(3)),
     n(0))

  // reverses the byte order of each halfword in a word
  function byterevhinw (n : Word) -> Word = (n(23..16), n(31..24), n(7..0), n(15..8))

  // reverses the byte order of a half
  function byterevh (n : Half) -> Half = (n(7..0), n(15..8))

  // reverses the byte order of a word
  function byterevw (n : Word) -> Word = (n(7..0), n(15..8), n(23..16), n(31..24))

  // generates a wrapping 64-bit mask
  function mask (start : Bits<6>, end : Bits<6>) -> DWord =
    let lo = VADL::lsl(maxU64, start) in
      let hi = VADL::lsr(maxU64, 63 - end) in
        if start <= end
        then lo & hi
        else lo | hi

  // triggered by the tw and twi instructions if at least one trap condition evaluates to true
  exception Trap () = {
    SRR0 := PC
    SRR1 := (MSR(63..31), 0 as Nibble, MSR(26..22), 0 as Nibble, 1 as Bit, 0 as Bit, MSR(15..0))
    PC   := 0x0000'0000'0000'0700
    MSR  := 0x8000'0000'0000'1000
  }

  // triggered when a privileged instruction gets called in an unprivileged processor state
  exception Privilege () = {
    SRR0 := PC
    SRR1 := (MSR(63..31), 0 as Nibble, MSR(26..22), 0 as Bits<3>, 1 as Bit, 0 as Bits<2>, MSR(15..0))
    PC   := 0x0000'0000'0000'0700
  }

  // TODO?: complete exception
  // note: named hypervisor emulation assistance interrupt in PowerPC specification, not implemented
  // triggered by an illegal instruction format
  exception Illegal () = {}

  // triggered by a system call instruction
  exception SysCall (lev : Bits<7>) = {
    SRR0 := PC.next
    SRR1 := (MSR(63..31), 0 as Nibble, MSR(26..22), srrlev(lev), 0 as Nibble, MSR(15..0))
    PC   := 0x0000'0000'0000'0C00
  }

  // triggered by a system call vectored instruction
  exception SysCallVectored () = {
    LR  := PC.next
    CTR := (MSR(63..31), 0 as Nibble, MSR(26..22), 0 as Bits<6>, MSR(15..0))
    PC  := 0x0000'0000'0001'0700
  }

  // conditionally places a stat
  model CS (c : Bool, stat : Stat) : Stat = {
    match : Stat ( $c = true => $stat; _ => {} )
  }

  // asm string functions, convert boolean field values into their corresponding assembly representations
  model rStr (r : Bool) : Str = { match : Str ( $r = true => "."; _ => "" ) }
  model rId  (r : Bool) : Str = { match : Str ( $r = true => "_"; _ => "" ) }
  model lStr (l : Bool) : Str = { match : Str ( $l = true => "L"; _ => "" ) }
  model orStr (o : Bool, r : Bool) : Str = {
    match : Str
    ( $o = true => match : Str ( $r = true => "O."; _ => "O" )
    ; _         => match : Str ( $r = true => "." ; _ => ""  )
    )
  }
  model orId  (o : Bool, r : Bool) : Str = {
    match : Str
    ( $o = true => match : Str ( $r = true => "O_"; _ => "O" )
    ; _         => match : Str ( $r = true => "_" ; _ => ""  )
    )
  }
  model laStr (l : Bool, a : Bool) : Str = {
    match : Str
    ( $l = true => match : Str ( $a = true => "LA"; _ => "L" )
    ; _         => match : Str ( $a = true => "A" ; _ => ""  )
    )
  }

  // read from CR bit
  model ReadCRB (crb : Ex) : Ex = {
    (CRF($crb / 4) >> (3 - $crb % 4)) as Bit
  }

  // write to CR bit
  model WriteCRB (crb : Ex, val : Ex) : Stat = {
    let crf = $crb / 4 in
      let shift = 3 - $crb % 4 in
        CRF(crf) := (CRF(crf) & ~(1 as Nibble << shift)) | ($val as Nibble << shift)
  }


  model SetCRBase (dst : Ex, a : TwoArgs, so : Ex) : Stat = {
    let a1 = $a.arg1 in
      let a2 = $a.arg2 in
        CRF($dst) := (a1 < a2, a1 > a2, a1 = a2, $so)
  }

  // sets CR field 0 based on signed comparison of the result to zero
  model SetCR0 (rc : Bool, so : Ex) : Stat = {
    $CS($rc;
      $SetCRBase(0;
      ( let sfmask = MSR.sf as SDWord in
          ((result          as SDWord) &  sfmask) |
          ((result as SWord as SDWord) & ~sfmask)
      ; 0
      ); $so)
    )
  }

  // sets CR field based on signed/unsigned comparison between two arguments
  model SetCRCmp (a : TwoArgs, ctype : Id) : Stat = {
    $SetCRBase(crft;
    ( $a.arg1 as $ctype
    ; $a.arg2 as $ctype
    ); XER_SO)
  }

  model SetXERBase (oe : Bool, ce : Bool, ov32 : Ex) : Stat = {
    {
      $CS($oe; {
        XER_SO   := so
        XER_OV   := ov
        XER_OV32 := $ov32
      })
      $CS($ce; {
        XER_CA   := (flags64.carry && MSR.sf) || (flags32.carry && ~MSR.sf)
        XER_CA32 := flags32.carry
      })
    }
  }

  // sets fixed-point exception register and condition register
  model SetFlags (oe : Bool, ce : Bool, rc : Bool, ov32 : Ex, ov : Ex) : Stat = {
    match : Stat
    ( $oe = true => let ov = $ov in
                      let so = XER_SO | ov in {
                        $SetXERBase(true; $ce; $ov32)
                        $SetCR0($rc; so)
                      }
    ; _          => {
                      $SetXERBase(false; $ce; $ov32)
                      $SetCR0($rc; XER_SO)
                    }
    )
  }

  // read value from special-purpose register to X(rs)
  model ReadSPR () : Stat = {
    let rspr = (spr(4..0), spr(9..5)) in
      match rspr with
      { SPRIndex::XER => X(rs) := (XER_SO, XER_OV, XER_CA, XER_BASE(28..20), XER_OV32, XER_CA32, XER_BASE(17..0)) as DWord
      , SPRIndex::LR  => X(rs) := LR
      , SPRIndex::CTR => X(rs) := CTR
      , SPRIndex::TBL => X(rs) := TB
      , SPRIndex::TBH => X(rs) := TB(63..32) as DWord
      , 0b11001'01000 => {}
      , 0b11001'01001 => {}
      , 0b11001'01010 => {}
      , 0b11001'01011 => {}
      , SPRIndex::TAR => X(rs) := TAR
      , _ => if spr(9) = 0 then raise Illegal
                           else raise Privilege
      }
  }

  // writes value from X(rs) to special-purpose register
  model WriteSPR () : Stat = {
    let rspr = (spr(4..0), spr(9..5)) in
      match rspr with
      { SPRIndex::XER => {
                           XER_SO   := X(rs)(31)
                           XER_OV   := X(rs)(30)
                           XER_CA   := X(rs)(29)
                           XER_OV32 := X(rs)(19)
                           XER_CA32 := X(rs)(18)
                           XER_BASE := XW(rs)
                         }
      , SPRIndex::LR  => LR  := X(rs)
      , SPRIndex::CTR => CTR := X(rs)
      , 0b11001'01000 => {}
      , 0b11001'01001 => {}
      , 0b11001'01010 => {}
      , 0b11001'01011 => {}
      , SPRIndex::TAR => TAR := X(rs)
      , _ => if spr(9) = 0 then raise Illegal
                           else raise Privilege
      }
  }

  // reads Byte/ Halfword/ Word from memory into X(dst)
  model ReadMem (ea : Id, unit : SymEx, dst : Ex, rev : Bool, type : Id) : Stat = {
    match : Stat
    ( $unit = Unit::Word => match : Stat
                            ( $rev = true => X($dst) := byterevw(MEM<4>($ea)) as $type
                            ; _           => X($dst) := MEM<4>($ea)           as $type
                            )
    ; $unit = Unit::Half => match : Stat
                            ( $rev = true => X($dst) := byterevh(MEM<2>($ea)) as $type
                            ; _           => X($dst) := MEM<2>($ea)           as $type
                            )
    ; _                  => X($dst) := MEM($ea) as $type
    )
  }

  // writes Byte/ Halfword/ Word from X(src) into memory
  model WriteMem (ea : Id, unit : SymEx, src : Id, rev : Bool) : Stat = {
    match : Stat
    ( $unit = Unit::Word => match : Stat
                            ( $rev = true => MEM<4>($ea) := byterevw(XW($src))
                            ; _           => MEM<4>($ea) := XW($src)
                            )
    ; $unit = Unit::Half => match : Stat
                            ( $rev = true => MEM<2>($ea) := byterevh(XH($src))
                            ; _           => MEM<2>($ea) := XH($src)
                            )
    ; _                  => MEM($ea) := XB($src)
    )
  }

  // computes the target address for b and bc instructions
  model TargetAddrImm (imm : Id, aa : Bool) : Ex = {
    match : Ex
    ( $aa = true =>  $imm       & (MSR.sf as SWord, maxU32)
    ; _          => ($imm + PC) & (MSR.sf as SWord, maxU32)
    )
  }

  // computes the target address for bclr, bcctr and bctar instructions
  model TargetAddrReg (reg : Id) : Ex = {
    let ta = $reg(63..2) as DWord << 2 in
      ta & (MSR.sf as SWord, maxU32)
  }

  model BFormBranchInstrExt (asm : Str, lk : Bool, aa : Bool) : IsaDefs = {
    instruction AsId($asm, $laStr($lk; $aa)) : BForm = {
      $CS($lk; LR := PC.next)
      let nctr = CTR - ~bo(2) as UDWord in
        let mctr = nctr & (MSR.sf as SWord, maxU32) in {
          if (bo(2) | ((mctr != 0) ^ bo(1))) & (bo(4) | ($ReadCRB(crbs) = bo(3)))
          then PC := $TargetAddrImm(extBd; $aa)
          CTR := nctr
        }
    }
    encoding AsId($asm, $laStr($lk; $aa)) =
      {opcd = 0b010000, aa = $aa, lk = $lk}
    assembly AsId($asm, $laStr($lk; $aa)) =
      ($asm, $laStr($lk; $aa), " ", udec(bo), ",", udec(crbs), ",", udec($TargetAddrImm(extBd; $aa)))
  }

  // instructions: bc[l][a]
  model BFormBranchInstr (asm : Str) : IsaDefs = {
    $BFormBranchInstrExt($asm; false; false)
    $BFormBranchInstrExt($asm; false; true )
    $BFormBranchInstrExt($asm; true ; false)
    $BFormBranchInstrExt($asm; true ; true )
  }

  // instructions: addi, addic, addic., addis, subfic
  model DFormAddSubInstr (x : AsmOpOpcdId, a : TwoArgs, rc : Bool, ce : Bool) : IsaDefs = {
    instruction $x.id : DFormA =
      let result32, flags32 = VADL::$x.op($a.arg1 as Word, $a.arg2 as Word) in
        let result, flags64 = VADL::$x.op($a.arg1        , $a.arg2        ) in {
          X(rs) := result
          $SetFlags(false; $ce; $rc; flags32.overflow;
            (flags64.overflow && MSR.sf) || (flags32.overflow && ~MSR.sf))
        }
    encoding $x.id = {opcd = $x.opcd}
    assembly $x.id = ($x.asm, $rStr($rc), " ", udec(rs), ",", udec(ra), ",", sdec(imm))
  }

  // instructions: andi., andis., ori, oris, xori, xoris
  model DFormLogicalInstr (x : AsmOpOpcd, arg2 : Id, rc : Bool) : IsaDefs = {
    instruction AsId($x.asm, $rId($rc)) : DFormA =
      let result = VADL::$x.op(X(rs), $arg2) in {
        X(ra) := result
        $SetCR0($rc; XER_SO)
      }
    encoding AsId($x.asm, $rId($rc)) =
      {opcd = $x.opcd}
    assembly AsId($x.asm, $rId($rc)) =
      ($x.asm, $rStr($rc), " ", udec(ra), ",", udec(rs), ",", udec(imm))
  }

  // instructions: lbz, lbzu, lha, lhau, lhz, lhzu, lwz, lwzu
  model DFormLoadInstr (x : AsmOpcd, unit : SymEx, update : Bool, type : Id) : IsaDefs = {
    [undefined when : $update && (ra = 0 || ra = rs)]
    instruction AsId($x.asm) : DFormA =
      let ea = XZ(ra) + immS in
        let mea = ea & (MSR.sf as SWord, maxU32) in {
          $ReadMem(mea; $unit; rs; false; $type)
          $CS($update; X(ra) := ea)
        }
    encoding AsId($x.asm) = {opcd = $x.opcd}
    assembly AsId($x.asm) = ($x.asm, " ", udec(rs), ",", sdec(imm), "(", udec(ra), ")")
  }

  // instructions: mulli
  model DFormMulInstr (asm : Str) : IsaDefs = {
    instruction AsId($asm) : DFormA =
      X(rs) := X(ra) * immS
    encoding AsId($asm) = {opcd = 0b000111}
    assembly AsId($asm) = ($asm, " ", udec(rs), ",", udec(ra), ",", sdec(imm))
  }

  // instructions: stb, stbu, sth, sthu, stw, stwu
  model DFormStoreInstr (x : AsmOpcd, unit : SymEx, update : Bool) : IsaDefs = {
    [undefined when : $update && ra = 0]
    instruction AsId($x.asm) : DFormA =
      let ea = XZ(ra) + immS in
        let mea = ea & (MSR.sf as SWord, maxU32) in {
          $WriteMem(mea; $unit; rs; false)
          $CS($update; X(ra) := ea)
        }
    encoding AsId($x.asm) = {opcd = $x.opcd}
    assembly AsId($x.asm) = ($x.asm, " ", udec(rs), ",", sdec(imm), "(", udec(ra), ")")
  }

  record DFormCmpInstrRec (x : AsmOpcd, u : Bool)

  model DFormCmpInstrExt (r : DFormCmpInstrRec, l : Bool, s : Str) : IsaDefs = {
    instruction AsId($r.x.asm, $s) : DFormB =
      $SetCRCmp((X(rs); match : Id ( $r.u = true => immU; _ => immS ));
        match : Id
        ( $l = true => match : Id ( $r.u = true => UDWord; _ => SDWord )
        ; _         => match : Id ( $r.u = true => UWord ; _ => SWord  )
        )
      )
    encoding AsId($r.x.asm, $s) =
      {opcd = $r.x.opcd, rsv = 0b0, l = $l}
    assembly AsId($r.x.asm, $s) =
      ($r.x.asm, " ", udec(crft), ",", udec($l), ",", udec(rs), ",", match : Ex
                                                                     ( $r.u = true => udec(imm)
                                                                     ; _           => sdec(imm)
                                                                     ))
  }

  // instructions: cmpi, cmpli
  model DFormCmpInstr (r : DFormCmpInstrRec) : IsaDefs = {
    $DFormCmpInstrExt($r; false; "32")
    $DFormCmpInstrExt($r; true ; "64")
  }

  // instructions: twi
  model DFormTrapInstr (asm : Str) : IsaDefs = {
    instruction AsId($asm) : DFormC =
      let a = XW(rs) as SDWord in
        if ((VADL::slth(a, immS)) & to(4)) | ((VADL::sgth(a, immS)) & to(3)) |
           ((a = immS)            & to(2)) | ((VADL::ulth(a, immS)) & to(1)) |
           ((VADL::ugth(a, immS)) & to(0))
        then raise Trap
    encoding AsId($asm) = {opcd = 0b000011}
    assembly AsId($asm) = ($asm, " ", udec(to), ",", udec(rs), ",", sdec(imm))
  }

  // instructions: addpcis
  model DXFormAddInstr (asm : Str) : IsaDefs = {
    instruction AsId($asm) : DXForm =
      X(rs) := PC.next + shImmS
    encoding AsId($asm) = {opcd = 0b010011, rsv = 0b00010}
    assembly AsId($asm) = ($asm, " ", udec(rs), ",", sdec(imm))
  }

  model IFormBranchInstrExt (asm : Str, lk : Bool, aa : Bool) : IsaDefs = {
    instruction AsId($asm, $laStr($lk; $aa)) : IForm = {
      $CS($lk; LR := PC.next)
      PC := $TargetAddrImm(extLi; $aa)
    }
    encoding AsId($asm, $laStr($lk; $aa)) =
      {opcd = 0b010010, aa = $aa, lk = $lk}
    assembly AsId($asm, $laStr($lk; $aa)) =
      ($asm, $laStr($lk; $aa), " ", udec($TargetAddrImm(extLi; $aa)))
  }

  // instructions: b[l][a]
  model IFormBranchInstr (asm : Str) : IsaDefs = {
    $IFormBranchInstrExt($asm; false; false)
    $IFormBranchInstrExt($asm; false; true )
    $IFormBranchInstrExt($asm; true ; false)
    $IFormBranchInstrExt($asm; true ; true )
  }

  record MFormRotateInstrRec (x : AsmOpcd, rot : Ex, res : Ex)

  model MFormRotateInstrExt (r : MFormRotateInstrRec, rc : Bool) : IsaDefs = {
    instruction AsId($r.x.asm, $rId($rc)) : MForm =
      let r = VADL::rol((XW(rs),XW(rs)), $r.rot) in
        let m = mask (31 - me6, 31 - mb6) in
          let result = $r.res in {
            X(ra) := result
            $SetCR0($rc; XER_SO)
          }
    encoding AsId($r.x.asm, $rId($rc)) =
      {opcd = $r.x.opcd, rc = $rc}
    assembly AsId($r.x.asm, $rId($rc)) =
      ($r.x.asm, $rStr($rc), " ", udec(ra), ",", udec(rs), ",", udec(sh), ",", udec(mb), ",", udec(me))
  }

  // instructions: rlwimi[.], rlwinm[.], rlwnm[.]
  model MFormRotateInstr (r : MFormRotateInstrRec) : IsaDefs = {
    $MFormRotateInstrExt($r; false)
    $MFormRotateInstrExt($r; true )
  }

  // instructions: sc, scv
  model SCFormSysCallInstr (x : AsmExt, ex : CallEx) : IsaDefs = {
    instruction AsId($x.asm) : SCForm =
      raise $ex
    encoding AsId($x.asm) = {opcd = 0b010001, rsv1 = 0b00000'00000'0000, rsv2 = 0b000, extopcd = $x.ext}
    assembly AsId($x.asm) = ($x.asm, " ", udec(lev))
  }

  record XFormArithmeticShiftInstrRec (x : AsmExt, shift : Ex, res : Ex)

  model XFormArithmeticShiftInstrExt (r : XFormArithmeticShiftInstrRec, rc : Bool) : IsaDefs = {
    instruction AsId($r.x.asm, $rId($rc)) : XFormA =
      let r = VADL::asr((XW(rs), 0 as Word), $r.shift) in
        let result = $r.res in
          let ca = if $r.shift > 31 then X(rs)(31) else X(rs)(31) & (r(31..0) != 0) in {
            X(ra) := result
            XER_CA   := ca
            XER_CA32 := ca
            $SetCR0($rc; XER_SO)
          }
    encoding AsId($r.x.asm, $rId($rc)) =
      {opcd = 0b011111, extopcd = $r.x.ext, rc = $rc}
    assembly AsId($r.x.asm, $rId($rc)) =
      ($r.x.asm, $rStr($rc), " ", udec(ra), ",", udec(rs), ",", udec(rb))
  }

  // instructions: sraw[.], srawi[.]
  model XFormArithmeticShiftInstr (r : XFormArithmeticShiftInstrRec) : IsaDefs = {
    $XFormArithmeticShiftInstrExt($r; false)
    $XFormArithmeticShiftInstrExt($r; true )
  }

  // instructions: cbcdtd, cdtbcd
  model XFormBinCodedDecInstr (x : AsmExt, dpdsrc : Bool) : IsaDefs = {
    instruction AsId($x.asm) : XFormA =
      X(ra) := match : Ex
               ( $dpdsrc = true => (0 as Byte    , dpdtobcd(X(rs)(51..42)), dpdtobcd(X(rs)(41..32)),
                                    0 as Byte    , dpdtobcd(X(rs)(19..10)), dpdtobcd(X(rs)( 9.. 0)))
               ; _              => (0 as Bits<12>, bcdtodpd(X(rs)(55..44)), bcdtodpd(X(rs)(43..32)),
                                    0 as Bits<12>, bcdtodpd(X(rs)(23..12)), bcdtodpd(X(rs)(11.. 0)))
               )
    encoding AsId($x.asm) = {opcd = 0b011111, rb = 0b00000, extopcd = $x.ext, rc = 0b0}
    assembly AsId($x.asm) = ($x.asm, " ", udec(ra), ",", udec(rs))
  }

  // instructions: cmpb
  model XFormCmpBytesInstr (asm : Str) : IsaDefs = {
    instruction AsId($asm) : XFormA =
      X(ra) := (if X(rs)(63..56) = X(rb)(63..56) then 0xFF as Byte else 0,
                if X(rs)(55..48) = X(rb)(55..48) then 0xFF as Byte else 0,
                if X(rs)(47..40) = X(rb)(47..40) then 0xFF as Byte else 0,
                if X(rs)(39..32) = X(rb)(39..32) then 0xFF as Byte else 0,
                if X(rs)(31..24) = X(rb)(31..24) then 0xFF as Byte else 0,
                if X(rs)(23..16) = X(rb)(23..16) then 0xFF as Byte else 0,
                if X(rs)(15.. 8) = X(rb)(15.. 8) then 0xFF as Byte else 0,
                if X(rs)( 7.. 0) = X(rb)( 7.. 0) then 0xFF as Byte else 0)
    encoding AsId($asm) = {opcd = 0b011111, extopcd = 0b01111'11100, rc = 0b0}
    assembly AsId($asm) = ($asm, " ", udec(ra), ",", udec(rs), ",", udec(rb))
  }

  record XFormExCRInstrRec (x : AsmExt, res : Ex)

  model XFormExCRInstrExt (r : XFormExCRInstrRec, rc : Bool) : IsaDefs = {
    instruction AsId($r.x.asm, $rId($rc)) : XFormA =
      let result = $r.res in {
        X(ra) := result
        $SetCR0($rc; XER_SO)
      }
    encoding AsId($r.x.asm, $rId($rc)) =
      {opcd = 0b011111, rb = 0b00000, extopcd = $r.x.ext, rc = $rc}
    assembly AsId($r.x.asm, $rId($rc)) =
      ($r.x.asm, $rStr($rc), " ", udec(ra), ",", udec(rs))
  }

  // instructions: extsb[.], extsh[.], cntlzw[.], cnttzw[.]
  model XFormExCRInstr (r : XFormExCRInstrRec) : IsaDefs = {
    $XFormExCRInstrExt($r; false)
    $XFormExCRInstrExt($r; true )
  }

  // instructions: lbzx, lbzux, lhax, lhaux, lhzx, lhzux, lwzx, lwzux, lwbrx
  model XFormLoadInstr (x : AsmExt, unit : SymEx, type : Id, update : Bool, rev : Bool) : IsaDefs = {
    [undefined when : $update && (ra = 0 || ra = rs)]
    instruction AsId($x.asm) : XFormA =
      let ea = XZ(ra) + X(rb) in
        let mea = ea & (MSR.sf as SWord, maxU32) in {
          $ReadMem(mea; $unit; rs; $rev; $type)
          $CS($update; X(ra) := ea)
        }
    encoding AsId($x.asm) = {opcd = 0b011111, extopcd = $x.ext, rc = 0b0}
    assembly AsId($x.asm) = ($x.asm, " ", udec(rs), ",", udec(ra), ",", udec(rb))
  }

  record XFormLogicalInstrRec (x : AsmOpExt, arg2 : Ex)

  model XFormLogicalInstrExt (r : XFormLogicalInstrRec, rc : Bool) : IsaDefs = {
    instruction AsId($r.x.asm, $rId($rc)) : XFormA =
      let result = $r.x.op(X(rs), $r.arg2) in {
        X(ra) := result
        $SetCR0($rc; XER_SO)
      }
    encoding AsId($r.x.asm, $rId($rc)) =
      {opcd = 0b011111, extopcd = $r.x.ext, rc = $rc}
    assembly AsId($r.x.asm, $rId($rc)) =
      ($r.x.asm, $rStr($rc), " ", udec(ra), ",", udec(rs), ",", udec(rb))
  }

  // instructions: and[.], andc[.], eqv[.], nand[.], nor[.], or[.], orc[.], xor[.]
  model XFormLogicalInstr (r : XFormLogicalInstrRec) : IsaDefs = {
    $XFormLogicalInstrExt($r; false)
    $XFormLogicalInstrExt($r; true )
  }

  model XFormLogicalShiftInstrExt (x : AsmOpExt, rc : Bool) : IsaDefs = {
    instruction AsId($x.asm, $rId($rc)) : XFormA =
      let result = if X(rb)(5) = 0 then VADL::$x.op(XW(rs), X(rb)(4..0)) as DWord else 0 in {
        X(ra) := result
        $SetCR0($rc; XER_SO)
      }
    encoding AsId($x.asm, $rId($rc)) =
      {opcd = 0b011111, extopcd = $x.ext, rc = $rc}
    assembly AsId($x.asm, $rId($rc)) =
      ($x.asm, $rStr($rc), " ", udec(ra), ",", udec(rs), ",", udec(rb))
  }

  // instructions: slw[.], srw[.]
  model XFormLogicalShiftInstr (x : AsmOpExt) : IsaDefs = {
    $XFormLogicalShiftInstrExt($x; false)
    $XFormLogicalShiftInstrExt($x; true )
  }

  // instructions: modsw, moduw
  model XFormModInstr (x : AsmOpExt, type : Id) : IsaDefs = {
    instruction AsId($x.asm) : XFormA =
      X(rs) := if XW(rb) != 0
               then VADL::$x.op(XW(ra), XW(rb)) as $type
               else 0
    encoding AsId($x.asm) = {opcd = 0b011111, extopcd = $x.ext, rc = 0b0}
    assembly AsId($x.asm) = ($x.asm, " ", udec(rs), ",", udec(ra), ",", udec(rb))
  }

  // instruction: mfmsr
  model XFormMSRGPRInstr (asm : Str) : IsaDefs = {
    instruction AsId($asm) : XFormA =
      if MSR.pr = 0 then X(rs) := MSR
                    else raise Privilege
    encoding AsId($asm) = {opcd = 0b011111, ra = 0b00000, rb = 0b00000, extopcd = 0b00010'10011, rc = 0b0}
    assembly AsId($asm) = ($asm, " ", udec(rs))
  }

  // instructions: prtyw
  model XFormParityInstr (asm : Str) : IsaDefs = {
    instruction AsId($asm) : XFormA =
      X(ra) := ((VADL::cob(X(rs) & 0x01010101'00000000) & 1) as Word,
                (VADL::cob(X(rs) & 0x00000000'01010101) & 1) as Word)
    encoding AsId($asm) = {opcd = 0b011111, rb = 0b00000, extopcd = 0b00100'11010, rc = 0b0}
    assembly AsId($asm) = ($asm, " ", udec(ra), ",", udec(rs))
  }

  // instructions: popcntb, popcntw
  model XFormPopCountInstr (x : AsmExt, unit : SymEx) : IsaDefs = {
    instruction AsId($x.asm) : XFormA =
      X(ra) := match : Ex
               ( $unit = Unit::Byte => (VADL::cob(X(rs)(63..56)), VADL::cob(X(rs)(55..48)),
                                        VADL::cob(X(rs)(47..40)), VADL::cob(X(rs)(39..32)),
                                        VADL::cob(X(rs)(31..24)), VADL::cob(X(rs)(23..16)),
                                        VADL::cob(X(rs)(15.. 8)), VADL::cob(X(rs)( 7.. 0)))
               ; _                  => (VADL::cob(X(rs)(63..32)), VADL::cob(X(rs)(31.. 0)))
               )
    encoding AsId($x.asm) = {opcd = 0b011111, rb = 0b00000, extopcd = $x.ext, rc = 0b0}
    assembly AsId($x.asm) = ($x.asm, " ", udec(ra), ",", udec(rs))
  }

  // instructions: brh, brw
  model XFormReverseInstr (x : AsmExt, unit : SymEx) : IsaDefs = {
    instruction AsId($x.asm) : XFormA =
      X(ra) := match : Ex
               ( $unit = Unit::Half => (byterevhinw(X(rs)(63..32)), byterevhinw(X(rs)(31..0)))
               ; _                  => (byterevw   (X(rs)(63..32)), byterevw   (X(rs)(31..0)))
               )
    encoding AsId($x.asm) = {opcd = 0b011111, rb = 0b00000, extopcd = $x.ext, rc = 0b0}
    assembly AsId($x.asm) = ($x.asm, " ", udec(ra), ",", udec(rs))
  }

  // instructions: stbx, stbux, sthx, sthux, sthbrx, stwx, stwux, stwbrx
  model XFormStoreInstr (x : AsmExt, unit : SymEx, update : Bool, rev : Bool) : IsaDefs = {
    [undefined when : $update && ra = 0]
    instruction AsId($x.asm) : XFormA =
      let ea = XZ(ra) + X(rb) in
        let mea = ea & (MSR.sf as SWord, maxU32) in {
          $WriteMem(mea; $unit; rs; $rev)
          $CS($update; X(ra) := ea)
        }
    encoding AsId($x.asm) = {opcd = 0b011111, extopcd = $x.ext, rc = 0b0}
    assembly AsId($x.asm) = ($x.asm, " ", udec(rs), ",", udec(ra), ",", udec(rb))
  }

  record XFormCmpInstrRec (x : AsmExt, u : Bool)

  model XFormCmpInstrExt (r : XFormCmpInstrRec, l : Bool, s : Str) : IsaDefs = {
    instruction AsId($r.x.asm, $s) : XFormB =
      $SetCRCmp((X(ra); X(rb));
        match : Id
        ( $l = true => match : Id ( $r.u = true => UDWord; _ => SDWord )
        ; _         => match : Id ( $r.u = true => UWord ; _ => SWord  )
        )
      )
    encoding AsId($r.x.asm, $s) =
      {opcd = 0b011111, rsv1 = 0b0, l = $l, extopcd = $r.x.ext, rsv2 = 0b0}
    assembly AsId($r.x.asm, $s) =
      ($r.x.asm, " ", udec(crft), ",", udec($l), ",", udec(ra), ",", udec(rb))
  }

  // instructions: cmp, cmpl
  model XFormCmpInstr (r : XFormCmpInstrRec) : IsaDefs = {
    $XFormCmpInstrExt($r; false; "32")
    $XFormCmpInstrExt($r; true ; "64")
  }

  // instructions: cmprb
  model XFormCmpRangedBytesInstr (asm : Str) : IsaDefs = {
    instruction AsId($asm) : XFormB =
      let b = XB(ra) as UByte in
        let m = ((X(rb)( 7.. 0) <= b) & (b <= X(rb)(15.. 8))    ) |
                ((X(rb)(23..16) <= b) & (b <= X(rb)(31..24)) & l) in
          CRF(crft) := (0 as Bit, m, 0 as Bits<2>)
    encoding AsId($asm) = {opcd = 0b011111, rsv1 = 0b0, extopcd = 0b00110'00000, rsv2 = 0b0}
    assembly AsId($asm) = ($asm, " ", udec(crft), ",", udec(l), ",", udec(ra), ",", udec(rb))
  }

  // instructions: setb
  model XFormBoolInstr (asm : Str) : IsaDefs = {
    instruction AsId($asm) : XFormC =
      X(rs) := let crf = CRF(crfs) in
                 if      crf(3) then maxU64
                 else if crf(2) then oneU64
                 else                zeroU64
    encoding AsId($asm) = {opcd = 0b011111, rsv1 = 0b0000000, extopcd =  0b00100'00000, rsv2 = 0b0}
    assembly AsId($asm) = ($asm, " ", udec(rs), ",", udec(crfs))
  }

  // instructions: setbc, setbcr, setnbc, setnbcr
  model XFormBoolCondInstr (x : AsmExt, res : Ex) : IsaDefs = {
    instruction AsId($x.asm) : XFormD =
      let s = $ReadCRB(crbs) in
        X(rs) := $res
    encoding AsId($x.asm) = {opcd = 0b011111, rsv1 = 0b00000, extopcd = $x.ext, rsv2 = 0b0}
    assembly AsId($x.asm) = ($x.asm, " ", udec(rs), ",", udec(crbs))
  }

  // instructions: cmpeqb
  model XFormCmpEqBytesInstr (asm : Str) : IsaDefs = {
    instruction AsId($asm) : XFormE =
      let b = XB(ra) in
        let m = (b = X(rb)(63..56)) | (b = X(rb)(55..48)) |
                (b = X(rb)(47..40)) | (b = X(rb)(39..32)) |
                (b = X(rb)(31..24)) | (b = X(rb)(23..16)) |
                (b = X(rb)(15.. 8)) | (b = X(rb)( 7.. 0)) in
          CRF(crft) := (0 as Bit, m, 0 as Bits<2>)
    encoding AsId($asm) = {opcd = 0b011111, rsv1 = 0b00, extopcd = 0b00111'00000, rsv2 = 0b0}
    assembly AsId($asm) = ($asm, " ", udec(crft), ",", udec(ra), ",", udec(rb))
  }

  // instructions: mcrxrx
  model XFormMoveXERCRFInstr (asm : Str) : IsaDefs = {
    instruction AsId($asm) : XFormE =
      CRF(crft) := (XER_OV, XER_OV32, XER_CA, XER_CA32)
    encoding AsId($asm) = {opcd = 0b011111, rsv1 = 0b00, ra = 0b00000, rb = 0b00000, extopcd = 0b10010'00000, rsv2 = 0b0}
    assembly AsId($asm) = ($asm, " ", udec(crft))
  }

  // instructions: mtmsr
  model XFormMoveGPRMSRInstr (asm : Str) : IsaDefs = {
    instruction AsId($asm) : XFormF =
      if MSR.pr = 0
      then MSR := if l = 0
                  then (MSR(63..32), X(rs)(31..23), MSR(22), X(rs)(21..16),
                       X(rs)(15) | X(rs)(14), X(rs)(14..13), MSR(12), X(rs)(11..6),
                       (X(rs)(5) | X(rs)(14)) & ~(MSR(22) & MSR(60) & ~X(rs)(14)),
                       (X(rs)(4) | X(rs)(14)) & ~(MSR(22) & MSR(60) & ~X(rs)(14)),
                       X(rs)(3..1), MSR(0)) & 0x9400'0000'02C0'FF37
                  else (MSR(63..16), X(rs)(15), MSR(14..2), X(rs)(1), MSR(0))
      else raise Privilege
    encoding AsId($asm) = {opcd = 0b011111, rsv1 = 0b0000, rsv2 = 0b00000, extopcd = 0b00100'10010, rsv3 = 0b0}
    assembly AsId($asm) = ($asm, " ", udec(rs), ",", udec(l))
  }

  // instructions: tw
  model XFormTrapInstr (asm : Str) : IsaDefs = {
    instruction AsId($asm) : XFormG =
      let a = XW(ra) as SDWord in
        let b = XW(rb) as SDWord in
          if ((VADL::slth(a, b)) & to(4)) | ((VADL::sgth(a, b)) & to(3)) |
             ((a = b)            & to(2)) | ((VADL::ulth(a, b)) & to(1)) |
             ((VADL::ugth(a, b)) & to(0))
          then raise Trap
    encoding AsId($asm) = {opcd = 0b011111, extopcd = 0b00000'00100, rsv = 0b0}
    assembly AsId($asm) = ($asm, " ", udec(to), ",", udec(ra), ",", udec(rb))
  }

  // instructions: mfcr
  model XFXMoveCRGPRInstr (asm : Str) : IsaDefs = {
    instruction AsId($asm) : XFXFormA =
      X(rs) := (CRF(0), CRF(1), CRF(2), CRF(3),
                CRF(4), CRF(5), CRF(6), CRF(7)) as DWord
    encoding AsId($asm) = {opcd = 0b011111, m = 0b0, fxm = 0b0000'0000, rsv1 = 0b0, extopcd = 0b00000'10011, rsv2 = 0b0}
    assembly AsId($asm) = ($asm, " ", udec(rs))
  }

  // instructions: mtcrf
  model XFXMoveGPRCRFInstr (asm : Str) : IsaDefs = {
    instruction AsId($asm) : XFXFormA = {
      if fxm(7) then CRF(0) := X(rs)(31..28) as Nibble
      if fxm(6) then CRF(1) := X(rs)(27..24) as Nibble
      if fxm(5) then CRF(2) := X(rs)(23..20) as Nibble
      if fxm(4) then CRF(3) := X(rs)(19..16) as Nibble
      if fxm(3) then CRF(4) := X(rs)(15..12) as Nibble
      if fxm(2) then CRF(5) := X(rs)(11.. 8) as Nibble
      if fxm(1) then CRF(6) := X(rs)( 7.. 4) as Nibble
      if fxm(0) then CRF(7) := X(rs)( 3.. 0) as Nibble
    }
    encoding AsId($asm) = {opcd = 0b011111, m = 0b0, rsv1 = 0b0, extopcd = 0b00100'10000, rsv2 = 0b0}
    assembly AsId($asm) = ($asm, " ", udec(fxm), ",", udec(rs))
  }

  // instructions: mtocrf
  model XFXMoveGPROCRFInstr (asm : Str) : IsaDefs = {
    instruction AsId($asm) : XFXFormA =
      let crft = VADL::clz(fxm) in
        CRF(crft) := (XW(rs) >> (7 - crft) * 4) as Nibble
    encoding AsId($asm) = {opcd = 0b011111, m = 0b1, rsv1 = 0b0, extopcd = 0b00100'10000, rsv2 = 0b0}
    assembly AsId($asm) = ($asm, " ", udec(fxm), ",", udec(rs))
  }

  // instructions: mfocrf
  model XFXMoveOCRFGPRInstr (asm : Str) : IsaDefs = {
    instruction AsId($asm) : XFXFormA =
      let crfs = VADL::clz(fxm) in
        X(rs) := (CRF(crfs) as Word << (7 - crfs) * 4) as DWord
    encoding AsId($asm) = {opcd = 0b011111, m = 0b1, rsv1 = 0b0, extopcd = 0b00000'10011, rsv2 = 0b0}
    assembly AsId($asm) = ($asm, " ", udec(rs), ",", udec(fxm))
  }

  // instructions: mfspr, mtspr
  model XFXMoveSPRInstr (x : AsmExt, read : Bool) : IsaDefs = {
    instruction AsId($x.asm) : XFXFormB =
      match : Stat ( $read = true => $ReadSPR(); _ => $WriteSPR() )
    encoding AsId($x.asm) = {opcd = 0b011111, extopcd = $x.ext, rsv = 0b0}
    assembly AsId($x.asm) = ($x.asm, " ", match : Ex ( $read = true => udec(rs)
                                                     ; _            => udec((spr(4..0), spr(9..5)))
                                                     ), ",",
                                          match : Ex ( $read = true => udec((spr(4..0), spr(9..5)))
                                                     ; _            => udec(rs)
                                                     ))
  }

  // instructions: crand, crandc, creqv, crnand, crnor, cror, crorc, crxor
  model XLFormLogicalInstr (x : AsmOpExt, arg2 : Ex) : IsaDefs = {
    instruction AsId($x.asm) : XLFormA =
      $WriteCRB(crbt; $x.op($ReadCRB(crbs1), $arg2))
    encoding AsId($x.asm) = {opcd = 0b010011, extopcd = $x.ext, rsv = 0b0}
    assembly AsId($x.asm) = ($x.asm, " ", udec(crbt), ",", udec(crbs1), ",", udec(crbs2))
  }

  record XLFormBranchInstrRec (x : AsmExt, breg : Id, cntr : Bool)

  model XLFormBranchInstrExt (r : XLFormBranchInstrRec, lk : Bool) : IsaDefs = {
    instruction AsId($r.x.asm, $lStr($lk)) : XLFormB =
      let lrv = PC.next in
        let nctr = match : Ex
                   ( $r.cntr = true => CTR - ~bo(2) as UDWord
                   ; _              => CTR
                   ) in
          let mctr = nctr & (MSR.sf as SWord, maxU32) in {
            if (~($r.cntr as Bit) | bo(2) | ((mctr != 0) ^ bo(1))) & (bo(4) | ($ReadCRB(crbs) = bo(3)))
            then PC := $TargetAddrReg($r.breg)
            $CS($lk    ; LR  := lrv )
            $CS($r.cntr; CTR := nctr)
          }
    encoding AsId($r.x.asm, $lStr($lk)) =
      {opcd = 0b010011, rsv = 0b000, bh = 0b00, extopcd = $r.x.ext, lk = $lk}
    assembly AsId($r.x.asm, $lStr($lk)) =
      ($r.x.asm, $lStr($lk), " ", udec(bo), ",", udec(crbs), ",", udec(bh))
  }

  // instructions: bcctr[l], bclr[l], bctar[l]
  model XLFormBranchInstr (r : XLFormBranchInstrRec) : IsaDefs = {
    $XLFormBranchInstrExt($r; false)
    $XLFormBranchInstrExt($r; true )
  }

  // instructions: mcrf
  model XLFormMoveCRFCRFInstr (asm : Str) : IsaDefs = {
    instruction AsId($asm) : XLFormC =
      CRF(crft) := CRF(crfs)
    encoding AsId($asm) = {opcd = 0b010011, rsv1 = 0b00, rsv2 = 0b00'00000'00000'000000}
    assembly AsId($asm) = ($asm, " ", udec(crft), ",", udec(crfs))
  }

  // instructions: addg6s
  model XOFormAddGen6Instr (asm : Str) : IsaDefs = {
    instruction AsId($asm) : XOForm =
      let sum = X(ra) + X(rb) in
        let carry = (((X(ra) & X(rb)) | ((X(ra) ^ X(rb)) & ~sum)) >> 3) & 0x1111'1111'1111'1111 in
          X(rs) := ~(carry * 0xF) & 0x6666'6666'6666'6666
    encoding AsId($asm) = {opcd = 0b011111, oe = 0b0, extopcd = 0b0010'01010, rc = 0b0}
    assembly AsId($asm) = ($asm, " ", udec(rs), ",", udec(ra), ",", udec(rb))
  }

  record XOFormAddSubInstrRec (x : AsmOpExt, a : TwoArgs, enc : Encs, ca : Ex, ce : Bool, rbasm : Ex)

  model XOFormAddSubInstrExt (r : XOFormAddSubInstrRec, oe : Bool, rc : Bool) : IsaDefs = {
    instruction AsId($r.x.asm, $orId($oe; $rc)) : XOForm =
      let result32, flags32 = VADL::$r.x.op($r.a.arg1 as Word, $r.a.arg2 as Word, $r.ca) in
        let result, flags64 = VADL::$r.x.op($r.a.arg1        , $r.a.arg2        , $r.ca) in {
          X(rs) := result
          $SetFlags($oe; $r.ce; $rc; flags32.overflow;
            (flags64.overflow && MSR.sf) || (flags32.overflow && ~MSR.sf))
        }
    encoding AsId($r.x.asm, $orId($oe; $rc)) =
      {opcd = 0b011111, oe = $oe, extopcd = $r.x.ext, rc = $rc, $r.enc}
    assembly AsId($r.x.asm, $orId($oe; $rc)) =
      ($r.x.asm, $orStr($oe; $rc), " ", udec(rs), ",", udec(ra), $r.rbasm)
  }

  // instructions: add[o][.], addc[o][.], adde[o][.], subf[o][.], subfc[o][.], subfe[o][.], addme[o][.], addze[o][.], subfme[o][.], subfze[o][.]
  model XOFormAddSubInstr (r : XOFormAddSubInstrRec) : IsaDefs = {
    $XOFormAddSubInstrExt($r; false; false)
    $XOFormAddSubInstrExt($r; false; true )
    $XOFormAddSubInstrExt($r; true ; false)
    $XOFormAddSubInstrExt($r; true ; true )
  }

  record XOFormDivInstrRec (x : AsmOpExt, a : TwoArgs, type : Id, udf : Ex, ures : Ex, zres : Ex)

  model XOFormDivInstrExt (r : XOFormDivInstrRec, oe : Bool, rc : Bool) : IsaDefs = {
    instruction AsId($r.x.asm, $orId($oe; $rc)) : XOForm =
      if XW(rb) != 0
      then let res, flags = VADL::$r.x.op($r.a.arg1, $r.a.arg2) in
        let udf = $r.udf in
          let result = if udf then $r.ures else res as Word as $r.type in {
            X(rs) := result
            $SetFlags($oe; false; $rc; ov; udf | flags.overflow)
          }
      else let result = $r.zres as DWord in {
        X(rs) := result
        $SetFlags($oe; false; $rc; ov; true)
      }
    encoding AsId($r.x.asm, $orId($oe; $rc)) =
      {opcd = 0b011111, oe = $oe, extopcd = $r.x.ext, rc = $rc}
    assembly AsId($r.x.asm, $orId($oe; $rc)) =
      ($r.x.asm, $orStr($oe; $rc), " ", udec(rs), ",", udec(ra), ",", udec(rb))
  }

  // instructions: divw[o][.], divwu[o][.], divwe[o][.], divweu[o][.]
  model XOFormDivInstr (r : XOFormDivInstrRec) : IsaDefs = {
    $XOFormDivInstrExt($r; false; false)
    $XOFormDivInstrExt($r; false; true )
    $XOFormDivInstrExt($r; true ; false)
    $XOFormDivInstrExt($r; true ; true )
  }

  record XOFormMulInstrRec (x : AsmOpExt, res : Ex)

  model XOFormMulInstrExt (r : XOFormMulInstrRec, oe : Bool, rc : Bool) : IsaDefs = {
    instruction AsId($r.x.asm, $rId($rc)) : XOForm =
      let prod = VADL::$r.x.op(XW(ra), XW(rb)) in
        let result = $r.res as DWord in {
          X(rs) := result
          $SetFlags($oe; false; $rc; ov; prod != (prod as SWord) as SDWord)
        }
    encoding AsId($r.x.asm, $rId($rc)) =
      {opcd = 0b011111, oe = $oe, extopcd = $r.x.ext, rc = $rc}
    assembly AsId($r.x.asm, $rId($rc)) =
      ($r.x.asm, $rStr($rc), " ", udec(rs), ",", udec(ra), ",", udec(rb)) // oStr not necessary
  }

  // instructions: mullw[o][.], mulhw[.], mulhwu[.]
  model XOFormMulInstr (r : XOFormMulInstrRec, oe : Bool) : IsaDefs = {
    $XOFormMulInstrExt($r; $oe; false)
    $XOFormMulInstrExt($r; $oe; true )
  }

  model XOFormNegateInstrExt (asm : Str, oe : Bool, rc : Bool) : IsaDefs = {
    instruction AsId($asm, $orId($oe; $rc)) : XOForm =
      let ov32 = XW(ra) = minS32 in
        let ov64 = ((X(ra) = minS64) && MSR.sf) || (ov32 && ~MSR.sf) in
          let result = ~X(ra) + 1 in {
            X(rs) := result
            $SetFlags($oe; false; $rc; ov32; ov64)
          }
    encoding AsId($asm, $orId($oe; $rc)) =
      {opcd = 0b011111, rb = 0b00000, oe = $oe, extopcd = 0b0011'01000, rc = $rc}
    assembly AsId($asm, $orId($oe; $rc)) =
      ($asm, $orStr($oe; $rc), " ", udec(rs), ",", udec(ra))
  }

  // instructions: neg[o][.]
  model XOFormNegateInstr (asm : Str) : IsaDefs = {
    $XOFormNegateInstrExt($asm; false; false)
    $XOFormNegateInstrExt($asm; false; true )
    $XOFormNegateInstrExt($asm; true ; false)
    $XOFormNegateInstrExt($asm; true ; true )
  }

  // instructions: addex
  model Z23FormAddInstr (asm : Str) : IsaDefs = {
    instruction AsId($asm) : Z23Form =
      let result32, flags32 = VADL::addc(XW(ra), XW(rb), XER_OV) in
        let result, flags64 = VADL::addc(X(ra) , X(rb) , XER_OV) in {
          X(rs) := result
          XER_OV   := (flags64.carry && MSR.sf) || (flags32.carry && ~MSR.sf)
          XER_OV32 := flags32.carry
        }
    encoding AsId($asm) = {opcd = 0b011111, cy = 0b00, extopcd = 0b101'01010, rsv = 0b0}
    assembly AsId($asm) = ($asm, " ", udec(rs), ",", udec(ra), ",", udec(rb), ",", udec(cy))
  }

  //------------------------Arithmetic-------------------------
  $DXFormAddInstr("ADDPCIS")

  $XOFormAddSubInstr((("ADD"   ; addc; 0b1000'01010); (X(ra)  ; X(rb)  ); none         ; false ; false; (",", udec(rb))))
  $XOFormAddSubInstr((("ADDC"  ; addc; 0b0000'01010); (X(ra)  ; X(rb)  ); none         ; false ; true ; (",", udec(rb))))
  $XOFormAddSubInstr((("ADDE"  ; addc; 0b0100'01010); (X(ra)  ; X(rb)  ); none         ; XER_CA; true ; (",", udec(rb))))
  $XOFormAddSubInstr((("SUBF"  ; subc; 0b0001'01000); (X(rb)  ; X(ra)  ); none         ; true  ; false; (",", udec(rb))))
  $XOFormAddSubInstr((("SUBFC" ; subc; 0b0000'01000); (X(rb)  ; X(ra)  ); none         ; true  ; true ; (",", udec(rb))))
  $XOFormAddSubInstr((("SUBFE" ; subc; 0b0100'01000); (X(rb)  ; X(ra)  ); none         ; XER_CA; true ; (",", udec(rb))))
  $XOFormAddSubInstr((("ADDME" ; addc; 0b0111'01010); (X(ra)  ; maxU64 ); rb = 0b00000 ; XER_CA; true ; ""             ))
  $XOFormAddSubInstr((("ADDZE" ; addc; 0b0110'01010); (X(ra)  ; zeroU64); rb = 0b00000 ; XER_CA; true ; ""             ))
  $XOFormAddSubInstr((("SUBFME"; subc; 0b0111'01000); (maxU64 ; X(ra)  ); rb = 0b00000 ; XER_CA; true ; ""             ))
  $XOFormAddSubInstr((("SUBFZE"; subc; 0b0110'01000); (zeroU64; X(ra)  ); rb = 0b00000 ; XER_CA; true ; ""             ))

  $DFormAddSubInstr(("ADDI"  ; adds ; 0b001110; ADDI  ); (XZ(ra); immS  ); false; false)
  $DFormAddSubInstr(("ADDIC" ; adds ; 0b001100; ADDIC ); (X(ra) ; immS  ); false; true )
  $DFormAddSubInstr(("ADDIC" ; adds ; 0b001101; ADDIC_); (X(ra) ; immS  ); true ; true )
  $DFormAddSubInstr(("ADDIS" ; adds ; 0b001111; ADDIS ); (XZ(ra); shImmS); false; false)
  $DFormAddSubInstr(("SUBFIC"; subsc; 0b001000; SUBFIC); (immS  ; X(ra) ); false; true )

  $XOFormAddGen6Instr("ADDG6S")

  $Z23FormAddInstr("ADDEX")

  $DFormMulInstr("MULLI")

  $XOFormMulInstr((("MULLW" ; smull; 0b0111'01011); prod        ); false)
  $XOFormMulInstr((("MULLWO"; smull; 0b0111'01011); prod        ); true )
  $XOFormMulInstr((("MULHW" ; smull; 0b0010'01011); prod(63..32)); false)
  $XOFormMulInstr((("MULHWU"; umull; 0b0000'01011); prod(63..32)); false)

  $XOFormDivInstr((("DIVW"  ; sdivs; 0b1111'01011); (XW(ra)                ; XW(rb)          );  DWord;
                  XW(ra) = 0x8000'0000 & XW(rb) = maxU32                                      ;
                  XW(ra) as DWord; XW(ra)))
  $XOFormDivInstr((("DIVWU" ; udivs; 0b1110'01011); (XW(ra)                ; XW(rb)          );  DWord;
                  false                                                                       ;
                  XW(ra) as DWord; XW(ra)))
  $XOFormDivInstr((("DIVWE" ; sdivs; 0b1101'01011); (XW(ra) as SDWord << 32; XW(rb) as SDWord); SDWord;
                  (XW(ra) = 0x8000'0000 & XW(rb) = maxU32) | (res != (res as SWord) as SDWord);
                  0              ; 0     ))
  $XOFormDivInstr((("DIVWEU"; udivs; 0b1100'01011); (XW(ra) as  DWord << 32; XW(rb) as  DWord);  DWord;
                  res as DWord >= maxU32E                                                     ;
                  0              ; 0     ))

  $XOFormNegateInstr("NEG")

  $XFormModInstr(("MODSW"; smod; 0b11000'01011); SDWord)
  $XFormModInstr(("MODUW"; umod; 0b01000'01011); UDWord)

  //------------------------Logical----------------------------
  $XFormLogicalInstr((("AND" ; VADL::and; 0b00000'11100);  X(rb)))
  $XFormLogicalInstr((("ANDC"; VADL::and; 0b00001'11100); ~X(rb)))
  $XFormLogicalInstr((("EQV" ; nxor64   ; 0b01000'11100);  X(rb)))
  $XFormLogicalInstr((("NAND"; nand64   ; 0b01110'11100);  X(rb)))
  $XFormLogicalInstr((("NOR" ; nor64    ; 0b00011'11100);  X(rb)))
  $XFormLogicalInstr((("OR"  ; VADL::or ; 0b01101'11100);  X(rb)))
  $XFormLogicalInstr((("ORC" ; VADL::or ; 0b01100'11100); ~X(rb)))
  $XFormLogicalInstr((("XOR" ; VADL::xor; 0b01001'11100);  X(rb)))

  $XLFormLogicalInstr(("CRAND" ; VADL::and; 0b01000'00001);  $ReadCRB(crbs2))
  $XLFormLogicalInstr(("CRANDC"; VADL::and; 0b00100'00001); ~$ReadCRB(crbs2))
  $XLFormLogicalInstr(("CREQV" ; nxor1    ; 0b01001'00001);  $ReadCRB(crbs2))
  $XLFormLogicalInstr(("CRNAND"; nand1    ; 0b00111'00001);  $ReadCRB(crbs2))
  $XLFormLogicalInstr(("CRNOR" ; nor1     ; 0b00001'00001);  $ReadCRB(crbs2))
  $XLFormLogicalInstr(("CROR"  ; VADL::or ; 0b01110'00001);  $ReadCRB(crbs2))
  $XLFormLogicalInstr(("CRORC" ; VADL::or ; 0b01101'00001); ~$ReadCRB(crbs2))
  $XLFormLogicalInstr(("CRXOR" ; VADL::xor; 0b00110'00001);  $ReadCRB(crbs2))

  $DFormLogicalInstr(("ANDI" ; and; 0b011100); immU  ; true )
  $DFormLogicalInstr(("ANDIS"; and; 0b011101); shImmU; true )
  $DFormLogicalInstr(("ORI"  ; or ; 0b011000); immU  ; false)
  $DFormLogicalInstr(("ORIS" ; or ; 0b011001); shImmU; false)
  $DFormLogicalInstr(("XORI" ; xor; 0b011010); immU  ; false)
  $DFormLogicalInstr(("XORIS"; xor; 0b011011); shImmU; false)

  $XFormBoolInstr("SETB")

  $XFormBoolCondInstr(("SETBC"  ; 0b01100'00000);  s as UDWord)
  $XFormBoolCondInstr(("SETBCR" ; 0b01101'00000); ~s as UDWord)
  $XFormBoolCondInstr(("SETNBC" ; 0b01110'00000);  s as SDWord)
  $XFormBoolCondInstr(("SETNBCR"; 0b01111'00000); ~s as SDWord)

  //------------------------Rotate/Shift-----------------------
  $MFormRotateInstr((("RLWIMI"; 0b010100); sh         ; (r & m) | (X(ra) & ~m)))
  $MFormRotateInstr((("RLWINM"; 0b010101); sh         ; r & m                 ))
  $MFormRotateInstr((("RLWNM" ; 0b010111); X(sh)(4..0); r & m                 ))

  $XFormLogicalShiftInstr(("SLW"; lsl; 0b00000'11000))
  $XFormLogicalShiftInstr(("SRW"; lsr; 0b10000'11000))

  $XFormArithmeticShiftInstr((("SRAW" ; 0b11000'11000); X(rb)(5..0);
                             if X(rb)(5) = 0 then r(63..32) as SDWord else X(rs)(31) as SDWord))
  $XFormArithmeticShiftInstr((("SRAWI"; 0b11001'11000); rb         ;
                             r(63..32) as SDWord                                              ))

  //------------------------Compare----------------------------
  $XFormCmpInstr((("CMP" ; 0b00000'00000); false))
  $XFormCmpInstr((("CMPL"; 0b00001'00000); true ))

  $DFormCmpInstr((("CMPI" ; 0b001011); false))
  $DFormCmpInstr((("CMPLI"; 0b001010); true ))

  $XFormCmpBytesInstr("CMPB")

  $XFormCmpEqBytesInstr("CMPEQB")

  $XFormCmpRangedBytesInstr("CMPRB")

  //------------------------Load-------------------------------
  $DFormLoadInstr(("LBZ" ; 0b100010); Unit::Byte; false; UDWord)
  $DFormLoadInstr(("LBZU"; 0b100011); Unit::Byte; true ; UDWord)
  $DFormLoadInstr(("LHA" ; 0b101010); Unit::Half; false; SDWord)
  $DFormLoadInstr(("LHAU"; 0b101011); Unit::Half; true ; SDWord)
  $DFormLoadInstr(("LHZ" ; 0b101000); Unit::Half; false; UDWord)
  $DFormLoadInstr(("LHZU"; 0b101001); Unit::Half; true ; UDWord)
  $DFormLoadInstr(("LWZ" ; 0b100000); Unit::Word; false; UDWord)
  $DFormLoadInstr(("LWZU"; 0b100001); Unit::Word; true ; UDWord)

  $XFormLoadInstr(("LBZX" ; 0b00010'10111); Unit::Byte; UDWord; false; false)
  $XFormLoadInstr(("LBZUX"; 0b00011'10111); Unit::Byte; UDWord; true ; false)
  $XFormLoadInstr(("LHAX" ; 0b01010'10111); Unit::Half; SDWord; false; false)
  $XFormLoadInstr(("LHAUX"; 0b01011'10111); Unit::Half; SDWord; true ; false)
  $XFormLoadInstr(("LHZX" ; 0b01000'10111); Unit::Half; UDWord; false; false)
  $XFormLoadInstr(("LHZUX"; 0b01001'10111); Unit::Half; UDWord; true ; false)
  $XFormLoadInstr(("LWZX" ; 0b00000'10111); Unit::Word; UDWord; false; false)
  $XFormLoadInstr(("LWZUX"; 0b00001'10111); Unit::Word; UDWord; true ; false)
  $XFormLoadInstr(("LWBRX"; 0b10000'10110); Unit::Word; UDWord; false; true )

  //------------------------Store------------------------------
  $DFormStoreInstr(("STB" ; 0b100110); Unit::Byte; false)
  $DFormStoreInstr(("STBU"; 0b100111); Unit::Byte; true )
  $DFormStoreInstr(("STH" ; 0b101100); Unit::Half; false)
  $DFormStoreInstr(("STHU"; 0b101101); Unit::Half; true )
  $DFormStoreInstr(("STW" ; 0b100100); Unit::Word; false)
  $DFormStoreInstr(("STWU"; 0b100101); Unit::Word; true )

  $XFormStoreInstr(("STBX"  ; 0b00110'10111); Unit::Byte; false; false)
  $XFormStoreInstr(("STBUX" ; 0b00111'10111); Unit::Byte; true ; false)
  $XFormStoreInstr(("STHX"  ; 0b01100'10111); Unit::Half; false; false)
  $XFormStoreInstr(("STHUX" ; 0b01101'10111); Unit::Half; true ; false)
  $XFormStoreInstr(("STHBRX"; 0b11100'10110); Unit::Half; false; true )
  $XFormStoreInstr(("STWX"  ; 0b00100'10111); Unit::Word; false; false)
  $XFormStoreInstr(("STWUX" ; 0b00101'10111); Unit::Word; true ; false)
  $XFormStoreInstr(("STWBRX"; 0b10100'10110); Unit::Word; false; true )

  //------------------------Branch-----------------------------
  $IFormBranchInstr("B")

  $BFormBranchInstr("BC")

  $XLFormBranchInstr((("BCCTR"; 0b10000'10000); nctr; false))
  $XLFormBranchInstr((("BCLR" ; 0b00000'10000); LR  ; true ))
  $XLFormBranchInstr((("BCTAR"; 0b10001'10000); TAR ; true ))

  //------------------------Move-------------------------------
  $XFormMSRGPRInstr("MFMSR")

  $XFormMoveGPRMSRInstr("MTMSR")

  $XFXMoveGPROCRFInstr("MTOCRF")

  $XFXMoveOCRFGPRInstr("MFOCRF")

  $XFXMoveCRGPRInstr("MFCR")

  $XFXMoveGPRCRFInstr("MTCRF")

  $XLFormMoveCRFCRFInstr("MCRF")

  $XFormMoveXERCRFInstr("MCRXRX")

  $XFXMoveSPRInstr(("MFSPR"; 0b01010'10011); true )
  $XFXMoveSPRInstr(("MTSPR"; 0b01110'10011); false)
  $XFXMoveSPRInstr(("MFTB" ; 0b01011'10011); true ) // [phased-out]

  //------------------------Other------------------------------
  $XFormReverseInstr(("BRH"; 0b00110'11011); Unit::Half)
  $XFormReverseInstr(("BRW"; 0b00100'11011); Unit::Word)

  $XFormBinCodedDecInstr(("CBCDTD"; 0b01001'11010); false)
  $XFormBinCodedDecInstr(("CDTBCD"; 0b01000'11010); true )

  $XFormPopCountInstr(("POPCNTB"; 0b00011'11010); Unit::Byte)
  $XFormPopCountInstr(("POPCNTW"; 0b01011'11010); Unit::Word)

  $XFormParityInstr("PRTYW")

  $XFormTrapInstr("TW")

  $DFormTrapInstr("TWI")

  $XFormExCRInstr((("EXTSB" ; 0b11101'11010); XB(rs) as SDWord                                     ))
  $XFormExCRInstr((("EXTSH" ; 0b11100'11010); XH(rs) as SDWord                                     ))
  $XFormExCRInstr((("CNTLZW"; 0b00000'11010); if XW(rs) = 0 then 32 else VADL::clz(XW(rs)) as DWord))
  $XFormExCRInstr((("CNTTZW"; 0b10000'11010); if XW(rs) = 0 then 32 else VADL::ctz(XW(rs)) as DWord))

  $SCFormSysCallInstr(("SC" ; 0b10); SysCall(lev)   )
  $SCFormSysCallInstr(("SCV"; 0b01); SysCallVectored)
}

processor Power implements PPC64SFS = {
  reset = {
    PC   := 0x0000'0000'0000'0100
    X(3) := 0x0000'0000'1FE0'0000
    MSR  := 0x0000'0000'0000'3000
  }

  [ firmware ]
  [ base: 0x00000000 ]
  memory region [RAM] DRAM in MEM
}
