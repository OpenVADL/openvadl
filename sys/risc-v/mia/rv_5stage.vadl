// RISC-V five stage pipeline

import "../rv32i"::RV32I
import "../rv32im"::RV32IM

import "../rv64i"::RV64I
import "../rv64im"::RV64IM

model Isa() : Id = {RV32I}               // invoke vadl -m "Isa=RV64I" for 64 bit arch

micro architecture FiveStage implements $Isa = {

  stage FETCH -> FetchResult = {
    FETCH := fetchNext                      // fetch next instruction from memory (or cache)
  }

  stage DECODE -> Instruction = {
    let instr = decode( FETCH ) in { // decode the fetch packet, gives an Instruction
//       if ( instr.unknown ) then
//         raise invalidInstruction         // raise an invalid instruction exception
      instr.address( @X )                // compute addresses to access register file X
      instr.read( @X )                   // read from the X register file
      instr.read( @PC )                  // read from the PC
      DECODE := instr                        // stage output is the Instruction ir
    }
  }

  stage EXECUTE -> Instruction = {
    let instr = DECODE in {
      instr.compute                      // evaluate all expressions
      instr.verify                       // check and flush pipeline if branch misprediction
      instr.write( @PC )                 // write PC
      EXECUTE := instr
    }
  }

  stage MEMORY -> Instruction = {
    let instr = EXECUTE in {
      instr.write( @MEM )                // write to memory
      instr.read( @MEM )                 // receive data from memory read
      MEMORY := instr
    }
  }

  stage WRITE_BACK = {
    let instr = MEMORY in
      instr.write( @X )                  // write back to register file X
    }
}
