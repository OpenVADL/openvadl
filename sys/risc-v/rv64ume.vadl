// This is meant to be the temporary root specification during implementation
// of the UME for RISC-V
import rv64csr::{ RV64IMZicsr, RV3264I, RV3264M } with ("ArchSize=Arch64")


instruction set architecture RV64UME extending RV64IMZicsr = {}

application binary interface ABI for RV64UME = {
   alias register s0 = X(8)
   alias register s1 = X(9)

   alias register a0 = X(10)
   alias register a1 = X(11)
   alias register a2 = X(12)
   alias register a3 = X(13)
   alias register a4 = X(14)
   alias register a5 = X(15)
   alias register a6 = X(16)
   alias register a7 = X(17)

}

// This is the system-mode entry point.
// Once we have a user-mode definition, this should be removed.
[ htif ]
processor Spike implements RV64UME = {
 constant reset_vec_addr = 0x1000

 reset = {
   PC := reset_vec_addr
 }

 [ firmware ]
 [ base: 0x80000000 ]
 memory region [RAM] DRAM in MEM

 memory region [ROM] MROM in MEM = {
     MEM<4>(0x1000) := 0x00000297  // auipc t0, 0x0
     MEM<4>(0x1004) := 0x02828613  // addi a2, t0, 40
     // this processor has no zicsr extension
     MEM<4>(0x1008) := 0x00000013  // addi x0, x0, 0
     MEM<4>(0x100c) := 0x0202b583  // ld   a1, 32(t0)
     MEM<4>(0x1010) := 0x0182b283  // ld   t0, 24(t0)
     MEM<4>(0x1014) := 0x00028067  // jr   t0
     // store start_addr in memory (0x80000000)
     MEM<4>(0x1018) := 0x80000000  // lo32(start_addr)
     MEM<4>(0x101c) := 0x00000000  // hi32(start_addr)
     // we do not yet support a fdt, but we set the address,
     // to keep the registers consistent with upstream
     MEM<4>(0x1020) := 0x87e00000  // lo32(fdt_addr)
     MEM<4>(0x1024) := 0x00000000  // hi32(fdt_addr)
 }

 // user mode emulation
 // how to intercept syscalls & fwd them to host os

 // choose os here (linux, bsd, ...)
 [target os : linux] // annotation to user mode emulation
 user mode emulation USER_MODE for ISA = { //TODO: readd "with ABI"?
 //TODO: make new SyscallDef like AliasDefinition? or make new case within alias

     syscall instruction = ecall // instr to trigger syscall, ignores full system behavior
     syscall register = syscall_id // register to hold syscallID
     syscall field = imm16 // format field of instr to hold syscall ID

     syscall argument = [arg0, arg1, arg2, arg3, arg4, arg5] // registers to pass data to host os

     //negative return commonly used in riscv
     [error convention : negative_return] // annotation to syscall return
     syscall return = [retval] // store result here

     unhandled syscall = trap
 }
}