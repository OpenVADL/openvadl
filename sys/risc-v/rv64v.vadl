import rv64csr::{RV64IMZicsr}

// This RISC-V vector extension is kept simple.
// We do not allow VMUL specification of the VTYPE, so there are 32 vector registered fixed.
//
// Glossary:
// ELEN: ElementLEN .. Number of bits of a single vector element, >= 8, power of 2
// VLEN: VectorLEN .. Number of bits of a vector register, >= ELEN, power of 2, <= 2^16
// VLMAX = LMUL * VLEN / SEW ..

// Our spec:
// VLEN is 1024 (same as in QEMU)
// ELEN is 32 bits (so most inner dimensions is Bits<32>)
// No LMUL
// Default VLMAX is therefore VLEN/ELEN ... 32
instruction set architecture RV64IMV extending RV64IMZicsr = {

  constant ECOUNT = 32
  constant ESIZE = 32

  using BElem = Bits<ESIZE>
  using SElem = SInt<ESIZE>

  register V: Bits<32><ECOUNT><ESIZE>

  format VSetVLI: Inst =
  { funct1:  Bits<1>
  , vtypei:   Bits<11>
  , rs1:    Index
  , funct3:  Bits<3>
  , rd:     Index
  , opcode: Bits<7>
  }

  format VMem: Inst =
  { nf:      Bits<3>
  , mew:     Bits<1>
  , mop:     Bits<2>
  , vm:      Bits<1>
  , lumop:   Bits<5>
  , rs1:     Bits<5>
  , width:   Bits<3>
  , operand: Bits<5>
  , opcode:  Bits<7>
  // alias names of the operand field
  , vd  = operand
  , vs3 = operand
  }

  format OPV: Inst =
  { funct6: Bits<6>
  , vm:     Bits<1>
  , vs2:    Bits<5>
  , src1:   Bits<5>
  , funct3: Bits<3>
  , dest:   Bits<5>
  , opcode: Bits<7>
  // alias names of src1 field
  , vs1 = src1
  , rs1 = src1
  , imm = src1
  , vd = dest
  , rd = dest
  }

  // helper functions *****************************************************

  constant AllOnes = (-(1 as SElem)) as BElem
  constant MinSElem = (1 as BElem << (ECOUNT - 1)) as SElem

  function smulh(a: BElem, b: BElem) -> BElem = VADL::smull(a, b)(63..32)
  function umulh(a: BElem, b: BElem) -> BElem = VADL::umull(a, b)(63..32)
  function sumulh(a: BElem, b: BElem) -> BElem = VADL::sumull(a, b)(63..32)

  function sdiv(a: BElem, b: BElem) -> BElem =
    let dividend = a as SInt in
    let divisor  = b as SInt in
    if divisor = 0 then AllOnes
    else if dividend = MinSElem & divisor = AllOnes then MinSElem
    else dividend / divisor

  function udiv(a: BElem, b: BElem) -> BElem =
    let dividend = a as UInt in
    let divisor  = b as UInt in
    if divisor = 0 then AllOnes
    else dividend / divisor

  function srem(a: BElem, b: BElem) -> BElem =
    let dividend = a as SInt in
    let divisor  = b as SInt in
    if divisor = 0 then dividend
    else if dividend = MinSElem & divisor = AllOnes then 0
    else dividend % divisor

  function urem(a: BElem, b: BElem) -> BElem =
    let dividend = a as UInt in
    let divisor  = b as UInt in
    if divisor = 0 then dividend
    else dividend % divisor

  function smin(a: BElem, b: BElem) -> BElem = if a as SInt < b as SInt then a else b
  function umin(a: BElem, b: BElem) -> BElem = if a as UInt < b as UInt then a else b
  function smax(a: BElem, b: BElem) -> BElem = if a as SInt > b as SInt then a else b
  function umax(a: BElem, b: BElem) -> BElem = if a as UInt > b as UInt then a else b

  // variant models *******************************************************

  // A macro type that takes XVI variants of an instruction and emits 1 to 3 of them.
  model-type VXIType = (IsaDefs, IsaDefs, IsaDefs) -> IsaDefs
  // The VXI variant model that emits all 3 variants
  model VXI(v: IsaDefs, x: IsaDefs, i: IsaDefs): IsaDefs = {
    $v
    $x
    $i
  }
  // The VXI variant model that only emits the V and X variants
  model VX(v: IsaDefs, x: IsaDefs, i: IsaDefs): IsaDefs = {
    $v
    $x
  }

  // instruction models ************************************************

  model OPVInstr (name: Id, suffix: Str, expr: Ex, src1Asm : Ex, funct6: Bin, funct3 : Bin): IsaDefs = {
    instruction AsId($name, "_", $suffix) : OPV = {
      forall i: Bits<5> in 0..(ECOUNT - 1) do {
        V(vd)(i) := $expr
      }
    }
    encoding AsId($name, "_", $suffix) = { funct6 = $funct6, funct3 = $funct3, opcode = 0b101'0111 }
    assembly AsId($name, "_", $suffix) = ( AsStr($name), ".", $suffix, register(vd), ", ", register(vs2), ", ", $src1Asm )
  }

  model OPIV (name : Id, vxi: VXIType, binFun : SymEx, funct6 : Bin): IsaDefs = {
    $vxi(
      $OPVInstr ($name; "VV"; $binFun(V(vs2)(i), V(vs1)(i));          register(vs1);  $funct6; 0b000);
      $OPVInstr ($name; "VX"; $binFun(V(vs2)(i), X(rs1) as BElem);    register(rs1);  $funct6; 0b100);
      $OPVInstr ($name; "VI"; $binFun(V(vs2)(i), imm as SInt<ESIZE>); decimal(imm);   $funct6; 0b011)
    )
  }

  model OPMV (name : Id, vxi: VXIType, binFun : SymEx, funct6 : Bin): IsaDefs = {
    $vxi(
      $OPVInstr ($name; "VV"; $binFun(V(vs2)(i), V(vs1)(i));        register(vs1);  $funct6; 0b010);
      $OPVInstr ($name; "VX"; $binFun(V(vs2)(i), X(rs1) as BElem);  register(rs1);  $funct6; 0b110);
    )
  }

  model OPMVAddSub (name : Id, vxi: VXIType, op : BinOp, mulReg : Id, acc : Id, funct6 : Bin): IsaDefs = {
    $vxi(
      $OPVInstr ($name; "VV"; V($acc)(i) $op (V(vs1)(i)       * V($mulReg)(i)); register(vs1);  $funct6; 0b010);
      $OPVInstr ($name; "VX"; V($acc)(i) $op (X(rs1) as BElem * V($mulReg)(i)); register(rs1);  $funct6; 0b110);
    )
  }

  // configuration instructions ****************************************************

  // Currently we have a fixed vector size and vector elements, so we just set the destination to 32.
  // The instruction is only required for cosimulation with QEMU's upstream RISC-V implementation.
  instruction VSETVLI : VSetVLI = X(rd) := 32
  encoding VSETVLI = { funct1 = 0, funct3 = 0b111, opcode = 0b101'0111 }
  assembly VSETVLI = ( mnemonic, " ", register(rd), ",", register(rs1), ", e32" )

  // vector load-store instructions ************************************************

  // Vector Load Unit-Strided
  instruction VLE32V : VMem = let addr = X(rs1) in
    V(vd) := MEM<128>(addr) as Bits<32><32> // load 128 bytes ... 1024 bits into the vector register
  encoding VLE32V = { mew = 0, mop = 0b00, lumop = 0b0000, width = 0b110, opcode = 0b000'0111 }
  assembly VLE32V = ( "vle32.v ", register(vd), ", (", register(rs1), ")" )

  // Vector Store Unit-Strided
  instruction VSE32V : VMem = let addr = X(rs1) in
    MEM<128>(addr) := V(vs3) as Bits<1024>  // store 128 bytes ... 1024 bits from the vector register to memory
  encoding VSE32V = { mew = 0, mop = 0b00, lumop = 0b0000, width = 0b110, opcode = 0b010'0111 }
  assembly VSE32V = ( "vse32.v ", register(vs3), ", (", register(rs1), ")" )

  // arithmetic instructions *******************************************************

  $OPIV( VADD  ; VXI ; VADL::add ; 0b00'0000 )
  $OPIV( VSUB  ; VX  ; VADL::sub ; 0b00'0010 )

  $OPMV( VMULHU  ; VX ; umulh     ; 0b10'0100 )
  $OPMV( VMUL    ; VX ; VADL::mul ; 0b10'0101 )
  $OPMV( VMULHSU ; VX ; sumulh    ; 0b10'0110 )
  $OPMV( VMULH   ; VX ; smulh     ; 0b10'0111 )

  $OPMV( VDIVU ; VX ; udiv ; 0b10'0000 )
  $OPMV( VDIV  ; VX ; sdiv ; 0b10'0001 )
  $OPMV( VREMU ; VX ; urem ; 0b10'0010 )
  $OPMV( VREM  ; VX ; srem ; 0b10'0011 )

  // min/max instructions **********************************************************

  $OPIV( VMINU ; VX ; umin ; 0b00'0100 )
  $OPIV( VMIN  ; VX ; smin ; 0b00'0101 )
  $OPIV( VMAXU ; VX ; umax ; 0b00'0110 )
  $OPIV( VMAX  ; VX ; smax ; 0b00'0111 )

  // logical instructions **********************************************************

  $OPIV( VAND ; VXI ; VADL::and ; 0b00'1001 )
  $OPIV( VOR  ; VXI ; VADL::or  ; 0b00'1010 )
  $OPIV( VXOR ; VXI ; VADL::xor ; 0b00'1011 )

  // multiply-add/sub **************************************************************

  $OPMVAddSub( VMADD  ; VX ; + ; vd ; vs2 ; 0b10'1001 )
  $OPMVAddSub( VNMSUB ; VX ; - ; vd ; vs2 ; 0b10'1011 )
  $OPMVAddSub( VMACC  ; VX ; + ; vs2 ; vd ; 0b10'1101 )
  $OPMVAddSub( VNMSAC ; VX ; - ; vs2 ; vd ; 0b10'1111 )

}

[ htif ]
processor Spike implements RV64IMV = {
    constant reset_vec_addr = 0x1000

    reset = {
      PC := reset_vec_addr
    }

    [ firmware ]
    [ base: 0x80000000 ]
    memory region [RAM] DRAM in MEM

    memory region [ROM] MROM in MEM = {
      MEM<4>(0x1000) := 0x00000297  // auipc t0, 0x0
      MEM<4>(0x1004) := 0x02828613  // addi a2, t0, 40
      // this processor has no zicsr extension
      MEM<4>(0x1008) := 0x00000013  // addi x0, x0, 0
      MEM<4>(0x100c) := 0x0202b583  // ld   a1, 32(t0)
      MEM<4>(0x1010) := 0x0182b283  // ld   t0, 24(t0)
      MEM<4>(0x1014) := 0x00028067  // jr   t0
      // store start_addr in memory (0x80000000)
      MEM<4>(0x1018) := 0x80000000  // lo32(start_addr)
      MEM<4>(0x101c) := 0x00000000  // hi32(start_addr)
      // we do not yet support a fdt, but we set the address,
      // to keep the registers consistent with upstream
      MEM<4>(0x1020) := 0x87e00000  // lo32(fdt_addr)
      MEM<4>(0x1024) := 0x00000000  // hi32(fdt_addr)
    }
}

