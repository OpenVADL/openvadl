instruction set architecture ISA = {
  register X : Bits<16><32>
}

micro architecture SingleStage implements ISA = {
    stage FETCH -> ( ir : Instruction, ir2: Instruction ) = {
      let instr = decode ( fetchNext ) in
      {
        instr.write(@X)
        ir := instr
        ir2 := instr
      }
    }
}
