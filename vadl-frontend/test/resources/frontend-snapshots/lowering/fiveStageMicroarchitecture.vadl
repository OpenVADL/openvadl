// INCLUDE-VIAM-DUMP

instruction set architecture ISA = {
  register X : Bits<16><32>
  memory MEM : Bits<32> -> Bits<8>
  program counter PC: Bits<32>
  register CSR : Bits<5> -> Bits<32>
}

micro architecture SingleStage implements ISA = {
  logic [forwarding] bypass

  stage FETCH -> FetchResult =
  {
    FETCH := fetchNext
  }

  stage DECODE -> Instruction =
  {
    let instr = decode( FETCH ) in
    {
      instr.address( @X )
      instr.readOrForward( @X, @bypass )
      DECODE := instr
    }
  }

  stage EXECUTE -> Instruction =
  {
    let instr = DECODE in
    {
      instr.read( @PC, @CSR )
      instr.compute
      instr.verify
      instr.write( @PC, @CSR )
      instr.results( @X, @bypass )
      EXECUTE := instr
    }
  }

  stage MEMORY -> Instruction =
  {
    let instr = EXECUTE in
    {
      instr.write( @MEM )
      instr.read( @MEM )
      MEMORY := instr
    }
  }

  stage WRITE_BACK =
  {
    let instr = MEMORY in
    {
      instr.write( @X )
    }
  }
}


