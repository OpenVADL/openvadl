// INCLUDE-VIAM-DUMP

instruction set architecture ISA = {
  register X : Bits<16><32>
  memory Mem : Bits<32> -> Bits<8>
}

micro architecture SingleStage implements ISA = {
  logic [forwarding] bypass

   stage IF -> FetchResult =
   {
     IF := fetchNext
   }

  stage ID -> Instruction =
  {
    let instr = decode(consume(IF)) in
    {
      instr.readOrForward( @X, @bypass )
      instr.read( @X )
      ID := instr
    }
  }

  stage EX -> Instruction =
  {
    let instr = consume(ID) in
    {
      instr.results( @X, @bypass )
      instr.read( @Mem )
      instr.write ( @X )
      EX := instr
    }
  }
}


