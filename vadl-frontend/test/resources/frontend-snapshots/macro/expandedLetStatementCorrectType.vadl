// INCLUDE-AST-DUMP
//
// Previously there was a bug where the identifier of the let statement was not copied when expanded from a model
// invocation. This meant that the type of the identifier was assigned in the first invocation of the model and in the
// second the same identifier was linked which meant it already had a type (potentially a different one) and it
// wouldn't be checked again.
//

instruction set architecture RV3264I = {
  register    X : Bits<5>   -> Bits<32>

  format Rtype : Bits<32> =
    { op: Bits<32>
    }

  model AddIntr(name: Id, typeName: Id, opcode: Ex): IsaDefs = {
  instruction $name : Rtype =
       let x = 8 as $typeName in
        X(1) := x as Bits<32>

  encoding $name = {op = $opcode}
  assembly $name = AsStr($name)
  }

  using Bits32 = Bits<32>
  using Bits64 = Bits<64>
  $AddIntr(add1; Bits32; 1)
  $AddIntr(add2; Bits64; 2)
}


