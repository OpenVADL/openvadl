// INCLUDE-PRETTY-PRINT
model FloatType(id : Id): Defs = { [ IEEE : 32 ] float-type $id }
$FloatType(IEEE32)

model FloatTypeId(): Id = { IEEE64 }
[ IEEE : 64 ]
float-type $FloatTypeId()


