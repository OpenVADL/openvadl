// Previously this used to crash because the macro expander left a placeholder
// https://github.com/OpenVADL/openvadl/issues/1153#issuecomment-6069121176

record R (id : Id)

model M0 (x : R) : Ex = {
  0 as $x.id
}

model M1 (y : R) : Ex = {
  $M0($y)
}

constant C = $M1 ((T))


