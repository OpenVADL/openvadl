//      , ISS2 : Bits24
//      , EC : Bits6
//      , IL : Bits1
//      , ISS : Bits25
//      }
//
//    format SavedProgramStateFormat: BitsX =
//      { Res0	 [63..37]
//      , UINJ	 [36]
//      , PACM	 [35]
//      , EXLOCK	 [34]
//      , PPEND	 [33]
//      , PM	 [32]
//      , NZCV	 [31..28]
//      , Res1	 [27..26]
//      , TCO	 [25]
//      , DIT	 [24]
//      , UAO	 [23]
//      , PAN	 [22]
//      , SS	 [21]
//      , IL	 [20]
//      , Res2	 [19..14]
//      , ALLINT	 [13]
//      , SSBS	 [12]
//      , BTYPE	 [11..10]
//      , D	 [9]
//      , A	 [8]
//      , I	 [7]
//      , F	 [6]
//      , Res3	 [5]
//      , M4	 [4]
//      , M	 [3..0]
//      }
//
//    format CPACRFormat: BitsX =
//      { Res0	 [63..29, 27..22, 19..18, 15..0]
//      , tta	 [28]
//      , fpen	 [21..20]
//      , zen	 [17..16]
//      }
//
//    enumeration SysRegEncode : Bits16 =
//      { NZCV = 0b11'011'0100'0010'000
//      , CurrentEL = 0b11'000'0100'0010'010
//      , SPSel = 0b11'000'0100'0010'000
//      , SP_EL0 = 0b11'000'0100'0001'000
//      , SP_EL1 = 0b11'100'0100'0001'000
//      , ELR_EL1 = 0b11'000'0100'0000'001
//      , VBAR_EL1 = 0b11'000'1100'0000'000
//      , ESR_EL1 = 0b11'000'0101'0010'000
//      , SPSR_EL1 = 0b11'000'0100'0000'000
//      , CPACR_EL1 = 0b11'000'0001'0000'010
//      , ZCR_EL1 = 0b11'000'0001'0010'000
//      }
//
//    constant SysRegNZCV15 = SysRegEncode::NZCV as Bits15
//
//    register CurrentEL: Bits2
//    register SPSel: Bits1
//    register SP_EL0: Address
//    register SP_EL1: Address
//    register ELR_EL1: Address
