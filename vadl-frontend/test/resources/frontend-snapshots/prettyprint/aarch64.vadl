//
//    assembly ASRVW = ("asr", " ", WSize(rd), ", ", WSize(rn), ", ", WSize(rm))
//
//    pseudo instruction ASRVX(rd : Index, rn : Index, rm : Index) = {
//      ASRX{rd = rd, rn = rn, rm = rm}
//    }
//
//    assembly ASRVX = ("asr", " ", XSize(rd), ", ", XSize(rn), ", ", XSize(rm))
//
//    pseudo instruction LSRVW(rd : Index, rn : Index, rm : Index) = {
//      LSRW{rd = rd, rn = rn, rm = rm}
//    }
//
//    assembly LSRVW = ("lsr", " ", WSize(rd), ", ", WSize(rn), ", ", WSize(rm))
//
//    pseudo instruction LSRVX(rd : Index, rn : Index, rm : Index) = {
//      LSRX{rd = rd, rn = rn, rm = rm}
//    }
//
//    assembly LSRVX = ("lsr", " ", XSize(rd), ", ", XSize(rn), ", ", XSize(rm))
//
//    pseudo instruction LSLVW(rd : Index, rn : Index, rm : Index) = {
//      LSLW{rd = rd, rn = rn, rm = rm}
//    }
//
//    assembly LSLVW = ("lsl", " ", WSize(rd), ", ", WSize(rn), ", ", WSize(rm))
//
//    pseudo instruction LSLVX(rd : Index, rn : Index, rm : Index) = {
//      LSLX{rd = rd, rn = rn, rm = rm}
//    }
//
//    assembly LSLVX = ("lsl", " ", XSize(rd), ", ", XSize(rn), ", ", XSize(rm))
//
//    pseudo instruction ASRIW(rd : Index, rn : Index, shift : Bits6) = {
//      SBFMW{rd = rd, rn = rn, immr = shift as Bits<ShiftSize::WSize> as Bits6, imms = Size::WSize - 1}
//    }
//
//    assembly ASRIW = ("asr", " ", WSize(rd), ", ", WSize(rn), ", #", udec(shift))
//
//    pseudo instruction ASRIX(rd : Index, rn : Index, shift : Bits6) = {
//      SBFMX{rd = rd, rn = rn, immr = shift as Bits<ShiftSize::XSize> as Bits6, imms = Size::XSize - 1}
//    }
//
//    assembly ASRIX = ("asr", " ", XSize(rd), ", ", XSize(rn), ", #", udec(shift))
//
//    pseudo instruction LSRIW(rd : Index, rn : Index, shift : Bits6) = {
//      UBFMW{rd = rd, rn = rn, immr = shift as Bits<ShiftSize::WSize> as Bits6, imms = Size::WSize - 1}
//    }
//
//    assembly LSRIW = ("lsr", " ", WSize(rd), ", ", WSize(rn), ", #", udec(shift))
//
//    pseudo instruction LSRIX(rd : Index, rn : Index, shift : Bits6) = {
//      UBFMX{rd = rd, rn = rn, immr = shift as Bits<ShiftSize::XSize> as Bits6, imms = Size::XSize - 1}
//    }
//
//    assembly LSRIX = ("lsr", " ", XSize(rd), ", ", XSize(rn), ", #", udec(shift))
//
//    pseudo instruction LSLIW(rd : Index, rn : Index, shift : Bits6) = {
//      UBFMW{rd = rd, rn = rn, immr = -shift as Bits<ShiftSize::WSize> as Bits6, imms = (Size::WSize - 1) - shift as Bits<ShiftSize::WSize> as Bits6}
//    }
//
//    assembly LSLIW = ("lsl", " ", WSize(rd), ", ", WSize(rn), ", #", udec(shift))
//
//    pseudo instruction LSLIX(rd : Index, rn : Index, shift : Bits6) = {
//      UBFMX{rd = rd, rn = rn, immr = -shift as Bits<ShiftSize::XSize> as Bits6, imms = (Size::XSize - 1) - shift as Bits<ShiftSize::XSize> as Bits6}
//    }
//
//    assembly LSLIX = ("lsl", " ", XSize(rd), ", ", XSize(rn), ", #", udec(shift))
//
//    enumeration ExceptionClass : Bits6 =
//      { Uncategorized = 0x00
//      , WFxAccessTrap = 0x01
//      , AdvSIMDFPAccessTrap = 0x07
//      , UncoveredException = 0x0A
//      , BranchTarget = 0x0D
//      , IllegalState = 0x0E
//      , SupervisorCall = 0x15
//      , InstructionAbortLowerEL = 0x20
//      , InstructionAbortSameEL = 0x21
//      , PCAlignment = 0x22
//      , DataAbortLowerEL = 0x24
//      , DataAbortSameEL = 0x25
//      , SPAlignment = 0x26
//      , MemoryOperation = 0x27
//      , FPTrappedException = 0x2C
//      , SError = 0x2F
