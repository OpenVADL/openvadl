//    assembly TransferImmX = (AsmImmextU(immX as Word), AsmR(d5), "", " = ", ("#", decimal(immS)))
//
//    [operation : ALU32]
//    instruction TransferReg : StandardFormat = {
//      R(d5) := R(s5)
//    }
//    encoding TransferReg = {iclass = 0b0111, c = 0b0, majop = 0b0000, minop = 0b011}
//    assembly TransferReg = ("", AsmR(d5), "", " = ", AsmR(s5))
//
//    format AddImmFormat: Word =
//      { iclass	 [31..28]
//      , parse	 [15..14]
//      , imm	 [27..21, 13..5]
//      , s5	 [20..16]
//      , d5	 [4..0]
