instruction set architecture ISA = {}

micro architecture MiA implements ISA = {

  stage DECODE -> Instruction = {
    DECODE := decode(fetchNext)
  }

  [size : 8]
  [source : DECODE]
  logic [reservation station] RS

  operation Op = {}

  stage FilteredConsumer -> Instruction = {
    let instr = consume(RS, Op) in {
      FilteredConsumer := instr
    }
  }

  stage UnfilteredConsumer -> Instruction = {
    let instr = consume(RS) in {
      UnfilteredConsumer := instr
    }
  }
}


