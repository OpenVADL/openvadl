instruction set architecture ISA = {}

micro architecture MiA implements ISA = {

  stage DECODE -> (ir: Instruction) = {
    ir := decode(fetchNext)
  }

  [size : 8]
  [source : DECODE.ir]
  logic [reservation station] RS

  operation Op = {}

  stage FilteredConsumer -> (ir: Instruction) = {
    let instr = consume(RS, Op) in {
      ir := instr
    }
  }

  stage UnfilteredConsumer -> (ir: Instruction) = {
    let instr = consume(RS) in {
      ir := instr
    }
  }
}


