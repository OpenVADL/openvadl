[ IEEE : 32 ]
float-type ieee32

using SInt7 = SInt<7>
using Bits32 = Bits<32>

function fcvt  (a: ieee32) -> ieee32 = VADL::fcvt<ieee32>(a, 0 as Bits<3>)
