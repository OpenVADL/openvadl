function fcvtfb(a: ieee32) -> Bits32 = VADL::fcvt<Bits32>(a, 0 as Bits<3>)
function fcvtsf(a: SInt7)  -> ieee32 = VADL::fcvt<ieee32>(a, 0 as Bits<3>)
function fcvtuf(a: Bits32) -> ieee32 = VADL::fcvt<ieee32>(a, 0 as Bits<3>)


