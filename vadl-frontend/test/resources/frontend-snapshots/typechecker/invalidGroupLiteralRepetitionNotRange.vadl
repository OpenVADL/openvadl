instruction set architecture ISA = {
  program counter PC : Bits<32>

  format IType : Bits<32> = {
    opcode : Bits<32>
  }

  instruction A : IType = PC := 0
  encoding A = {opcode = 0b00}
  assembly A = (mnemonic, "")

  operation Op = {A}

  group VLIW = Op<PC>
}


