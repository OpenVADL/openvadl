
instruction set architecture TEST = {
  format Simple : Bits<8> = {b [0]}

  // Model name must not be tokenized
  model TestModel (name : Id, val : Bin) : IsaDefs = {
    instruction $name : Simple = {}
    encoding $name = { b = $val }
    assembly $name = (mnemonic)
  }

  $TestModel(ZERO ; 0b0)
  $TestModel(ONE ; 0b1)
}