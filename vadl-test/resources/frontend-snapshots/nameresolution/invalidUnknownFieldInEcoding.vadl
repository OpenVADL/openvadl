// https://github.com/OpenVADL/openvadl/issues/478
instruction set architecture ISA = {
  register X : Bits<32>
  format Btype : Bits<32> = {
    bits [31..0]
  }
  instruction BEQ : Btype = { X := 0 }
  encoding BEQ = { bit = 8 }
}


