instruction set architecture ISA = {
  format Byte : Bits<8> = {
    bits: Bits<8>
  }

  format Short : Bits<16> = {
    byte1: Byte,
    byte2: Byte
  }

  format Btype : Bits<32> = {
    a [31..0]
  }

  register X : Short

  instruction BEQ : Btype = {
    X.byte1 := X.byte2.bits + X.byte1.bits
  }
}


