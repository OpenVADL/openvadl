// INCLUDE-AST-DUMP

// These include examples of typechecking that previously weren't possible with the pure bottom-up approach.
// https://github.com/OpenVADL/openvadl/issues/825

// Function with condition with both branches returning const types.
function abc(cond: Bool) -> Bits<32> = if cond then 9 else 8

// Function with math with all branches returning const types.
function abc2(num: Bits<32>) -> Bits<32> = match num with
  { 0 => 0
  , 1 => 2
  , 2 => 4
  , _ => 8
  }

// Long if-else chain.
using BitsX = Bits<64>
using SIntW = SInt<32>

function patternSize (val: BitsX) -> SIntW =
       if val =  0    || val = -1   then  0
  else if val(63..32) != val(31..0) then 64
  else if val(31..16) != val(15..0) then 32
  else if val(15.. 8) != val( 7..0) then 16
  else if val( 7.. 4) != val( 3..0) then  8
  else if val( 3.. 2) != val( 1..0) then  4
  else 2

// Long match-chain
constant VL = 128

using Bits5 = Bits<5>

function DecodePredCount (pattern: Bits5) -> BitsX =
  let elCount = VL as BitsX >> 3 + 0 in
    match pattern with
      { 0b00000 => elCount // elCount is always a power of 2
      , 0b00001 => if elCount >=   1 then   1 else 0
      , 0b00010 => if elCount >=   2 then   2 else 0
      , 0b00011 => if elCount >=   3 then   3 else 0
      , 0b00100 => if elCount >=   4 then   4 else 0
      , 0b00101 => if elCount >=   5 then   5 else 0
      , 0b00110 => if elCount >=   6 then   6 else 0
      , 0b00111 => if elCount >=   7 then   7 else 0
      , 0b01000 => if elCount >=   8 then   8 else 0
      , 0b01001 => if elCount >=  16 then  16 else 0
      , 0b01010 => if elCount >=  32 then  32 else 0
      , 0b01011 => if elCount >=  64 then  64 else 0
      , 0b01100 => if elCount >= 128 then 128 else 0
      , 0b01101 => if elCount >= 256 then 256 else 0
      , 0b11101 => elCount - elCount % 4
      , 0b11110 => elCount - elCount % 3
      , 0b11111 => elCount
      , _       => 0
      }


