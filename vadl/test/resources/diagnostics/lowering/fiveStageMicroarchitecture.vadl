instruction set architecture ISA = {
  register X : Bits<16><32>
  memory MEM : Bits<32> -> Bits<8>
}

micro architecture SingleStage implements ISA = {
  stage FETCH -> ( fr : FetchResult ) =
  {
    fr := fetchNext
  }

  stage DECODE -> ( ir : Instruction ) =
  {
    let instr = decode( FETCH.fr ) in
    {
      instr.address( @X )
      //instr.readOrForward( @X, @bypass )
      ir := instr
    }
  }

  stage EXECUTE -> ( ir : Instruction ) =
  {
    let instr = DECODE.ir in
    {
      //instr.read( @PC, @CSR )
      instr.compute
      instr.verify
      //instr.write( @PC, @CSR )
      //instr.results( @X, @bypass )
      ir := instr
    }
  }

  stage MEMORY -> ( ir : Instruction ) =
  {
    let instr = EXECUTE.ir in
    {
      instr.write( @MEM )
      instr.read( @MEM )
      ir := instr
    }
  }

  stage WRITE_BACK =
  {
    let instr = MEMORY.ir in
    {
      instr.write( @X )
    }
  }
}


