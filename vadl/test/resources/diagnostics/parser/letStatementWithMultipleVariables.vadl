// INCLUDE-AST-DUMP

instruction set architecture ISA = {
  program counter PC : Bits<32>
  format Btype : Bits<32> = {
    bits [31..0]
  }
  instruction BEQ : Btype = {
    let next, status = VADL::adds(PC, 4 as Bits<32>) in
      if status.zero then
        PC := next
  }
  assembly BEQ = mnemonic
  encoding BEQ = {bits = 0}
}


