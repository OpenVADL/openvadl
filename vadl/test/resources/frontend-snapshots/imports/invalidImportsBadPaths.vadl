// The locations of the imports have been wrong in the past
// https://github.com/OpenVADL/openvadl/issues/731

import doesnotexist::{alsoNotExisting}
import doesnotexist
import does::not::exist
import sys::does::not::exist::{this, also, not}

import "doesnotexist"::{alsoNotExisting}
import "doesnotexist"
import "does/not/exist"
import "sys/does/not/exist"::{this, also, not}


