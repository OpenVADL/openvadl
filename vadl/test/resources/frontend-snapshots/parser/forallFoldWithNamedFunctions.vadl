// INCLUDE-AST-DUMP
// Previously this didn't work as only operators were allowed.
// https://github.com/OpenVADL/openvadl/issues/660

instruction set architecture Tensor = {
  using Index = Bits<4>
  register X : Bits<16><32>

  format F : Bits<4> = {opcode : Bits<4>}

  model Instr(id: Id, cnt: Int, ex: Ex): IsaDefs = {
    instruction $id : F = X(0) := $ex
    encoding $id = {opcode = $cnt}
    assembly $id = AsStr(id)
  }

  $Instr(I1; 1; forall i: Bits<4> in 0 .. 3 fold VADL::add  with X(i))
  $Instr(I2; 2; forall i: Bits<4> in 0 .. 3 fold VADL::mul  with X(i))
  $Instr(I3; 3; forall i: Bits<4> in 0 .. 3 fold VADL::and  with X(i))
  $Instr(I4; 4; forall i: Bits<4> in 0 .. 3 fold VADL::or   with X(i))
  $Instr(I5; 5; forall i: Bits<4> in 0 .. 3 fold VADL::xor  with X(i))
  $Instr(I6; 6; forall i: Bits<4> in 0 .. 3 fold VADL::smin with X(i))
  $Instr(I7; 7; forall i: Bits<4> in 0 .. 3 fold VADL::umin with X(i))
  $Instr(I8; 8; forall i: Bits<4> in 0 .. 3 fold VADL::smax with X(i))
  $Instr(I9; 9; forall i: Bits<4> in 0 .. 3 fold VADL::umax with X(i))

}


