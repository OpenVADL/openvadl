// This test is because we have to reimplement the parser for fold actions and it is somewhat
// likely to run into this bug.

model MulOp(): BinOp = { * }

function f2() -> Bits<32> =
   forall i: Bits<32> in 0..4 fold $MulOp()::$MulOp()  with i


