// The syntax type of any macro called for the operation in the forall-fold expression must be a BinOp but is here
// a Ex.

model TestOP (): Ex = {42}

model FoldStat (): Stat = {
  Reg := forall i: Bits<4> in 0 .. 3 fold $TestOP() with Reg(i)
}


