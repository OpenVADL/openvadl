// Assign to let variable
// This has been an issue before:
// https://github.com/OpenVADL/openvadl/issues/557

instruction set architecture TEST = {
  register V: Bits<32><32><32>

  program counter PC: Bits<64>
  memory MEM: Bits<64> -> Bits<8>

  format F: Bits<32> =
  { rd         :  Bits<5>
  , op         :  Bits<27>
  }

  instruction T: F = {
    let r = V(rd) in
    forall i: Bits<5> in 0..31 do {
      r(i) := 0
    }
  }
  encoding T = { op = 0 }
  assembly T = ""
}


//  Reported Diagnostics:
//
//  error: Cannot Write To Static Target
