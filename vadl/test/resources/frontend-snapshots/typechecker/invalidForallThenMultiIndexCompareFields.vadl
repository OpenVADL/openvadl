instruction set architecture ISA = {
  program counter PC : Bits<32>

  format AType : Bits<32> = {
    a : Bits<20>,
    b : Bits<5>,
    c : Bits<7>
  }

  format BType : Bits<32> = {
    a : Bits<20>,
    b : Bits<5>,
    d : Bits<7>
  }

  instruction A : AType = PC := 0
  encoding A = {a = 0b00}
  assembly A = (mnemonic, "")

  instruction B : BType = PC := 0
  encoding B = {a = 0b01}
  assembly B = (mnemonic, "")

  operation OpA = {A}
  operation OpB = {B}

  [assert : forall i in {OpA, OpB}, j in {OpA} then i.a = j.b]
  group VLIW = OpA.OpB
}


