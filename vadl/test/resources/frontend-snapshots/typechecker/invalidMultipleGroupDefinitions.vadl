instruction set architecture IsaA = {

  program counter PC : Bits<32>

  format IType : Bits<32> = {
      opcode : Bits<32>
  }

  instruction A : IType = PC := 0
  encoding A = {opcode = 0b00}
  assembly A = (mnemonic, "")

  instruction B : IType = PC := 0
  encoding B = {opcode = 0b01}
  assembly B = (mnemonic, "")

  operation O1 = {A}
  operation O2 = {A,B}


  group VLIW1 = ({O1,O2}|O1<2..5>)
}

instruction set architecture IsaB extending IsaA = {
  group VLIW2 = O1<5..6>
}


