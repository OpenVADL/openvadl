# picolibc machine support for the LCB rv32im toolchain.
#
# Copied into newlib/libc/machine/<cpu_family>/ by build-runtime.sh. Only the code which cannot be
# written in portable C is provided here; everything else uses picolibc's generic C sources.
srcs_machine = [
  'setjmp.S',
]

src_machine = files(srcs_machine)

