# read design
read_verilog -sv build/TOP_MODULE.sv

# elaborate design hierarchy
hierarchy -check -top TOP_MODULE

# optimize and map to internal cell library
synth -top TOP_MODULE -flatten

# names the output wires of flip-flops with the flip-flop name
# this enables us to examine critical paths after mapping and placement
rename -wire -suffix _reg t:$_*DFF*

# mapping flip-flops to sky130_fd_sc_hd__tt_025C_1v80.lib
dfflibmap -liberty /opt/pdk/sky130_fd_sc_hd__tt_025C_1v80.lib

# mapping logic to sky130_fd_sc_hd__tt_025C_1v80.lib
abc \
  -liberty /opt/pdk/sky130_fd_sc_hd__tt_025C_1v80.lib \
  -constr /scripts/bench/yosys/bench_core_asic_sky130.constr \
  -script /scripts/bench/yosys/abc_speed.script

# print stats
stat -liberty /opt/pdk/sky130_fd_sc_hd__tt_025C_1v80.lib

# cleanup
clean

# write synthesized design
write_verilog build/TOP_MODULE_netlist.v
