
instruction set architecture PcTest = {
  using Regs = Bits<32>

  memory Mem : Bits<8> -> Bits<8>

  register A: Regs
  [ next next ]
  alias program counter PC: Regs = A

  instruction READ_PC: F = A := PC

  encoding READ_PC = { I = 2 }
  assembly READ_PC = "Test"

  format F: Regs = {
    I: Regs
  }
}

processor TEST implements PcTest = {}