
instruction set architecture PcTest = {
  using Regs = Bits<32>

  register A: Regs
  [ next ]
  program counter PC: Regs

  // subcalls should overwrite the [ next ] annotation
  instruction READ_PC_CURRENT: F = A := PC.current
  instruction READ_PC_NEXT: F = A := PC.next
  instruction READ_PC_NEXTNEXT: F = A := PC.nextnext

  encoding READ_PC_CURRENT = { I = 2 }
  encoding READ_PC_NEXT = { I = 2 }
  encoding READ_PC_NEXTNEXT = { I = 2 }
  assembly READ_PC_CURRENT, READ_PC_NEXT, READ_PC_NEXTNEXT = "Test"

  format F: Regs = {
    I: Regs
  }
}

processor TEST implements PcTest = {}